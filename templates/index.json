    "pet_grooming_steps": {
      "type": "pet-grooming-steps",
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "product": "cepillo-deslanador-perro-gato",
            "category": "Cepillado",
            "application_time": "2-3 veces por semana",
            "short_description": "Quita el pelo muerto y los nudos antes de mojarlo: con el agua, los nudos se aprietan."
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "product": "champu-avena-perro",
            "category": "Baño",
            "application_time": "Cada 3-4 semanas",
            "short_description": "Champú suave de avena y un buen aclarado. Sin pasarse: bañarlo demasiado reseca la piel."
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "product": "snack-dental-perro",
            "category": "Dientes",
            "application_time": "A diario",
            "short_description": "Un snack dental al día ayuda a frenar el sarro y el mal aliento entre limpiezas."
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "product": "balsamo-almohadillas-perro",
            "category": "Almohadillas",
            "application_time": "1-2 veces por semana",
            "short_description": "Un poco de bálsamo tras el paseo evita las grietas del asfalto, el frío y el calor."
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3",
        "step_4"
      ],
      "settings": {
        "kicker": "Así lo hacemos en la peluquería",
        "heading": "Su rutina de higiene y manto en 4 pasos",
        "subheading": "Lo que hacemos en cada visita, para que lo sigas en casa entre cita y cita.",

    <!-- Toolbar Controls (Navigation, View Switcher & Filters) -->
    <div class="grooming-calendar-toolbar">
      
      <!-- Date Navigation -->
      <div class="grooming-calendar-nav-group">
        <button
          type="button"
          class="grooming-calendar-btn-today"
          data-calendar-action="today"
          data-i18n-es="Hoy"
          data-i18n-en="Today"
        >
          {{- 'pet_cro.calendar.today' | t -}}
        </button>
        <div class="grooming-calendar-nav-arrows">
          <button
            type="button"
            class="grooming-calendar-icon-btn"
            data-calendar-action="prev"
            aria-label="{{ 'pet_cro.calendar.previous' | t }}"
            data-i18n-aria-es="Anterior"
            data-i18n-aria-en="Previous"
          >
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            type="button"
            class="grooming-calendar-icon-btn"
            data-calendar-action="next"
            aria-label="{{ 'pet_cro.calendar.next' | t }}"
            data-i18n-aria-es="Siguiente"
            data-i18n-aria-en="Next"
          >
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
        <h2
          class="grooming-calendar-current-label"
          id="grooming-calendar-label-{{ section.id }}"
          aria-live="polite"
          aria-atomic="true"
        >
          <!-- Filled dynamically via grooming-calendar.js -->
        </h2>
      </div>

      <!-- View Tabs (Day, Week, Month) -->
      <div
        class="grooming-calendar-view-tabs"
        role="tablist"
        aria-label="{{ 'pet_cro.calendar.view_month' | t }}"
      >
        <button
          type="button"
          role="tab"
          class="grooming-calendar-view-tab"
          id="tab-view-day-{{ section.id }}"
          aria-selected="false"
          tabindex="-1"
          data-calendar-view="day"
          data-i18n-es="Día"
          data-i18n-en="Day"
        >
          {{- 'pet_cro.calendar.view_day' | t -}}
        </button>
        <button
          type="button"
          role="tab"
          class="grooming-calendar-view-tab"
          id="tab-view-week-{{ section.id }}"
          aria-selected="false"
          tabindex="-1"
          data-calendar-view="week"
          data-i18n-es="Semana"
          data-i18n-en="Week"
        >
          {{- 'pet_cro.calendar.view_week' | t -}}
        </button>
        <button
          type="button"
          role="tab"
          class="grooming-calendar-view-tab is-active"
          id="tab-view-month-{{ section.id }}"
          aria-selected="true"
          tabindex="0"
          data-calendar-view="month"
          data-i18n-es="Mes"
          data-i18n-en="Month"
        >
          {{- 'pet_cro.calendar.view_month' | t -}}
        </button>
      </div>

      <!-- Filters, Search & Quick Actions -->
      <div class="grooming-calendar-controls-right">
        
        <!-- Quick Search -->
        <div class="grooming-calendar-search-wrap">
          <input
            type="search"
            class="grooming-calendar-search-input"
            data-calendar-search
            placeholder="{{ 'pet_cro.calendar.search_placeholder' | t }}"
            data-i18n-placeholder-es="Buscar por perro, tutor o teléfono..."
            data-i18n-placeholder-en="Search by pet, parent, or phone..."
            aria-label="{{ 'pet_cro.calendar.search_placeholder' | t }}"
          >
        </div>

        <!-- Filters (Status & Service) -->
        <div class="grooming-calendar-filters">
          <label class="visually-hidden" for="calendar-filter-status-{{ section.id }}">
            {{- 'pet_cro.calendar.filter_by_status' | t -}}
          </label>
          <select
            id="calendar-filter-status-{{ section.id }}"
            class="grooming-calendar-select"
            data-calendar-filter="status"
          >
            <option value="all" data-i18n-es="Todos los estados" data-i18n-en="All statuses">
              {{- 'pet_cro.calendar.all_statuses' | t -}}
            </option>
            <option value="confirmed" data-i18n-es="Confirmada" data-i18n-en="Confirmed">
              {{- 'pet_cro.calendar.status_confirmed' | t -}}
            </option>
            <option value="pending" data-i18n-es="Pendiente" data-i18n-en="Pending">
              {{- 'pet_cro.calendar.status_pending' | t -}}
            </option>
            <option value="completed" data-i18n-es="Realizada" data-i18n-en="Completed">
              {{- 'pet_cro.calendar.status_completed' | t -}}
            </option>
            <option value="cancelled" data-i18n-es="Cancelada" data-i18n-en="Cancelled">
              {{- 'pet_cro.calendar.status_cancelled' | t -}}
            </option>
          </select>

          <label class="visually-hidden" for="calendar-filter-service-{{ section.id }}">
            {{- 'pet_cro.calendar.filter_by_service' | t -}}
          </label>
          <select
            id="calendar-filter-service-{{ section.id }}"
            class="grooming-calendar-select"
            data-calendar-filter="service"
          >
            <option value="all" data-i18n-es="Todos los servicios" data-i18n-en="All services">
              {{- 'pet_cro.calendar.all_services' | t -}}
            </option>
            {%- if has_custom_services -%}
              {%- for service in meta_services -%}
                {%- assign is_active = true -%}
                {%- if service.active.value == false or service.active == false -%}{%- assign is_active = false -%}{%- endif -%}
                {%- if is_active -%}
                  {%- assign s_id = service.system.handle | default: service.id | default: forloop.index -%}
                  {%- assign s_name = service.name.value | default: service.name -%}
                  <option value="{{ s_id }}">{{ s_name }}</option>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <option value="bath_hygiene" data-i18n-es="Baño Dermoprotector & Oídos" data-i18n-en="Dermoprotective Bath & Ears">
                Baño Dermoprotector & Oídos
              </option>
              <option value="scissor_cut" data-i18n-es="Corte a Tijera de Raza & Peinado" data-i18n-en="Breed Scissor Cut & Styling">
                Corte a Tijera de Raza & Peinado
              </option>
              <option value="deshedding" data-i18n-es="Deslanado Completo & Baño" data-i18n-en="Full Deshedding & Bath">
                Deslanado Completo & Baño
              </option>
              <option value="spa_ozone" data-i18n-es="Spa Ozonoterapia & Mascarilla" data-i18n-en="Ozone Spa Therapy & Mask">
                Spa Ozonoterapia & Mascarilla
              </option>
            {%- endif -%}
          </select>
        </div>

        <!-- Quick Actions Group (New Appointment & Print) -->
        <div class="grooming-calendar-actions-group">
          <button
            type="button"
            class="grooming-calendar-btn-primary"
            data-calendar-action="new-appointment"
            data-i18n-es="+ Nueva Cita"
            data-i18n-en="+ New Appointment"
          >
            {{- 'pet_cro.calendar.new_appointment' | t -}}
          </button>
          <button
            type="button"
            class="grooming-calendar-btn-action is-secondary"
            data-calendar-action="print"
            data-i18n-es="🖨️ Imprimir Agenda"
            data-i18n-en="🖨️ Print Schedule"
          >
            {{- 'pet_cro.calendar.print_schedule' | t -}}
          </button>
        </div>

      </div>

    </div>


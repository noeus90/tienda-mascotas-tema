{%- doc -%}
  CRO Product Tabs for Pet Shop & Dog Grooming products.
  Displays Benefits, Composition & Nutrients, and Feeding / Grooming Usage Guide via Metafields.

  @param {product} product - (Required) Shopify product object.
  @param {string} [extra_class] - (Optional) Additional CSS classes for the wrapper.

  @example
  {% render 'pet-product-tabs', product: product %}
{%- enddoc -%}

{%- liquid
  assign default_pet_type = 'pet_cro.tabs.pet_type_default' | t
  assign mf_benefits = product.metafields.custom.key_benefits.value | default: product.metafields.custom.beneficios_clave.value
  assign mf_ingredients = product.metafields.custom.active_ingredients.value | default: product.metafields.custom.ingredientes_activos.value
  assign mf_usage = product.metafields.custom.usage_guide.value | default: product.metafields.custom.modo_de_uso.value
  assign mf_pet_type = product.metafields.custom.pet_suitability.value | default: product.metafields.custom.tipo_piel.value | default: default_pet_type
  assign mf_composition = product.metafields.custom.analytical_composition.value | default: product.metafields.custom.lista_inci.value
  assign tab_uid = section.id | default: product.id | default: 'main'
-%}

<div class="cro-tabs-wrapper {{ extra_class }}">
  <!-- Tab Buttons (WAI-ARIA Tablist) -->
  <div
    class="cro-tabs-nav"
    role="tablist"
    aria-label="{{ 'pet_cro.tabs.aria_label' | t }}"
  >
    <button
      type="button"
      class="cro-tab-btn is-active"
      role="tab"
      aria-selected="true"
      tabindex="0"
      aria-controls="tab-panel-benefits-{{ tab_uid }}"
      id="tab-btn-benefits-{{ tab_uid }}"
      data-tab-target="tab-panel-benefits-{{ tab_uid }}"
    >
      <!-- Heart / Health Icon -->
      <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
      </svg>
      <span>{{ 'pet_cro.tabs.tab_benefits' | t }}</span>
    </button>

    <button
      type="button"
      class="cro-tab-btn"
      role="tab"
      aria-selected="false"
      tabindex="-1"
      aria-controls="tab-panel-ingredients-{{ tab_uid }}"
      id="tab-btn-ingredients-{{ tab_uid }}"
      data-tab-target="tab-panel-ingredients-{{ tab_uid }}"
    >
      <!-- Natural Leaf / Nutrition Icon -->
      <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
        <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
      </svg>
      <span>{{ 'pet_cro.tabs.tab_ingredients' | t }}</span>
    </button>

    <button
      type="button"
      class="cro-tab-btn"
      role="tab"
      aria-selected="false"
      tabindex="-1"
      aria-controls="tab-panel-usage-{{ tab_uid }}"
      id="tab-btn-usage-{{ tab_uid }}"
      data-tab-target="tab-panel-usage-{{ tab_uid }}"
    >
      <!-- Guide / Clock Icon -->
      <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      <span>{{ 'pet_cro.tabs.tab_usage' | t }}</span>
    </button>
  </div>

  <!-- Tab Panels -->
  <div class="cro-tabs-content">
    
    <!-- TAB 1: BENEFITS -->
    <div
      class="cro-tab-panel is-active"
      id="tab-panel-benefits-{{ tab_uid }}"
      role="tabpanel"
      tabindex="0"
      aria-labelledby="tab-btn-benefits-{{ tab_uid }}"
    >
      <div class="cro-skin-type-badge">
        <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6L9 17l-5-5"/>
        </svg>
        <span>
          <strong>{{ 'pet_cro.tabs.ideal_for' | t }}</strong>
          {%- if mf_pet_type == default_pet_type -%}
            <span>
              {{ mf_pet_type }}
            </span>
          {%- else -%}
            {{ mf_pet_type }}
          {%- endif -%}
        </span>
      </div>

      {%- if mf_benefits != blank -%}
        <div class="cro-panel-text">
          {{ mf_benefits }}
        </div>
      {%- else -%}
        <ul class="cro-benefits-list">
          <li>
            <div class="cro-check-icon" aria-hidden="true">✓</div>
            <div>
              {{ 'pet_cro.tabs.benefit_1_html' | t }}
            </div>
          </li>
          <li>
            <div class="cro-check-icon" aria-hidden="true">✓</div>
            <div>
              {{ 'pet_cro.tabs.benefit_2_html' | t }}
            </div>
          </li>
          <li>
            <div class="cro-check-icon" aria-hidden="true">✓</div>
            <div>
              {{ 'pet_cro.tabs.benefit_3_html' | t }}
            </div>
          </li>
        </ul>
      {%- endif -%}
    </div>

    <!-- TAB 2: COMPOSITION & NUTRIENTS -->
    <div
      class="cro-tab-panel"
      id="tab-panel-ingredients-{{ tab_uid }}"
      role="tabpanel"
      tabindex="0"
      aria-labelledby="tab-btn-ingredients-{{ tab_uid }}"
      hidden
    >
      {%- if mf_ingredients != blank -%}
        <div class="cro-panel-text">
          {{ mf_ingredients }}
        </div>
      {%- else -%}
        <div class="cro-actives-grid">
          <div class="cro-active-card">
            <span class="cro-active-pill">{{ 'pet_cro.tabs.ing_1_tag' | t }}</span>
            <h4>{{ 'pet_cro.tabs.ing_1_title' | t }}</h4>
            <p>
              {{ 'pet_cro.tabs.ing_1_desc' | t }}
            </p>
          </div>
          <div class="cro-active-card">
            <span class="cro-active-pill">{{ 'pet_cro.tabs.ing_2_tag' | t }}</span>
            <h4>{{ 'pet_cro.tabs.ing_2_title' | t }}</h4>
            <p>
              {{ 'pet_cro.tabs.ing_2_desc' | t }}
            </p>
          </div>
          <div class="cro-active-card">
            <span class="cro-active-pill">{{ 'pet_cro.tabs.ing_3_tag' | t }}</span>
            <h4>{{ 'pet_cro.tabs.ing_3_title' | t }}</h4>
            <p>
              {{ 'pet_cro.tabs.ing_3_desc' | t }}
            </p>
          </div>
        </div>

        <details class="cro-inci-accordion">
          <summary>
            {{ 'pet_cro.tabs.view_composition' | t }}
          </summary>
          {%- assign default_comp = 'pet_cro.tabs.composition_default' | t -%}
          <div
            class="cro-inci-text"
          >
            {{ mf_composition | default: default_comp }}
          </div>
        </details>
      {%- endif -%}
    </div>

    <!-- TAB 3: FEEDING / USAGE GUIDE -->
    <div
      class="cro-tab-panel"
      id="tab-panel-usage-{{ tab_uid }}"
      role="tabpanel"
      tabindex="0"
      aria-labelledby="tab-btn-usage-{{ tab_uid }}"
      hidden
    >
      {%- if mf_usage != blank -%}
        <div class="cro-panel-text">
          {{ mf_usage }}
        </div>
      {%- else -%}
        <div class="cro-routine-timing">
          <span class="cro-timing-tag">{{ 'pet_cro.tabs.daily_use' | t }}</span>
          <span class="cro-timing-tag">{{ 'pet_cro.tabs.grooming_day' | t }}</span>
        </div>

        <ol class="cro-routine-steps">
          <li>
            <span class="cro-step-num" aria-hidden="true">1</span>
            <div>
              {{ 'pet_cro.tabs.step_1_html' | t }}
            </div>
          </li>
          <li>
            <span class="cro-step-num" aria-hidden="true">2</span>
            <div>
              {{ 'pet_cro.tabs.step_2_html' | t }}
            </div>
          </li>
          <li>
            <span class="cro-step-num" aria-hidden="true">3</span>
            <div>
              {{ 'pet_cro.tabs.step_3_html' | t }}
            </div>
          </li>
          <li>
            <span class="cro-step-num" aria-hidden="true">4</span>
            <div>
              {{ 'pet_cro.tabs.step_4_html' | t }}
            </div>
          </li>
        </ol>
      {%- endif -%}
    </div>

  </div>
</div>

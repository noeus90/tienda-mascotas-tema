{%- comment -%}
  Brand palette of the pet store (CSS-01), as "r, g, b" so it works in rgb() and in rgba(…, alpha).
  Rendered in layout/theme.liquid before base.css. --pet-text-* are for colored text on the section's
  background and --pet-card for white boxes: dark color schemes override them (end of file, CSS-02).
  The booking keeps its --booking-* names, pointing at these.
{%- endcomment -%}
{% style %}
  :root {
    /* Marca: verde esmeralda */
    --pet-accent: 4, 120, 87; /* #047857: botones, enlaces y detalles de la marca */
    --pet-accent-dark: 6, 95, 70; /* #065f46: hover y texto sobre fondo verde claro */
    --pet-accent-darker: 6, 78, 59; /* #064e3b */
    --pet-accent-light: 5, 150, 105; /* #059669 */
    --pet-accent-bright: 16, 185, 129; /* #10b981: puntos de estado, completado */
    --pet-accent-400: 52, 211, 153; /* #34d399 */
    --pet-accent-300: 110, 231, 183; /* #6ee7b7 */
    --pet-accent-border: 167, 243, 208; /* #a7f3d0: bordes verdes suaves */
    --pet-accent-100: 209, 250, 229; /* #d1fae5 */
    --pet-accent-soft: 236, 253, 245; /* #ecfdf5: fondos verdes muy claros */
    --pet-green-50: 240, 253, 244; /* #f0fdf4 */
    --pet-green-100: 220, 252, 231; /* #dcfce7 */
    --pet-green-200: 187, 247, 208; /* #bbf7d0 */
    --pet-green-300: 134, 239, 172; /* #86efac */
    /* Texto y neutros (pizarra) */
    --pet-ink: 15, 23, 42; /* #0f172a: texto principal propio */
    --pet-ink-2: 30, 41, 59; /* #1e293b */
    --pet-ink-gray: 31, 41, 55; /* #1f2937 */
    --pet-muted: 71, 85, 105; /* #475569: texto secundario */
    --pet-muted-2: 100, 116, 139; /* #64748b */
    --pet-subtle: 148, 163, 184; /* #94a3b8 */
    --pet-line: 203, 213, 225; /* #cbd5e1 */
    --pet-surface: 248, 250, 252; /* #f8fafc */
    /* Aviso (ámbar) */
    --pet-warning: 245, 158, 11; /* #f59e0b */
    --pet-warning-text: 180, 83, 9; /* #b45309 */
    --pet-warning-dark: 146, 64, 14; /* #92400e */
    --pet-warning-soft: 255, 251, 235; /* #fffbeb */
    --pet-warning-100: 254, 243, 199; /* #fef3c7 */
    --pet-warning-border: 253, 230, 138; /* #fde68a */
    --pet-warning-border-2: 252, 211, 77; /* #fcd34d */
    /* Error (rojo) */
    --pet-error: 220, 38, 38; /* #dc2626 */
    --pet-error-light: 239, 68, 68; /* #ef4444 */
    --pet-error-text: 185, 28, 28; /* #b91c1c */
    --pet-error-dark: 153, 27, 27; /* #991b1b */
    --pet-error-soft: 254, 242, 242; /* #fef2f2 */
    --pet-error-100: 254, 226, 226; /* #fee2e2 */
    --pet-error-border: 254, 202, 202; /* #fecaca */
    /* Información (azul) */
    --pet-info: 14, 116, 144; /* #0e7490 */
    --pet-sky-50: 240, 249, 255; /* #f0f9ff */
    --pet-sky-200: 186, 230, 253; /* #bae6fd */
    --pet-sky-700: 3, 105, 161; /* #0369a1 */
    --pet-sky-800: 7, 89, 133; /* #075985 */
    --pet-sky-900: 12, 74, 110; /* #0c4a6e */
    --pet-blue-500: 59, 130, 246; /* #3b82f6 */
    /* Etiquetas de las tarjetas (morado, verde azulado, rosa, violeta) */
    --pet-purple-50: 250, 245, 255; /* #faf5ff */
    --pet-purple-200: 233, 213, 255; /* #e9d5ff */
    --pet-purple-700: 126, 34, 206; /* #7e22ce */
    --pet-teal-50: 240, 253, 250; /* #f0fdfa */
    --pet-teal-200: 153, 246, 228; /* #99f6e4 */
    --pet-teal-700: 15, 118, 110; /* #0f766e */
    --pet-teal-900: 19, 78, 74; /* #134e4a */
    --pet-rose-50: 255, 241, 242; /* #fff1f2 */
    --pet-rose-200: 254, 205, 211; /* #fecdd3 */
    --pet-rose-700: 190, 18, 60; /* #be123c */
    --pet-violet-50: 245, 243, 255; /* #f5f3ff */
    --pet-violet-200: 221, 214, 254; /* #ddd6fe */
    --pet-violet-700: 109, 40, 217; /* #6d28d9 */
    /* Otros */
    --pet-cream: 253, 246, 236; /* #fdf6ec: degradado del bloque de peluquería */
    --pet-blush: 255, 247, 247; /* #fff7f7 */
    --pet-whatsapp: 37, 211, 102; /* #25d366 */
    --pet-whatsapp-dark: 18, 140, 126; /* #128c7e */
    /* Texto con color sobre el fondo del esquema (CSS-02): en los esquemas oscuros se aclaran (abajo) */
    --pet-text-accent: var(--pet-accent);
    --pet-text-accent-dark: var(--pet-accent-dark);
    --pet-text-accent-light: var(--pet-accent-light);
    --pet-text-accent-400: var(--pet-accent-400);
    --pet-text-accent-border: var(--pet-accent-border);
    --pet-text-sky-700: var(--pet-sky-700);
    --pet-text-error: var(--pet-error);
    --pet-text-info: var(--pet-info);
    --pet-text-ink: var(--pet-ink);
    --pet-text-ink-2: var(--pet-ink-2);
    /* Tarjetas y cajas sobre el fondo de la sección: blancas en los esquemas claros */
    --pet-card: 255, 255, 255;
    /* Tamaños de letra (CSS-10): cinco de texto y cuatro de título, 12 px como mínimo */
    --pet-text-xs: 1.2rem;
    --pet-text-sm: 1.3rem;
    --pet-text-base: 1.4rem;
    --pet-text-md: 1.5rem;
    --pet-text-lg: 1.6rem;
    --pet-text-xl: 1.8rem;
    --pet-text-2xl: 2.2rem;
    --pet-text-3xl: 2.4rem;
    --pet-text-4xl: 3.2rem;
    /* Radios (CSS-11): 5 tamaños y píldora; los círculos siguen con 50 % */
    --pet-radius-xs: 4px;
    --pet-radius-sm: 8px;
    --pet-radius-md: 12px;
    --pet-radius-lg: 16px;
    --pet-radius-xl: 20px;
    --pet-radius-pill: 9999px;
    /* Sombras de elevación (CSS-11): tarjetas pequeñas, cajas, paneles y menús desplegables */
    --pet-shadow-sm: 0 1px 3px rgba(var(--pet-ink), 0.06);
    --pet-shadow-md: 0 4px 12px rgba(var(--pet-ink), 0.08);
    --pet-shadow-lg: 0 8px 24px rgba(var(--pet-ink), 0.12);
    --pet-shadow-overlay: 0 14px 34px -4px rgba(var(--pet-ink), 0.14), 0 4px 10px -2px rgba(var(--pet-ink), 0.05);
    /* Foco de teclado de los controles propios (CSS-15): verde de la marca, más claro en los esquemas oscuros */
    --pet-focus-outline: 0.2rem solid rgb(var(--pet-text-accent));
    --pet-focus-offset: 0.2rem;
  }

  /*
    Dark color schemes (CSS-02): sections can use any scheme. On a dark background the pastel tints
    become dark tints of the background, borders get softer, and colored text gets lighter so it can
    still be read. Light schemes keep the values above.
  */
  {%- for scheme in settings.color_schemes -%}
    {%- assign pet_bg = scheme.settings.background -%}
    {%- assign pet_fg = scheme.settings.text -%}
    {%- assign pet_brightness = pet_bg | color_brightness -%}
    {%- if pet_brightness < 128 %}
      {% if forloop.first %}:root,{% endif %} .color-{{ scheme.id }} {
        --pet-card: {%- assign pet_card = pet_bg | color_mix: pet_fg, 94 -%}{{ pet_card | color_extract: 'red' }}, {{ pet_card | color_extract: 'green' }}, {{ pet_card | color_extract: 'blue' }};
        --pet-text-ink: {{ pet_fg | color_extract: 'red' }}, {{ pet_fg | color_extract: 'green' }}, {{ pet_fg | color_extract: 'blue' }};
        --pet-text-ink-2: {{ pet_fg | color_extract: 'red' }}, {{ pet_fg | color_extract: 'green' }}, {{ pet_fg | color_extract: 'blue' }};
        --pet-ink-gray: {{ pet_fg | color_extract: 'red' }}, {{ pet_fg | color_extract: 'green' }}, {{ pet_fg | color_extract: 'blue' }};
        {%- assign pet_c = pet_fg | color_mix: pet_bg, 75 -%}--pet-muted: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_fg | color_mix: pet_bg, 65 -%}--pet-muted-2: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        --pet-text-accent: 110, 231, 183;
        --pet-text-accent-dark: 110, 231, 183;
        --pet-text-accent-light: 110, 231, 183;
        --pet-text-accent-400: 110, 231, 183;
        --pet-text-accent-border: 167, 243, 208;
        --pet-accent-darker: 167, 243, 208;
        --pet-text-sky-700: 125, 211, 252;
        --pet-sky-800: 125, 211, 252;
        --pet-sky-900: 186, 230, 253;
        --pet-text-info: 103, 232, 249;
        --pet-text-error: 252, 165, 165;
        --pet-error-text: 252, 165, 165;
        --pet-error-dark: 254, 202, 202;
        --pet-warning-text: 252, 211, 77;
        --pet-warning-dark: 253, 230, 138;
        --pet-purple-700: 216, 180, 254;
        --pet-teal-700: 94, 234, 212;
        --pet-teal-900: 153, 246, 228;
        --pet-rose-700: 253, 164, 175;
        --pet-violet-700: 196, 181, 253;
        {%- assign pet_c = pet_bg | color_mix: '#10b981', 86 -%}--pet-accent-soft: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#10b981', 86 -%}--pet-accent-100: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#22c55e', 86 -%}--pet-green-50: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#22c55e', 86 -%}--pet-green-100: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#ef4444', 86 -%}--pet-error-100: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#ef4444', 86 -%}--pet-error-soft: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#f59e0b', 86 -%}--pet-warning-soft: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#f59e0b', 86 -%}--pet-warning-100: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#0ea5e9', 86 -%}--pet-sky-50: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#a855f7', 86 -%}--pet-purple-50: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#14b8a6', 86 -%}--pet-teal-50: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#f43f5e', 86 -%}--pet-rose-50: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#8b5cf6', 86 -%}--pet-violet-50: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#f59e0b', 86 -%}--pet-cream: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#f43f5e', 86 -%}--pet-blush: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#94a3b8', 86 -%}--pet-surface: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#10b981', 70 -%}--pet-accent-border: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#10b981', 70 -%}--pet-accent-300: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#22c55e', 70 -%}--pet-green-200: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#22c55e', 70 -%}--pet-green-300: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#0ea5e9', 70 -%}--pet-sky-200: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#a855f7', 70 -%}--pet-purple-200: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#14b8a6', 70 -%}--pet-teal-200: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#f43f5e', 70 -%}--pet-rose-200: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#8b5cf6', 70 -%}--pet-violet-200: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#ef4444', 70 -%}--pet-error-border: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#f59e0b', 70 -%}--pet-warning-border: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#f59e0b', 70 -%}--pet-warning-border-2: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#94a3b8', 70 -%}--pet-line: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
        {%- assign pet_c = pet_bg | color_mix: '#94a3b8', 70 -%}--pet-subtle: {{ pet_c | color_extract: 'red' }}, {{ pet_c | color_extract: 'green' }}, {{ pet_c | color_extract: 'blue' }};
      }
    {%- endif -%}
  {%- endfor %}
{% endstyle %}

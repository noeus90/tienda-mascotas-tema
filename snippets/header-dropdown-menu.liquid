{% comment %}
  Renders a standard dropdown style menu for the header.

  Usage:
  {% render 'header-dropdown-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- liquid
        assign nav_title_down = link.title | strip | downcase
        assign nav_display = link.title | escape
        if nav_title_down == 'home' or nav_title_down == 'inicio'
          assign nav_display = 'pet_cro.nav.home' | t
        elsif nav_title_down == 'catalog' or nav_title_down == 'catálogo' or nav_title_down == 'catalogo'
          assign nav_display = 'pet_cro.nav.catalog' | t
        elsif nav_title_down == 'contact' or nav_title_down == 'contacto'
          assign nav_display = 'pet_cro.nav.contact' | t
        elsif nav_title_down == 'bookings' or nav_title_down == 'booking' or nav_title_down == 'reservas' or nav_title_down == 'reserva'
          assign nav_display = 'pet_cro.nav.bookings' | t
        endif

        assign is_catalog_link = false
        if nav_title_down == 'catalog' or nav_title_down == 'catálogo' or nav_title_down == 'catalogo'
          assign is_catalog_link = true
        endif

        assign is_dog_link = false
        if nav_title_down contains 'perro' or nav_title_down contains 'dog'
          assign is_dog_link = true
        endif

        assign is_cat_link = false
        if nav_title_down contains 'gato' or nav_title_down contains 'cat'
          assign is_cat_link = true
        endif

        assign is_booking_link = false
        if nav_title_down contains 'booking' or nav_title_down contains 'reserva'
          assign is_booking_link = true
        endif
      -%}

      {%- if is_booking_link and section.settings.show_booking_cta != false -%}
        {% render 'header-booking-cta', section: section %}
      {%- elsif is_catalog_link and link.links == blank and section.settings.enable_species_navigation != false -%}
        {% render 'header-species-subnav', species: 'dog', section: section, id_prefix: 'dropdown' %}
        {% render 'header-species-subnav', species: 'cat', section: section, id_prefix: 'dropdown' %}
      {%- elsif is_dog_link and link.links == blank and section.settings.enable_species_navigation != false -%}
        {% render 'header-species-subnav', species: 'dog', section: section, id_prefix: 'dropdown' %}
      {%- elsif is_cat_link and link.links == blank and section.settings.enable_species_navigation != false -%}
        {% render 'header-species-subnav', species: 'cat', section: section, id_prefix: 'dropdown' %}
      {%- else -%}
        <li>
          {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- nav_display -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <ul
                id="HeaderMenu-MenuList-{{ forloop.index }}"
                class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
                role="list"
                tabindex="-1"
              >
                {%- for childlink in link.links -%}
                  <li>
                    {%- if childlink.links == blank -%}
                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} list-menu__item--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>
                    {%- else -%}
                      <details id="Details-HeaderSubMenu-{{ link.handle }}-{{ childlink.handle }}">
                        <summary
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          class="header__menu-item link link--text list-menu__item focus-inset caption-large"
                        >
                          <span>{{ childlink.title | escape }}</span>
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </summary>
                        <ul
                          id="HeaderMenu-SubMenuList-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                          class="header__submenu list-menu motion-reduce"
                        >
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url }}"
                                class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if grandchildlink.current %} list-menu__item--active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- nav_display -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endif -%}
    {%- endfor -%}

    {%- liquid
      assign has_bookings_link = false
      for link in section.settings.menu.links
        assign down_t = link.title | strip | downcase
        if down_t contains 'booking' or down_t contains 'reserva'
          assign has_bookings_link = true
        endif
      endfor
    -%}
    {%- if section.settings.show_booking_cta != false and has_bookings_link == false -%}
      {% render 'header-booking-cta', section: section %}
    {%- endif -%}
  </ul>
</nav>

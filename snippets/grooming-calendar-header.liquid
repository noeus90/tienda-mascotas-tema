      <!-- Header -->
      <header class="grooming-calendar-header">
      <div class="grooming-calendar-title-wrap">
        <span
          class="grooming-calendar-badge"
          data-i18n-es="Próximos 30 días"
          data-i18n-en="Next 30 days"
        >
          {{- 'pet_cro.calendar.badge_30_days' | t -}}
        </span>
        <h1
          class="grooming-calendar-heading"
          {% if is_default_gc_h %}
            data-i18n-es="Agenda de Citas de Peluquería Canina"
            data-i18n-en="Dog Grooming Schedule"
          {% endif %}
        >
          {%- if is_default_gc_h and gc_locale == 'en' -%}
            Dog Grooming Schedule
          {%- else -%}
            {{ section.settings.heading | default: 'Agenda de Citas de Peluquería Canina' }}
          {%- endif -%}
        </h1>
        {%- if section.settings.subheading != blank -%}
          <p
            class="grooming-calendar-subheading"
            {% if is_default_gc_sub %}
              data-i18n-es="Panel de control y gestión de citas programadas para los próximos 30 días."
              data-i18n-en="Appointment dashboard & booking management for the next 30 days."
            {% endif %}
          >
            {%- if is_default_gc_sub and gc_locale == 'en' -%}
              Appointment dashboard & booking management for the next 30 days.
            {%- else -%}
              {{ section.settings.subheading }}
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>

      <!-- Quick Metrics Bar -->
      <div class="grooming-calendar-metrics" aria-label="{{ 'pet_cro.calendar.appointments_count' | t: count: '' | strip }}">
        <div class="grooming-calendar-metric-card metric-confirmed">
          <span class="metric-value" data-metric="confirmed">0</span>
          <span
            class="metric-label"
            data-i18n-es="Confirmadas"
            data-i18n-en="Confirmed"
          >
            {{- 'pet_cro.calendar.summary_confirmed' | t -}}
          </span>
        </div>
        <div class="grooming-calendar-metric-card metric-pending">
          <span class="metric-value" data-metric="pending">0</span>
          <span
            class="metric-label"
            data-i18n-es="Pendientes"
            data-i18n-en="Pending"
          >
            {{- 'pet_cro.calendar.summary_pending' | t -}}
          </span>
        </div>
        <div class="grooming-calendar-metric-card metric-completed">
          <span class="metric-value" data-metric="completed">0</span>
          <span
            class="metric-label"
            data-i18n-es="Realizadas"
            data-i18n-en="Completed"
          >
            {{- 'pet_cro.calendar.summary_completed' | t -}}
          </span>
        </div>
      </div>
    </header>

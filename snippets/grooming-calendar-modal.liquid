  <!-- Appointment Details & Quick Management Modal -->
  <div
    class="grooming-calendar-modal-backdrop"
    id="grooming-modal-{{ section.id }}"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="grooming-modal-title-{{ section.id }}"
  >
    <div class="grooming-calendar-modal-card">
      <div class="grooming-calendar-modal-header">
        <div class="grooming-modal-header-info">
          <span class="grooming-modal-status-badge" id="modal-status-badge-{{ section.id }}"></span>
          <h3 class="grooming-modal-title" id="grooming-modal-title-{{ section.id }}">
            {{- 'pet_cro.calendar.modal_title' | t -}}
          </h3>
        </div>
        <button
          type="button"
          class="grooming-modal-close-btn"
          data-modal-action="close"
          aria-label="{{ 'pet_cro.calendar.modal_close' | t }}"
        >
          &times;
        </button>
      </div>

      <div class="grooming-calendar-modal-body" id="modal-body-content-{{ section.id }}">
        <!-- Injected dynamically on appointment click -->
      </div>

      <div class="grooming-calendar-modal-footer">
        <div class="grooming-modal-actions-left">
          <a
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="grooming-modal-btn btn-whatsapp"
            data-modal-action="whatsapp"
            data-i18n-es="Recordatorio WhatsApp"
            data-i18n-en="WhatsApp Reminder"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.392-12.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.185 1.564 5.938l-1.603 5.862 6.027-1.581c1.7 1.009 3.682 1.581 5.812 1.581 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/>
            </svg>
            <span>{{- 'pet_cro.calendar.modal_whatsapp_reminder' | t -}}</span>
          </a>
          <button
            type="button"
            class="grooming-modal-btn btn-confirm"
            data-modal-action="confirm"
            data-i18n-es="Confirmar Cita"
            data-i18n-en="Confirm Appointment"
          >
            {{- 'pet_cro.calendar.modal_action_confirm' | t -}}
          </button>
          <button
            type="button"
            class="grooming-modal-btn btn-complete"
            data-modal-action="complete"
            data-i18n-es="Marcar como Realizada"
            data-i18n-en="Mark as Completed"
          >
            {{- 'pet_cro.calendar.modal_action_complete' | t -}}
          </button>
          <button
            type="button"
            class="grooming-modal-btn btn-cancel"
            data-modal-action="cancel"
            data-i18n-es="Cancelar Cita"
            data-i18n-en="Cancel Appointment"
          >
            {{- 'pet_cro.calendar.modal_action_cancel' | t -}}
          </button>
        </div>
        <button
          type="button"
          class="grooming-modal-btn btn-secondary"
          data-modal-action="close"
          data-i18n-es="Cerrar"
          data-i18n-en="Close"
        >
          {{- 'pet_cro.calendar.modal_close' | t -}}
        </button>
      </div>
    </div>
  </div>

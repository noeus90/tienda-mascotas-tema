    {%- if section.settings.require_pin -%}
      <!-- Staff PIN Protection Gate -->
      <div
        class="grooming-calendar-pin-gate{% if request.design_mode %} is-bypassed-design-mode{% endif %}"
        id="grooming-pin-gate-{{ section.id }}"
        data-calendar-pin-gate
        aria-live="polite"
      >
        <div class="grooming-calendar-pin-card">
          <div class="grooming-calendar-pin-icon" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <span
            class="grooming-calendar-badge"
            data-i18n-es="Zona Protegida"
            data-i18n-en="Protected Area"
          >
            {{- 'pet_cro.calendar.pin_locked_badge' | t -}}
          </span>
          <h2
            class="grooming-calendar-pin-heading"
            data-i18n-es="Acceso exclusivo para el personal"
            data-i18n-en="Staff Access Only"
          >
            {{- 'pet_cro.calendar.pin_title' | t -}}
          </h2>
          <p
            class="grooming-calendar-pin-desc"
            data-i18n-es="Introduce el código PIN de recepción para ver y gestionar la agenda de peluquería canina."
            data-i18n-en="Enter the reception PIN code to view and manage the dog grooming schedule."
          >
            {{- 'pet_cro.calendar.pin_subtitle' | t -}}
          </p>

          <form class="grooming-calendar-pin-form" data-pin-form>
            <div class="grooming-calendar-pin-input-wrap">
              <input
                type="password"
                inputmode="numeric"
                pattern="[0-9]*"
                maxlength="10"
                class="grooming-calendar-pin-input"
                data-pin-input
                placeholder="••••"
                aria-label="{{ 'pet_cro.calendar.pin_placeholder' | t }}"
                autocomplete="current-password"
                required
              >
            </div>
            <div class="grooming-calendar-pin-error" data-pin-error role="alert" hidden>
              {{- 'pet_cro.calendar.pin_error' | t -}}
            </div>
            <button
              type="submit"
              class="grooming-calendar-btn-primary grooming-calendar-pin-submit"
              data-pin-submit
              data-i18n-es="Desbloquear Agenda"
              data-i18n-en="Unlock Schedule"
            >
              {{- 'pet_cro.calendar.pin_submit' | t -}}
            </button>
          </form>

          <div class="grooming-calendar-pin-hint">
            <span data-i18n-es="PIN predeterminado de recepción:" data-i18n-en="Default reception PIN:">
              PIN predeterminado de recepción:
            </span>
            <strong>{{ section.settings.admin_pin | default: '1234' }}</strong>
          </div>
        </div>
      </div>
    {%- endif -%}

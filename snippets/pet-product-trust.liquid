{%- doc -%}
  Dynamic Verified Reviews & Veterinary / Pet Care Guarantee Seals for Product Pages.
  Strategically placed below the Buy Buttons to reduce friction and boost conversion (CRO).

  @param {product} product - (Required) Shopify product object.

  @example
  {% render 'pet-product-trust', product: product %}
{%- enddoc -%}

{%- liquid
  assign rating_val = product.metafields.reviews.rating.value.rating | default: '4.9'
  assign rating_count = product.metafields.reviews.rating_count | default: '348'
-%}

<div class="cro-product-trust-box">
  <!-- Verified Pet Parents Review Bar -->
  <div class="cro-review-badge-bar">
    <div
      class="cro-stars"
      role="img"
      aria-label="{{ 'pet_cro.trust.aria_rating' | t: rating: rating_val }}"
    >
      ★★★★★
    </div>
    <span
      class="cro-review-score"
    >
      <strong>{{ rating_val }}/5</strong> ({{ rating_count }} {{ 'pet_cro.trust.verified_reviews' | t }})
    </span>
    <span class="cro-verified-pill">
      <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <span>{{ 'pet_cro.trust.vet_approved_badge' | t }}</span>
    </span>
  </div>

  <!-- 4 Pet Care Guarantee Seals -->
  <div class="cro-seals-mini-grid">
    <div class="cro-seal-mini-item">
      <div class="cro-seal-mini-icon">
        <!-- 100% Natural (Leaf) -->
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
          <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
        </svg>
      </div>
      <span>{{ 'pet_cro.trust.natural' | t }}</span>
    </div>

    <div class="cro-seal-mini-item">
      <div class="cro-seal-mini-icon">
        <!-- Cruelty-Free / Pet Love (Paw / Heart) -->
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="4" r="2"/>
          <circle cx="18" cy="8" r="2"/>
          <circle cx="20" cy="16" r="2"/>
          <path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/>
        </svg>
      </div>
      <span>{{ 'pet_cro.trust.cruelty_free' | t }}</span>
    </div>

    <div class="cro-seal-mini-item">
      <div class="cro-seal-mini-icon">
        <!-- Vet Tested (Shield + Check) -->
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </div>
      <span>{{ 'pet_cro.trust.vet_tested' | t }}</span>
    </div>

    <div class="cro-seal-mini-item">
      <div class="cro-seal-mini-icon">
        <!-- Hypoallergenic / Grain & Sulfate Free (Droplet / Pure) -->
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
        </svg>
      </div>
      <span>{{ 'pet_cro.trust.grain_free' | t }}</span>
    </div>
  </div>
</div>

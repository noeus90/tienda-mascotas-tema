{%- doc -%}
  Trust box under the buy buttons: real reviews (only when a reviews app provides them) and four
  promises the store keeps today: free shipping threshold, 14-day returns (frozen products: chilled
  shipping instead, they cannot be returned), secure payment and online grooming booking.

  @param {product} product - (Required) Shopify product object.

  @example
  {% render 'pet-product-trust', product: product %}
{%- enddoc -%}

{%- liquid
  # Solo valoraciones reales de una app de reseñas; nunca un número inventado.
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign has_rating = false
  if rating != blank and rating_count > 0
    assign has_rating = true
    assign rating_val = rating.rating | round: 1
  endif
  capture free_goal
    render 'free-shipping-goal'
  endcapture
  assign free_goal = free_goal | plus: 0
  assign free_amount = free_goal | money_without_trailing_zeros
  assign frozen_tag = settings.frozen_tag | default: 'congelado' | strip
  assign is_frozen = false
  if product.tags contains frozen_tag
    assign is_frozen = true
    # Frozen products ship apart, with their own free shipping threshold.
    assign free_amount = settings.frozen_free_threshold | default: 60 | times: 100 | money_without_trailing_zeros
  endif
  capture booking_url
    render 'booking-url'
  endcapture
-%}

<div class="cro-product-trust-box pet-panel">
  {%- if has_rating -%}
    <div class="cro-review-badge-bar">
      <div
        class="cro-stars"
        role="img"
        aria-label="{{ 'pet_cro.trust.aria_rating' | t: rating: rating_val }}"
      >
        ★★★★★
      </div>
      <span class="cro-review-score">
        <strong>{{ rating_val }}/5</strong> ({{ rating_count }} {{ 'pet_cro.trust.verified_reviews' | t }})
      </span>
    </div>
  {%- endif -%}

  <ul class="cro-seals-mini-grid" role="list">
    <li class="cro-seal-mini-item">
      <div class="cro-seal-mini-icon">
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
      </div>
      <span>{{ 'pet_cro.trust.free_shipping' | t: amount: free_amount }}</span>
    </li>

    <li class="cro-seal-mini-item">
      <div class="cro-seal-mini-icon">
        {%- if is_frozen -%}
          <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="2" x2="12" y2="22"/><line x1="4.93" y1="6" x2="19.07" y2="18"/><line x1="4.93" y1="18" x2="19.07" y2="6"/>
          </svg>
        {%- else -%}
          <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
          </svg>
        {%- endif -%}
      </div>
      <span>{% if is_frozen %}{{ 'pet_cro.trust.chilled' | t }}{% else %}{{ 'pet_cro.trust.returns' | t }}{% endif %}</span>
    </li>

    <li class="cro-seal-mini-item">
      <div class="cro-seal-mini-icon">
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      <span>{{ 'pet_cro.trust.secure_payment' | t }}</span>
    </li>

    <li class="cro-seal-mini-item">
      <div class="cro-seal-mini-icon">
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
      </div>
      <span><a href="{{ booking_url }}">{{ 'pet_cro.trust.booking' | t }}</a></span>
    </li>
  </ul>
</div>

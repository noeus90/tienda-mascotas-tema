{% comment %}
  Pet Product Badges (snippets/pet-product-badges.liquid)
  Renders semantic badges for pet species (Dog/Cat) and product benefits (Grain-free, Natural, Dental, Puppy)
  Accepts:
  - card_product: {Object} Product Liquid object
{% endcomment %}

{%- liquid
  if card_product == blank
    break
  endif

  assign tags_str = card_product.tags | join: ',' | downcase
  assign type_str = card_product.type | downcase
  assign title_str = card_product.title | downcase
  assign meta_species = card_product.metafields.custom.tipo_mascota.value | default: card_product.metafields.custom.pet_type.value | downcase
  assign combined_text = tags_str | append: ' ' | append: type_str | append: ' ' | append: title_str | append: ' ' | append: meta_species

  # 1. Detect Species
  assign is_dog = false
  assign is_cat = false

  # A product can be for both species (e.g. "perro, gato" or both tags): then both badges show.
  # The metafield wins over tags, type and title when it is filled in.
  if meta_species != blank
    if meta_species contains 'perro' or meta_species contains 'dog'
      assign is_dog = true
    endif
    if meta_species contains 'gato' or meta_species contains 'cat'
      assign is_cat = true
    endif
  endif

  unless is_dog or is_cat
    if combined_text contains 'gato' or combined_text contains 'felino' or combined_text contains 'kitten' or combined_text contains 'cat'
      assign is_cat = true
    endif
    if combined_text contains 'perro' or combined_text contains 'canino' or combined_text contains 'puppy' or combined_text contains 'cachorro' or combined_text contains 'dog'
      assign is_dog = true
    endif
    # Default to dog if it mentions bone or chew
    unless is_dog or is_cat
      if combined_text contains 'hueso' or combined_text contains 'mordedor'
        assign is_dog = true
      endif
    endunless
  endunless

  # 2. Detect Key Benefits
  assign is_grain_free = false
  if combined_text contains 'grain-free' or combined_text contains 'sin cereales' or combined_text contains 'grain free'
    assign is_grain_free = true
  endif

  assign is_natural = false
  if combined_text contains 'natural' or combined_text contains '100%' or combined_text contains 'organico' or combined_text contains 'artesanal'
    assign is_natural = true
  endif

  assign is_dental = false
  if combined_text contains 'dental' or combined_text contains 'dientes' or combined_text contains 'sarro'
    assign is_dental = true
  endif

  assign is_puppy = false
  if combined_text contains 'cachorro' or combined_text contains 'puppy' or combined_text contains 'junior'
    assign is_puppy = true
  endif

  assign is_senior = false
  if combined_text contains 'senior' or combined_text contains 'anciano' or combined_text contains 'edad avanzada'
    assign is_senior = true
  endif

  assign is_hypo = false
  if combined_text contains 'hipoalergenico' or combined_text contains 'hipoalergénico' or combined_text contains 'alergia' or combined_text contains 'monoproteico'
    assign is_hypo = true
  endif
-%}

{%- if is_dog or is_cat or is_grain_free or is_natural or is_dental or is_puppy or is_senior or is_hypo -%}
  <div class="pet-card-badges-wrap" aria-label="{{ 'pet_cro.badge.features_aria' | t }}">
    {%- if is_dog -%}
      <span class="pet-card-badge pet-card-badge--species pet-card-badge--dog">
        {{ 'pet_cro.badge.dog' | t }}
      </span>
    {%- endif -%}
    {%- if is_cat -%}
      <span class="pet-card-badge pet-card-badge--species pet-card-badge--cat">
        {{ 'pet_cro.badge.cat' | t }}
      </span>
    {%- endif -%}

    {%- if is_grain_free -%}
      <span class="pet-card-badge pet-card-badge--grain-free">
        {{ 'pet_cro.badge.grain_free' | t }}
      </span>
    {%- elsif is_hypo -%}
      <span class="pet-card-badge pet-card-badge--hypo">
        {{ 'pet_cro.badge.hypoallergenic' | t }}
      </span>
    {%- elsif is_natural -%}
      <span class="pet-card-badge pet-card-badge--natural">
        {{ 'pet_cro.badge.natural' | t }}
      </span>
    {%- elsif is_dental -%}
      <span class="pet-card-badge pet-card-badge--dental">
        {{ 'pet_cro.badge.dental' | t }}
      </span>
    {%- elsif is_puppy -%}
      <span class="pet-card-badge pet-card-badge--puppy">
        {{ 'pet_cro.badge.puppy' | t }}
      </span>
    {%- elsif is_senior -%}
      <span class="pet-card-badge pet-card-badge--senior">
        {{ 'pet_cro.badge.senior' | t }}
      </span>
    {%- endif -%}
  </div>
{%- endif -%}


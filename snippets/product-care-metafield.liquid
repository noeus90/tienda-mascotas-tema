{%- doc -%}
  Storage, Washing & Care Instructions box from product metafield (custom.care_instructions or custom.instrucciones_cuidado).

  @param {product} product - (Required) Shopify product object.

  @example
  {% render 'product-care-metafield', product: product %}
{%- enddoc -%}

{%- liquid
  assign care_instructions = product.metafields.custom.care_instructions.value | default: product.metafields.custom.instrucciones_cuidado.value
-%}

{%- if care_instructions != blank -%}
  <div class="product-care-box pet-panel">
    <div class="product-care-header">
      <svg
        aria-hidden="true"
        focusable="false"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      <strong
        class="product-care-title"
      >
        {{ 'pet_cro.care_guide.title' | t }}
      </strong>
    </div>
    <div class="product-care-body">
      {{ care_instructions | newline_to_br }}
    </div>
  </div>
{%- endif -%}

{%- doc -%}
  Enriched Product SEO Structured Data (JSON-LD) for Pet Shop & Dog Grooming products.
  Complements Shopify's native {{ product | structured_data }} filter with:
  - Dynamic aggregateRating (enables Google Rich Snippets / golden review stars in SERP).
  - Additional Pet Care properties from Metafields (pet suitability / breed size and analytical composition).

  @param {product} product - (Required) Shopify product object.

  @example
  {% render 'seo-schema-product', product: product %}
{%- enddoc -%}

{%- if product != blank -%}
  {%- liquid
    assign rating_val = product.metafields.reviews.rating.value.rating | default: 4.9
    assign rating_max = product.metafields.reviews.rating.value.scale_max | default: 5
    assign rating_min = product.metafields.reviews.rating.value.scale_min | default: 1
    assign rating_count = product.metafields.reviews.rating_count | default: 348
    assign pet_suitability = product.metafields.custom.pet_suitability.value | default: product.metafields.custom.tipo_piel.value
    assign analytical_comp = product.metafields.custom.analytical_composition.value | default: product.metafields.custom.lista_inci.value
    assign current_variant = product.selected_or_first_available_variant
    assign product_url = request.origin | append: product.url
  -%}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": {{ product_url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "url": {{ product_url | json }},
      {%- if product.featured_media -%}
        "image": [
          {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}
        ],
      {%- endif -%}
      "description": {{ product.description | strip_html | truncatewords: 120 | json }},
      {%- if current_variant.sku != blank -%}
        "sku": {{ current_variant.sku | json }},
      {%- endif -%}
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: shop.name | json }}
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ rating_val | json }},
        "reviewCount": {{ rating_count | json }},
        "bestRating": {{ rating_max | json }},
        "worstRating": {{ rating_min | json }}
      }
      {%- if pet_suitability != blank or analytical_comp != blank -%},
      "additionalProperty": [
        {%- if pet_suitability != blank -%}
          {
            "@type": "PropertyValue",
            "name": {{ 'pet_cro.tabs.ideal_for' | t | remove: ':' | json }},
            "value": {{ pet_suitability | json }}
          }{%- if analytical_comp != blank -%},{%- endif -%}
        {%- endif -%}
        {%- if analytical_comp != blank -%}
          {
            "@type": "PropertyValue",
            "name": "Analytical Composition",
            "value": {{ analytical_comp | json }}
          }
        {%- endif -%}
      ]
      {%- endif -%}
    }
  </script>
{%- endif -%}

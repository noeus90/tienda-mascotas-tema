{%- doc -%}
  Product SEO Structured Data (JSON-LD) for Pet Shop & Dog Grooming products.
  Outputs Shopify's native {{ product | structured_data }} (name, images, offers, availability) and,
  only when real data exists, a second block with the same @id so Google merges both:
  - aggregateRating, only from the standard review metafields (reviews.rating and reviews.rating_count)
    written by a review app. Never invented: Google penalises ratings without real reviews.
  - Pet care properties from metafields (pet suitability / analytical composition).

  @param {product} product - (Required) Shopify product object.

  @example
  {% render 'seo-schema-product', product: product %}
{%- enddoc -%}

{%- if product != blank -%}
  {%- liquid
    assign rating = product.metafields.reviews.rating.value
    assign rating_count = product.metafields.reviews.rating_count.value | default: 0
    assign has_rating = false
    if rating != blank and rating_count > 0
      assign has_rating = true
    endif
    assign pet_suitability = product.metafields.custom.pet_suitability.value | default: product.metafields.custom.tipo_piel.value
    assign analytical_comp = product.metafields.custom.analytical_composition.value | default: product.metafields.custom.lista_inci.value
  -%}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  {%- if has_rating or pet_suitability != blank or analytical_comp != blank -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "@id": {{ product.url | append: '#product' | json }},
        "name": {{ product.title | json }}
        {%- if has_rating -%},
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ rating.rating | json }},
            "reviewCount": {{ rating_count | json }},
            "bestRating": {{ rating.scale_max | default: 5 | json }},
            "worstRating": {{ rating.scale_min | default: 1 | json }}
          }
        {%- endif -%}
        {%- if pet_suitability != blank or analytical_comp != blank -%},
          "additionalProperty": [
            {%- if pet_suitability != blank -%}
              {
                "@type": "PropertyValue",
                "name": {{ 'pet_cro.tabs.ideal_for' | t | remove: ':' | json }},
                "value": {{ pet_suitability | json }}
              }{%- if analytical_comp != blank -%},{%- endif -%}
            {%- endif -%}
            {%- if analytical_comp != blank -%}
              {
                "@type": "PropertyValue",
                "name": "Analytical Composition",
                "value": {{ analytical_comp | json }}
              }
            {%- endif -%}
          ]
        {%- endif -%}
      }
    </script>
  {%- endif -%}
{%- endif -%}

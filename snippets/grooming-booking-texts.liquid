{%- comment -%}
  Texts of grooming-booking.js in the page language (locales pet_cro.booking.js.*, CODE-11).
  A key added there must be added to this list too. {{ name }} placeholders are filled in by the JS.
{%- endcomment -%}
{%- liquid
  assign booking_text_keys = 'waitlist_invalid waitlist_already waitlist_joined waitlist_confirm waitlist_too_many waitlist_failed no_connection groomer_any groomer_any_bio groomer_any_summary groomer_favorite_note groomer_last_note groomer_save_favorite size_mini size_medium size_large another_dog mixed_breed day_past day_holiday day_closed day_full day_available select_day slot_booked slot_booked_title one_hour hours hours_minutes minutes estimate_pending no_special payment_required payment_optional sending too_many_pending invalid_fields field_date field_time field_service field_dog_size field_pet_name field_owner_name field_owner_phone field_owner_email save_failed save_no_connection saved_pay_deposit saved deposit_required deposit_required_by deposit_optional deposit_pay deposit_demo slot_taken copied copy_failed downloaded your_dog salon message_title message_intro message_outro message_subject event_title event_reminder label_dog label_age label_service label_extras label_date label_time label_groomer label_price label_special label_notes label_owner label_address breed_mixed breed_suggested breed_unknown breed_adjusted' | split: ' '
-%}
<script type="application/json" data-booking-texts>
  {
  {%- for key in booking_text_keys -%}
    {%- assign text_key = 'pet_cro.booking.js.' | append: key -%}
    {{ key | json }}: {{ text_key | t | json }}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  }
</script>

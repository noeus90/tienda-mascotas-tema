{%- doc -%}
  CRO Subscription Selector ("One-Time Purchase vs. Auto-Delivery & Save") for Pet Food & Grooming Supplies.
  Calculates the discounted price in real time and binds the selected mode and delivery frequency to the product form.

  @param {product} product - (Required) Shopify product object.
  @param {string} product_form_id - (Required) Main product form ID in the section.
  @param {number} [discount_percentage] - (Optional) Subscription discount percentage (default: 15).

  @example
  {% render 'subscription-selector', product: product, product_form_id: product_form_id %}
{%- enddoc -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign single_price = current_variant.price
  assign discount_pct = discount_percentage | default: 15
  assign pay_factor = 100 | minus: discount_pct
  assign sub_price = single_price | times: pay_factor | divided_by: 100.0 | round
  assign savings_money = single_price | minus: sub_price
  assign formatted_savings = savings_money | money
  assign prop_mode_name = 'pet_cro.subscription.prop_mode' | t
  assign prop_freq_name = 'pet_cro.subscription.prop_frequency' | t
-%}

<div
  class="cro-sub-widget"
  id="sub-widget-{{ section.id }}"
  role="radiogroup"
  aria-labelledby="sub-heading-{{ section.id }}"
  data-label-sub="{{ 'pet_cro.subscription.sub_title' | t }} ({{ discount_pct }}%)"
  data-label-onetime="{{ 'pet_cro.subscription.onetime_title' | t }}"
>
  <!-- Hidden line item properties linked to the native Shopify product form -->
  <input
    type="hidden"
    name="properties[{{ prop_mode_name }}]"
    id="sub-prop-mode-{{ section.id }}"
    value="{{ 'pet_cro.subscription.sub_title' | t }} ({{ discount_pct }}%)"
    form="{{ product_form_id }}"
  >
  <input
    type="hidden"
    name="properties[{{ prop_freq_name }}]"
    id="sub-prop-frequency-{{ section.id }}"
    value="{{ 'pet_cro.subscription.every_30' | t }}"
    form="{{ product_form_id }}"
  >

  <span
    class="cro-sub-heading"
    id="sub-heading-{{ section.id }}"
  >
    {{- 'pet_cro.subscription.heading' | t -}}
  </span>

  <!-- OPTION 1: AUTO-DELIVERY & SAVE (Selected by default to maximize LTV) -->
  <div
    class="cro-sub-option is-selected"
    id="sub-opt-recurring-{{ section.id }}"
    role="radio"
    aria-checked="true"
    tabindex="0"
    data-sub-option
    data-section-id="{{ section.id }}"
    data-mode="sub"
    data-discount="{{ discount_pct }}"
  >
    <div
      class="cro-sub-badge-popular"
    >
      {{- 'pet_cro.subscription.most_popular' | t: percent: discount_pct -}}
    </div>

    <div class="cro-sub-row-main">
      <div class="cro-sub-radio-group">
        <span class="cro-sub-radio-circle" aria-hidden="true"></span>
        <div>
          <span
            class="cro-sub-title"
          >
            {{- 'pet_cro.subscription.sub_title' | t -}}
          </span>
          <span
            class="cro-sub-subtitle"
          >
            {{- 'pet_cro.subscription.sub_subtitle' | t -}}
          </span>
        </div>
      </div>

      <div class="cro-sub-price-box">
        <span class="cro-sub-price-old">{{ single_price | money }}</span>
        <span class="cro-sub-price-final">{{ sub_price | money }}</span>
      </div>
    </div>

    <!-- Expandable subscription details -->
    <div class="cro-sub-details" id="sub-details-{{ section.id }}">
      <div class="cro-sub-freq-wrapper">
        <label
          for="sub-freq-select-{{ section.id }}"
        >
          {{- 'pet_cro.subscription.frequency_label' | t -}}
        </label>
        <select
          id="sub-freq-select-{{ section.id }}"
          class="cro-sub-select"
          data-sub-freq-select
          data-section-id="{{ section.id }}"
        >
          <option
            value="{{ 'pet_cro.subscription.every_30' | t }}"
          >
            {{- 'pet_cro.subscription.every_30' | t -}}
          </option>
          <option
            value="{{ 'pet_cro.subscription.every_45' | t }}"
          >
            {{- 'pet_cro.subscription.every_45' | t -}}
          </option>
          <option
            value="{{ 'pet_cro.subscription.every_60' | t }}"
          >
            {{- 'pet_cro.subscription.every_60' | t -}}
          </option>
        </select>
      </div>

      <ul class="cro-sub-perks">
        <li>
          <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>
            {{- 'pet_cro.subscription.perk_savings_html' | t: amount: formatted_savings -}}
          </span>
        </li>
        <li>
          <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>
            {{- 'pet_cro.subscription.perk_cancel' | t -}}
          </span>
        </li>
        <li>
          <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>
            {{- 'pet_cro.subscription.perk_shipping' | t -}}
          </span>
        </li>
      </ul>
    </div>
  </div>

  <!-- OPTION 2: ONE-TIME PURCHASE -->
  <div
    class="cro-sub-option"
    id="sub-opt-onetime-{{ section.id }}"
    role="radio"
    aria-checked="false"
    tabindex="0"
    data-sub-option
    data-section-id="{{ section.id }}"
    data-mode="onetime"
    data-discount="{{ discount_pct }}"
  >
    <div class="cro-sub-row-main">
      <div class="cro-sub-radio-group">
        <span class="cro-sub-radio-circle" aria-hidden="true"></span>
        <div>
          <span
            class="cro-sub-title"
          >
            {{- 'pet_cro.subscription.onetime_title' | t -}}
          </span>
          <span
            class="cro-sub-subtitle"
          >
            {{- 'pet_cro.subscription.onetime_subtitle' | t -}}
          </span>
        </div>
      </div>

      <div class="cro-sub-price-box">
        <span class="cro-sub-price-final">{{ single_price | money }}</span>
      </div>
    </div>
  </div>
</div>

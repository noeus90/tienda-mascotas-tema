{% doc %}
  Renders the header drawer menu.

  @param {boolean} [show_country_selector] - Whether to show the country selector. Defaults to `false`.
  @param {boolean} [show_language_selector] - Whether to show the language selector. Defaults to `false`.
  @param {boolean} [show_social_links] - Whether to show links for configured social accounts. Defaults to `false`.

  @param {object} [section] - The current header section context, supplied implicitly when rendered from that section and used for menu settings.

  @example
  {% render 'header-drawer',
    show_country_selector: true,
    show_language_selector: true,
    show_social_links: true
  %}
{% enddoc %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      {%- liquid
        # Pet links go to the Perros / Gatos collections with Search & Discovery filters
        # (filter.p.product_type = product type, filter.p.tag = need tag), so Shopify filters every page.
        assign dog_url = routes.collections_url | append: '/perros'
        assign cat_url = routes.collections_url | append: '/gatos'
        assign p_cat_key = 'filter.p.product_type'
        assign p_subfilter_key = 'filter.p.tag'
        assign val_kibble = 'Pienso'
        assign val_wet = 'Comida húmeda' | url_encode
        assign val_barf = 'Dieta BARF' | url_encode
        assign val_snacks = 'Snack'
        assign val_toys = 'Juguete'
        assign val_grooming = 'Higiene'
        assign val_accessories = 'Accesorio'
        assign val_puppy = 'cachorro'
        assign val_kitten = 'gatito'
        assign val_adult = 'adulto'
        assign val_senior = 'senior'
        assign val_sensitive = 'sensible'
        assign val_hypoallergenic = 'hipoalergenico'
        assign val_sterilised = 'esterilizado'
        assign val_hairball = 'bolas de pelo' | url_encode
        assign drawer_lang_code = request.locale.iso_code | slice: 0, 2 | downcase
        if drawer_lang_code == 'en'
          assign drawer_booking_slug = 'pages/bookings'
        else
          assign drawer_booking_slug = 'pages/bookings'
        endif

        assign drawer_root_path = routes.root_url
        if drawer_root_path != '/' and drawer_root_path != blank
          assign drawer_booking_url = drawer_root_path | append: '/' | append: drawer_booking_slug | replace: '//', '/'
        else
          assign drawer_booking_url = '/' | append: drawer_booking_slug
        endif

        if section.settings.booking_url != blank
          assign drawer_booking_url = section.settings.booking_url
        endif
      -%}
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            {%- if section.settings.show_booking_cta != false -%}
              <div class="menu-drawer__cta-box">
                <a
                  href="{{ drawer_booking_url }}"
                  class="menu-drawer__cta-btn link focus-inset{% if request.path contains '/pages/bookings' or request.path contains '/pages/reservas' %} is-active{% endif %}"
                  {% if request.path contains '/pages/bookings' or request.path contains '/pages/reservas' %}
                    aria-current="page"
                  {% endif %}
                >
                  <span class="cta-booking-icon" aria-hidden="true">✂️</span>
                  <span>
                    {{- 'pet_cro.nav.book_grooming' | t | default: 'Reservar Cita' -}}
                  </span>
                </a>
              </div>
            {%- endif -%}

            {%- if section.settings.enable_species_navigation != false -%}
              <div class="menu-drawer__species-tabs" role="region" aria-label="{{ 'pet_cro.nav.species_nav_aria' | t }}">
                <a
                  href="{{ dog_url }}"
                  class="menu-drawer__species-tab link focus-inset"
                >
                  <span class="menu-drawer__species-tab-emoji" aria-hidden="true">🐶</span>
                  <div class="menu-drawer__species-tab-content">
                    <span class="menu-drawer__species-tab-title">{{ 'pet_cro.nav.dogs' | t | default: 'Perros' }}</span>
                    <span class="menu-drawer__species-tab-sub">{{ 'pet_cro.nav.view_all_dogs' | t | default: 'Ver todo' }}</span>
                  </div>
                </a>
                <a
                  href="{{ cat_url }}"
                  class="menu-drawer__species-tab link focus-inset"
                >
                  <span class="menu-drawer__species-tab-emoji" aria-hidden="true">🐱</span>
                  <div class="menu-drawer__species-tab-content">
                    <span class="menu-drawer__species-tab-title">{{ 'pet_cro.nav.cats' | t | default: 'Gatos' }}</span>
                    <span class="menu-drawer__species-tab-sub">{{ 'pet_cro.nav.view_all_cats' | t | default: 'Ver todo' }}</span>
                  </div>
                </a>
              </div>
            {%- endif -%}

            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- for link in section.settings.menu.links -%}
                {%- liquid
                  assign nav_title_down = link.title | strip | downcase
                  assign nav_display = link.title | escape
                  if nav_title_down == 'home' or nav_title_down == 'inicio'
                    assign nav_display = 'pet_cro.nav.home' | t
                  elsif nav_title_down == 'catalog' or nav_title_down == 'catálogo' or nav_title_down == 'catalogo'
                    assign nav_display = 'pet_cro.nav.catalog' | t
                  elsif nav_title_down == 'contact' or nav_title_down == 'contacto'
                    assign nav_display = 'pet_cro.nav.contact' | t
                  elsif nav_title_down == 'bookings' or nav_title_down == 'booking' or nav_title_down == 'reservas' or nav_title_down == 'reserva'
                    assign nav_display = 'pet_cro.nav.bookings' | t
                  endif

                  assign is_catalog_link = false
                  if nav_title_down == 'catalog' or nav_title_down == 'catálogo' or nav_title_down == 'catalogo'
                    assign is_catalog_link = true
                  endif

                  assign is_booking_link = false
                  if nav_title_down contains 'booking' or nav_title_down contains 'reserva'
                    assign is_booking_link = true
                  endif
                -%}

                {%- if is_booking_link and section.settings.show_booking_cta != false -%}
                  {% comment %}Rendered as top CTA button{% endcomment %}
                {%- elsif is_catalog_link and link.links == blank and section.settings.enable_species_navigation != false -%}
                  <li>
                    <details id="Details-menu-drawer-pet-dog">
                      <summary
                        id="HeaderDrawer-pet-dog"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
                      >
                        <span>🐶 {{ 'pet_cro.nav.dogs' | t | default: 'Perros' }}</span>
                        <span class="svg-wrapper">
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </summary>
                      <div
                        id="link-pet-dog"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                        tabindex="-1"
                      >
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                            <span class="svg-wrapper">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                            🐶 {{ 'pet_cro.nav.dogs' | t | default: 'Perros' }}
                          </button>
                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            <li>
                              <a
                                href="{{ dog_url }}?{{ p_cat_key }}={{ val_kibble }}"
                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                              >
                                🥩 {{ 'pet_cro.nav.kibble' | t | default: 'Pienso Seco' }}
                              </a>
                            </li>
                            <li>
                              <a
                                href="{{ dog_url }}?{{ p_cat_key }}={{ val_wet }}"
                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                              >
                                🥫 {{ 'pet_cro.nav.wet_food' | t | default: 'Comida Húmeda' }}
                              </a>
                            </li>
                            <li>
                              <a
                                href="{{ dog_url }}?{{ p_cat_key }}={{ val_barf }}"
                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                              >
                                🍖 {{ 'pet_cro.nav.barf' | t | default: 'Dieta BARF' }}
                              </a>
                            </li>
                            <li>
                              <a
                                href="{{ dog_url }}?{{ p_cat_key }}={{ val_snacks }}"
                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                              >
                                🦴 {{ 'pet_cro.nav.snacks' | t | default: 'Snacks & Premios' }}
                              </a>
                            </li>
                            <li>
                              <a
                                href="{{ dog_url }}?{{ p_cat_key }}={{ val_toys }}"
                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                              >
                                🎾 {{ 'pet_cro.nav.toys' | t | default: 'Juguetes' }}
                              </a>
                            </li>
                            <li>
                              <a
                                href="{{ dog_url }}?{{ p_cat_key }}={{ val_grooming }}"
                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                              >
                                🧴 {{ 'pet_cro.nav.grooming' | t | default: 'Higiene & Cuidados' }}
                              </a>
                            </li>
                            <li>
                              <a
                                href="{{ dog_url }}?{{ p_cat_key }}={{ val_accessories }}"
                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                              >
                                🦮 {{ 'pet_cro.nav.walk' | t | default: 'Paseo & Accesorios' }}
                              </a>
                            </li>
                            <li>
                              <a
                                href="{{ dog_url }}"
                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset menu-drawer__menu-item--highlight"
                              >
                                🐾 <strong>{{ 'pet_cro.nav.view_all_dogs' | t | default: 'Ver todo para Perros' }}</strong>
                              </a>
                            </li>
                          </ul>

                          <!-- Microfiltros de Etapa y Salud (Perros) -->
                          <div class="menu-drawer__subfilters-section">
                            <span class="menu-drawer__subfilters-heading">{{ 'pet_cro.nav.subfilters_title' | t | default: 'Por Etapa o Necesidad:' }}</span>
                            <div class="menu-drawer__subfilters-scroll">
                              <a href="{{ dog_url }}?{{ p_subfilter_key }}={{ val_puppy }}" class="menu-drawer__subfilter-pill link focus-inset">
                                🍼 {{ 'pet_cro.nav.puppy' | t | default: 'Cachorros' }}
                              </a>
                              <a href="{{ dog_url }}?{{ p_subfilter_key }}={{ val_adult }}" class="menu-drawer__subfilter-pill link focus-inset">
                                🐕 {{ 'pet_cro.nav.adult' | t | default: 'Adultos' }}
                              </a>
                              <a href="{{ dog_url }}?{{ p_subfilter_key }}={{ val_senior }}" class="menu-drawer__subfilter-pill link focus-inset">
                                🦺 {{ 'pet_cro.nav.senior' | t | default: 'Senior (+7a)' }}
                              </a>
                              <a href="{{ dog_url }}?{{ p_subfilter_key }}={{ val_sensitive }}" class="menu-drawer__subfilter-pill link focus-inset">
                                🌾 {{ 'pet_cro.nav.sensitive' | t | default: 'Sensible' }}
                              </a>
                              <a href="{{ dog_url }}?{{ p_subfilter_key }}={{ val_hypoallergenic }}" class="menu-drawer__subfilter-pill link focus-inset">
                                🛡️ {{ 'pet_cro.nav.hypoallergenic' | t | default: 'Hipoalergénico' }}
                              </a>
                            </div>
                          </div>
                        </div>
                      </div>
                    </details>
                  </li>
                  <li>
                    <details id="Details-menu-drawer-pet-cat">
                      <summary
                        id="HeaderDrawer-pet-cat"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
                      >
                        <span>🐱 {{ 'pet_cro.nav.cats' | t | default: 'Gatos' }}</span>
                        <span class="svg-wrapper">
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </summary>
                      <div
                        id="link-pet-cat"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                        tabindex="-1"
                      >
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                            <span class="svg-wrapper">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                            🐱 {{ 'pet_cro.nav.cats' | t | default: 'Gatos' }}
                          </button>
                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            <li>
                              <a
                                href="{{ cat_url }}?{{ p_cat_key }}={{ val_kibble }}"
                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                              >
                                🥩 {{ 'pet_cro.nav.kibble' | t | default: 'Pienso Seco' }}
                              </a>
                            </li>
                            <li>
                              <a
                                href="{{ cat_url }}?{{ p_cat_key }}={{ val_wet }}"
                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                              >
                                🥫 {{ 'pet_cro.nav.wet_food' | t | default: 'Comida Húmeda' }}
                              </a>
                            </li>
                            <li>
                              <a
                                href="{{ cat_url }}?{{ p_cat_key }}={{ val_snacks }}"
                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                              >
                                🦴 {{ 'pet_cro.nav.snacks' | t | default: 'Snacks & Premios' }}
                              </a>
                            </li>
                            <li>
                              <a
                                href="{{ cat_url }}?{{ p_cat_key }}={{ val_toys }}"
                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                              >
                                🎾 {{ 'pet_cro.nav.toys' | t | default: 'Juguetes & Rascadores' }}
                              </a>
                            </li>
                            <li>
                              <a
                                href="{{ cat_url }}?{{ p_cat_key }}={{ val_grooming }}"
                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                              >
                                🧴 {{ 'pet_cro.nav.grooming' | t | default: 'Higiene & Arena' }}
                              </a>
                            </li>
                            <li>
                              <a
                                href="{{ cat_url }}"
                                class="menu-drawer__menu-item link link--text list-menu__item focus-inset menu-drawer__menu-item--highlight"
                              >
                                🐾 <strong>{{ 'pet_cro.nav.view_all_cats' | t | default: 'Ver todo para Gatos' }}</strong>
                              </a>
                            </li>
                          </ul>

                          <!-- Microfiltros de Etapa y Salud (Gatos) -->
                          <div class="menu-drawer__subfilters-section">
                            <span class="menu-drawer__subfilters-heading">{{ 'pet_cro.nav.subfilters_title' | t | default: 'Por Etapa o Necesidad:' }}</span>
                            <div class="menu-drawer__subfilters-scroll">
                              <a href="{{ cat_url }}?{{ p_subfilter_key }}={{ val_kitten }}" class="menu-drawer__subfilter-pill link focus-inset">
                                🍼 {{ 'pet_cro.nav.kitten' | t | default: 'Gatitos' }}
                              </a>
                              <a href="{{ cat_url }}?{{ p_subfilter_key }}={{ val_adult }}" class="menu-drawer__subfilter-pill link focus-inset">
                                🐈 {{ 'pet_cro.nav.adult' | t | default: 'Adultos' }}
                              </a>
                              <a href="{{ cat_url }}?{{ p_subfilter_key }}={{ val_sensitive }}" class="menu-drawer__subfilter-pill link focus-inset">
                                🌾 {{ 'pet_cro.nav.sensitive' | t | default: 'Sensible' }}
                              </a>
                              <a href="{{ cat_url }}?{{ p_subfilter_key }}={{ val_sterilised }}" class="menu-drawer__subfilter-pill link focus-inset">
                                ✂️ {{ 'pet_cro.nav.sterilised' | t | default: 'Esterilizados' }}
                              </a>
                              <a href="{{ cat_url }}?{{ p_subfilter_key }}={{ val_hairball }}" class="menu-drawer__subfilter-pill link focus-inset">
                                🧶 {{ 'pet_cro.nav.hairball' | t | default: 'Bolas de Pelo' }}
                              </a>
                            </div>
                          </div>
                        </div>
                      </div>
                    </details>
                  </li>
                {%- else -%}
                <li>
                  {%- if link.links != blank -%}
                    <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                      <summary
                        id="HeaderDrawer-{{ link.handle }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                      >
                        <span>
                          {{- nav_display -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </summary>
                      <div
                        id="link-{{ link.handle | escape }}"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                        tabindex="-1"
                      >
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                            <span class="svg-wrapper">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                            {{ link.title | escape }}
                          </button>
                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            {%- for childlink in link.links -%}
                              <li>
                                {%- if childlink.links == blank -%}
                                  <a
                                    id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url }}"
                                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                    {% if childlink.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{ childlink.title | escape }}
                                  </a>
                                {%- else -%}
                                  <details id="Details-menu-drawer-{{ link.handle }}-{{ childlink.handle }}">
                                    <summary
                                      id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                      class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                                    >
                                      {{ childlink.title | escape }}
                                      <span class="svg-wrapper">
                                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                                      </span>
                                      <span class="svg-wrapper">
                                        {{- 'icon-caret.svg' | inline_asset_content -}}
                                      </span>
                                    </summary>
                                    <div
                                      id="childlink-{{ childlink.handle | escape }}"
                                      class="menu-drawer__submenu has-submenu gradient motion-reduce"
                                    >
                                      <button
                                        class="menu-drawer__close-button link link--text focus-inset"
                                        aria-expanded="true"
                                      >
                                        <span class="svg-wrapper">
                                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                                        </span>
                                        {{ childlink.title | escape }}
                                      </button>
                                      <ul
                                        class="menu-drawer__menu list-menu"
                                        role="list"
                                        tabindex="-1"
                                      >
                                        {%- for grandchildlink in childlink.links -%}
                                          <li>
                                            <a
                                              id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                              href="{{ grandchildlink.url }}"
                                              class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                              {% if grandchildlink.current %}
                                                aria-current="page"
                                              {% endif %}
                                            >
                                              {{ grandchildlink.title | escape }}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </details>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a
                      id="HeaderDrawer-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ nav_display }}
                    </a>
                  {%- endif -%}
                </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
          <div class="menu-drawer__utility-links">
            <div class="menu-drawer__contact-box">
              <a
                href="https://wa.me/34600000000"
                class="menu-drawer__whatsapp-btn link focus-inset"
                target="_blank"
                rel="noopener"
                aria-label="WhatsApp"
              >
                <span aria-hidden="true">💬</span>
                <span>
                  {{- 'pet_cro.nav.whatsapp_help' | t -}}
                </span>
              </a>
            </div>
            {%- if show_country_selector or show_language_selector -%}
              <div class="menu-drawer__localization header-localization">
                {%- if show_country_selector -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderCountryMobileLabel">
                          {{ 'localization.country_label' | t }}
                        </h2>
                        {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {% endif %}

                {%- if show_language_selector -%}
                  {%- render 'header-language-switcher' -%}
                {%- endif -%}
              </div>
            {%- endif -%}
            {% if show_social_links %}
              <ul class="list list-social list-unstyled" role="list">
                {%- if settings.social_twitter_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_twitter_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-twitter.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_facebook_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_facebook_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-facebook.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_pinterest_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_pinterest_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-pinterest.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_instagram_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_instagram_link }}" class="list-social__link link">
                      <span class="svg-wrapper">

{%- comment -%} Texts: locales pet_cro.booking.* (CODE-11). {%- endcomment -%}
      <div class="booking-step-panel" data-step-panel="3" hidden>
        <div class="step-panel-header">
          <h3 class="step-panel-title">
            {{ 'pet_cro.booking.step_3.title' | t }}
          </h3>
          <p class="step-panel-desc">
            {{ 'pet_cro.booking.step_3.intro' | t }}
          </p>
        </div>

        <div class="booking-form-sections">
          <!-- Datos del Perro -->
          <fieldset class="booking-fieldset">
            <legend class="booking-legend">{{ 'pet_cro.booking.step_3.dog_title' | t }}</legend>
            <div class="booking-form-grid">
              <div class="booking-form-field">
                <label for="booking-pet-name-{{ section.id }}" class="booking-field-label">{{ 'pet_cro.booking.step_3.dog_name' | t }}</label>
                <input type="text" id="booking-pet-name-{{ section.id }}" class="booking-form-input" data-booking-input="petName" placeholder="{{ 'pet_cro.booking.step_3.dog_name_placeholder' | t }}" required>
              </div>
              <div class="booking-form-field">
                <label for="booking-pet-breed-{{ section.id }}" class="booking-field-label">{{ 'pet_cro.booking.step_3.breed' | t }}</label>
                <input
                  type="text"
                  id="booking-pet-breed-{{ section.id }}"
                  class="booking-form-input"
                  data-booking-input="petBreed"
                  list="booking-breeds-list-{{ section.id }}"
                  placeholder="{{ 'pet_cro.booking.step_3.breed_placeholder' | t }}"
                  autocomplete="off"
                  required
                >
              </div>
              <div class="booking-form-field">
                <label for="booking-pet-age-{{ section.id }}" class="booking-field-label">{{ 'pet_cro.booking.step_3.age' | t }}</label>
                <input type="text" id="booking-pet-age-{{ section.id }}" class="booking-form-input" data-booking-input="petAge" placeholder="{{ 'pet_cro.booking.step_3.age_placeholder' | t }}">
              </div>
            </div>

            <!-- Necesidades Especiales Checkboxes -->
            <div class="booking-special-needs">
              <span class="booking-field-label">
                {{ 'pet_cro.booking.step_3.care_label' | t }}
              </span>
              <div class="booking-tags-grid">
                <label class="booking-tag-pill">
                  <input type="checkbox" name="special_needs" value="Piel sensible / Alergias" data-booking-tag>
                  <span>{{ 'pet_cro.booking.step_3.care_skin' | t }}</span>
                </label>
                <label class="booking-tag-pill">
                  <input type="checkbox" name="special_needs" value="Tiene nudos en el manto" data-booking-tag>
                  <span>{{ 'pet_cro.booking.step_3.care_matted' | t }}</span>
                </label>
                <label class="booking-tag-pill">
                  <input type="checkbox" name="special_needs" value="Inseguro / Miedo al secador" data-booking-tag>
                  <span>{{ 'pet_cro.booking.step_3.care_nervous' | t }}</span>
                </label>
                <label class="booking-tag-pill">
                  <input type="checkbox" name="special_needs" value="Primera vez en peluquería" data-booking-tag>
                  <span>{{ 'pet_cro.booking.step_3.care_first' | t }}</span>
                </label>
              </div>
            </div>
          </fieldset>

          <!-- Datos del Tutor -->
          <fieldset class="booking-fieldset">
            <legend class="booking-legend">{{ 'pet_cro.booking.step_3.owner_title' | t }}</legend>
            <div class="booking-form-grid">
              <div class="booking-form-field">
                <label for="booking-cust-name-{{ section.id }}" class="booking-field-label">{{ 'pet_cro.booking.step_3.owner_name' | t }}</label>
                <input type="text" id="booking-cust-name-{{ section.id }}" class="booking-form-input" data-booking-input="customerName" placeholder="{{ 'pet_cro.booking.step_3.owner_name_placeholder' | t }}" required>
              </div>
              <div class="booking-form-field">
                <label for="booking-cust-phone-{{ section.id }}" class="booking-field-label">{{ 'pet_cro.booking.step_3.phone' | t }}</label>
                <input type="tel" id="booking-cust-phone-{{ section.id }}" class="booking-form-input" data-booking-input="customerPhone" placeholder="{{ 'pet_cro.booking.step_3.phone_placeholder' | t }}" required>
              </div>
              <div class="booking-form-field">
                <label for="booking-cust-email-{{ section.id }}" class="booking-field-label">{{ 'pet_cro.booking.step_3.email' | t }}</label>
                <input type="email" id="booking-cust-email-{{ section.id }}" class="booking-form-input" data-booking-input="customerEmail" placeholder="{{ 'pet_cro.booking.step_3.email_placeholder' | t }}" aria-describedby="booking-email-hint-{{ section.id }} booking-rebook-hint-{{ section.id }}">
                <p id="booking-email-hint-{{ section.id }}" class="booking-field-hint">{{ 'pet_cro.booking.step_3.email_discount' | t }}</p>
                {%- comment -%} Shown by grooming-booking.js only when the "time for the next visit" email is on in the booking app (LSSI art. 21.2: tell it when collecting the email). {%- endcomment -%}
                <p id="booking-rebook-hint-{{ section.id }}" class="booking-field-hint" data-booking-rebook-note hidden>{{ 'pet_cro.booking.step_3.email_reminder' | t }}</p>
              </div>
              <div class="booking-hp-field" aria-hidden="true">
                <label for="booking-website-{{ section.id }}">Web</label>
                <input type="text" id="booking-website-{{ section.id }}" data-booking-input="website" tabindex="-1" autocomplete="off">
              </div>
            </div>
            <div class="booking-form-field" style="margin-top: 1.6rem;">
              <label for="booking-notes-{{ section.id }}" class="booking-field-label">{{ 'pet_cro.booking.step_3.notes' | t }}</label>
              <textarea id="booking-notes-{{ section.id }}" class="booking-form-textarea" data-booking-input="notes" rows="2" placeholder="{{ 'pet_cro.booking.step_3.notes_placeholder' | t }}"></textarea>
            </div>
          </fieldset>

          <!-- Protección de Datos (RGPD / LOPD-GDD) -->
          <div class="booking-privacy-card">
            <label class="booking-privacy-checkbox-label" for="booking-privacy-{{ section.id }}">
              <input
                type="checkbox"
                id="booking-privacy-{{ section.id }}"
                class="booking-privacy-checkbox"
                data-booking-input="privacyConsent"
                required
              >
              <span class="booking-privacy-text-wrap">
                <span>{{ 'pet_cro.booking.step_3.privacy_before' | t }} </span>
                <a
                  href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="booking-privacy-link"
                >{{ 'pet_cro.booking.step_3.privacy_link' | t }}</a>
                <span> {{ 'pet_cro.booking.step_3.privacy_after' | t }}</span>
              </span>
            </label>

            <!-- Optional and unticked: only people who tick it are subscribed to marketing emails -->
            <label class="booking-privacy-checkbox-label booking-marketing-label" for="booking-marketing-{{ section.id }}">
              <input
                type="checkbox"
                id="booking-marketing-{{ section.id }}"
                class="booking-privacy-checkbox"
                data-booking-input="marketingOptIn"
              >
              <span class="booking-privacy-text-wrap">
                <span>{{ 'pet_cro.booking.step_3.marketing' | t }}</span>
              </span>
            </label>

            <!-- Información básica por capas (AEPD) -->
            <details class="booking-rgpd-accordion">
              <summary class="booking-rgpd-summary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                <span>{{ 'pet_cro.booking.step_3.gdpr_title' | t }}</span>
              </summary>
              <div class="booking-rgpd-content">
                <dl class="booking-rgpd-dl">
                  <div class="booking-rgpd-row">
                    <dt>{{ 'pet_cro.booking.step_3.gdpr_controller' | t }}</dt>
                    <dd>{{ shop.name }}</dd>
                  </div>
                  <div class="booking-rgpd-row">
                    <dt>{{ 'pet_cro.booking.step_3.gdpr_purpose' | t }}</dt>
                    <dd>{{ 'pet_cro.booking.step_3.gdpr_purpose_text' | t }}</dd>
                  </div>
                  <div class="booking-rgpd-row">
                    <dt>{{ 'pet_cro.booking.step_3.gdpr_basis' | t }}</dt>
                    <dd>{{ 'pet_cro.booking.step_3.gdpr_basis_text' | t }}</dd>
                  </div>
                  <div class="booking-rgpd-row">
                    <dt>{{ 'pet_cro.booking.step_3.gdpr_recipients' | t }}</dt>
                    <dd>{{ 'pet_cro.booking.step_3.gdpr_recipients_text' | t }}</dd>
                  </div>
                  <div class="booking-rgpd-row">
                    <dt>{{ 'pet_cro.booking.step_3.gdpr_rights' | t }}</dt>
                    <dd>{{ 'pet_cro.booking.step_3.gdpr_rights_text' | t }}</dd>
                  </div>
                </dl>
              </div>
            </details>

            <div class="booking-privacy-error" data-booking-privacy-error hidden>
              ⚠️ <span>{{ 'pet_cro.booking.step_3.privacy_error' | t }}</span>
            </div>
          </div>
        </div>

        <div class="booking-panel-nav">
          <button type="button" class="grooming-booking-btn-secondary" data-wizard-action="prev">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            <span>{{ 'pet_cro.booking.step_3.back' | t }}</span>
          </button>
          <button type="button" class="grooming-booking-btn-primary" data-wizard-action="next">
            <span>{{ 'pet_cro.booking.step_3.continue' | t }}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

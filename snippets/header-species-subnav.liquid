{% comment %}
  Header Species Subnav Item (snippets/header-species-subnav.liquid)
  Renders a dropdown item for Dogs or Cats with links to the Perros / Gatos collections filtered
  by product type (Search & Discovery filter "filter.p.product_type"), like the catalog bar and the
  mobile menu. A "Packs" link is added when the Packs collection has packs for that pet.
  Accepts:
  - species: 'dog' or 'cat'
  - section: {Object} Section Liquid object
  - id_prefix: {String} Unique prefix for IDs
{% endcomment %}

{%- liquid
  assign is_dog = false
  if species == 'dog'
    assign is_dog = true
  endif

  assign prefix = id_prefix | default: 'header-species'
  assign p_cat_key = 'filter.p.product_type'

  capture pet_taxonomy
    render 'pet-taxonomy'
  endcapture
  assign dogs_handle = pet_taxonomy | split: ';collection_dogs=' | last | split: ';' | first
  assign cats_handle = pet_taxonomy | split: ';collection_cats=' | last | split: ';' | first
  if is_dog
    assign species_url = routes.collections_url | append: '/' | append: dogs_handle
    assign species_tag = pet_taxonomy | split: ';tag_dog=' | last | split: ';' | first
    # product type key (pet-taxonomy) | icon | translation key | fallback label
    assign items = 'type_kibble|🥩|pet_cro.nav.kibble|Pienso Seco;type_wet|🥫|pet_cro.nav.wet_food|Comida Húmeda;type_barf|🍖|pet_cro.nav.barf|Dieta BARF;type_snacks|🦴|pet_cro.nav.snacks|Snacks & Premios;type_toys|🎾|pet_cro.nav.toys|Juguetes;type_grooming|🧴|pet_cro.nav.grooming|Higiene & Cuidados;type_accessories|🦮|pet_cro.nav.walk|Paseo & Accesorios' | split: ';'
  else
    assign species_url = routes.collections_url | append: '/' | append: cats_handle
    assign species_tag = pet_taxonomy | split: ';tag_cat=' | last | split: ';' | first
    assign items = 'type_kibble|🥩|pet_cro.nav.kibble|Pienso Seco;type_wet|🥫|pet_cro.nav.wet_food|Comida Húmeda;type_snacks|🦴|pet_cro.nav.snacks|Snacks & Premios;type_toys|🎾|pet_cro.nav.toys|Juguetes & Rascadores;type_grooming|🧴|pet_cro.nav.grooming|Higiene & Arena' | split: ';'
  endif

  assign packs_collection = collections['packs']
  assign show_packs = false
  if packs_collection.products_count > 0 and packs_collection.all_tags contains species_tag
    assign show_packs = true
  endif
-%}

<li>
  <header-menu>
    <details id="Details-{{ prefix }}-{{ species }}">
      <summary
        id="HeaderMenu-{{ prefix }}-{{ species }}"
        class="header__menu-item list-menu__item link focus-inset"
      >
        <span>
          {%- if is_dog -%}
            🐶 {{ 'pet_cro.nav.dogs' | t | default: 'Perros' }}
          {%- else -%}
            🐱 {{ 'pet_cro.nav.cats' | t | default: 'Gatos' }}
          {%- endif -%}
        </span>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>

      <ul
        id="HeaderMenu-MenuList-{{ prefix }}-{{ species }}"
        class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup header__submenu--species"
        role="list"
        tabindex="-1"
      >
        {%- for item in items -%}
          {%- assign parts = item | split: '|' -%}
          {%- assign type_needle = ';' | append: parts[0] | append: '=' -%}
          {%- assign type_value = pet_taxonomy | split: type_needle | last | split: ';' | first -%}
          <li>
            <a
              href="{{ species_url }}?{{ p_cat_key }}={{ type_value | url_encode }}"
              class="header__menu-item list-menu__item link link--text focus-inset caption-large header__species-link"
            >
              <span class="header__species-icon" aria-hidden="true">{{ parts[1] }}</span>
              <span class="header__species-title">{{ parts[2] | t | default: parts[3] }}</span>
              <span class="header__species-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        {%- endfor -%}
        {%- if show_packs -%}
          <li>
            <a
              href="{{ packs_collection.url }}?filter.p.tag={{ species_tag }}"
              class="header__menu-item list-menu__item link link--text focus-inset caption-large header__species-link"
            >
              <span class="header__species-icon" aria-hidden="true">📦</span>
              <span class="header__species-title">{{ 'pet_cro.nav.packs' | t }}</span>
              <span class="header__species-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        {%- endif -%}
        <li class="header__submenu-divider">
          <a
            href="{{ species_url }}"
            class="header__menu-item list-menu__item link link--text focus-inset caption-large header__submenu-item--highlight"
          >
            <span class="header__species-icon" aria-hidden="true">🐾</span>
            <span class="header__species-title">
              <strong>
                {%- if is_dog -%}
                  {{ 'pet_cro.nav.view_all_dogs' | t | default: 'Ver todo para Perros' }}
                {%- else -%}
                  {{ 'pet_cro.nav.view_all_cats' | t | default: 'Ver todo para Gatos' }}
                {%- endif -%}
              </strong>
            </span>
            <span class="header__species-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </details>
  </header-menu>
</li>

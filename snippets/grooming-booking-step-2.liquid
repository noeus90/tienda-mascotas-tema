{%- comment -%} Texts: locales pet_cro.booking.* (CODE-11). {%- endcomment -%}
      <div class="booking-step-panel" data-step-panel="2" hidden>
        <div class="step-panel-header">
          <h3 class="step-panel-title">
            {{ 'pet_cro.booking.step_2.title' | t }}
          </h3>
          <p class="step-panel-desc">
            {{ 'pet_cro.booking.step_2.intro' | t }}
          </p>
        </div>

        <div class="booking-submit-status is-error" role="alert" data-booking-slot-taken hidden></div>

        <!-- Several groomers (from the booking app): who the client wants; filled by grooming-booking.js -->
        <div class="booking-groomers" data-booking-groomers hidden>
          <p class="booking-my-dogs-title">{{ 'pet_cro.booking.step_2.groomers_title' | t }}</p>
          <div class="booking-my-dogs-list" data-booking-groomers-list role="radiogroup"></div>
          <p class="booking-field-hint" data-booking-groomers-hint hidden></p>
          <label class="booking-privacy-checkbox-label booking-fav-label" data-booking-fav-wrap hidden>
            <input type="checkbox" class="booking-privacy-checkbox" data-booking-fav>
            <span data-booking-fav-text></span>
          </label>
        </div>

        <div class="booking-datetime-grid">
          <!-- Direct 30-Day Visual Calendar -->
          <div class="booking-calendar-widget" data-booking-calendar-widget>
            <div class="booking-calendar-header">
              <span
                class="booking-calendar-badge"
              >
                {{ 'pet_cro.booking.step_2.calendar_badge' | t }}
              </span>
              <div class="booking-calendar-nav">
                <button
                  type="button"
                  class="booking-cal-nav-btn"
                  data-cal-nav="prev"
                  aria-label="{{ 'pet_cro.booking.step_2.prev_month' | t }}"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                <h4 class="booking-cal-month-label" data-cal-month-label aria-live="polite">
                  <!-- Filled by JS -->
                </h4>
                <button
                  type="button"
                  class="booking-cal-nav-btn"
                  data-cal-nav="next"
                  aria-label="{{ 'pet_cro.booking.step_2.next_month' | t }}"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
              </div>
            </div>

            <!-- Weekday Headers -->
            <div class="booking-cal-weekdays" aria-hidden="true">
              <span>{{ 'pet_cro.booking.step_2.mon' | t }}</span>
              <span>{{ 'pet_cro.booking.step_2.tue' | t }}</span>
              <span>{{ 'pet_cro.booking.step_2.wed' | t }}</span>
              <span>{{ 'pet_cro.booking.step_2.thu' | t }}</span>
              <span>{{ 'pet_cro.booking.step_2.fri' | t }}</span>
              <span>{{ 'pet_cro.booking.step_2.sat' | t }}</span>
              <span>{{ 'pet_cro.booking.step_2.sun' | t }}</span>
            </div>

            <!-- Days Grid (filled dynamically by grooming-booking.js) -->
            <div class="booking-cal-days-grid" data-cal-days-grid role="grid">
              <!-- Rendered by grooming-booking.js -->
            </div>

            <div class="booking-cal-selected-notice">
              <span class="cal-notice-icon">📅</span>
              <span class="cal-notice-text">
                <span>{{ 'pet_cro.booking.step_2.selected_label' | t }}</span>
                <strong data-cal-selected-display>{{ 'pet_cro.booking.step_2.select_day' | t }}</strong>
              </span>
            </div>

            <div class="booking-cal-legend">
              <span class="cal-legend-pill is-open">{{ 'pet_cro.booking.step_2.legend_available' | t }}</span>
              <span class="cal-legend-pill is-closed">{{ 'pet_cro.booking.step_2.legend_closed_sundays' | t }}</span>
            </div>
          </div>

          <!-- Shifts & Hours Selector -->
          <div class="booking-shift-picker-wrap">
            <span class="booking-field-label">
              {{ 'pet_cro.booking.step_2.slots_label' | t }}
            </span>
            <div class="booking-shifts-container">
              <div class="shift-group" data-shift-group="morning">
                <span class="shift-group-title">{{ 'pet_cro.booking.step_2.morning_shift' | t }}</span>
                <div class="shift-slots-grid" data-slots-grid="morning">
                  {%- for slot in morning_slots_arr -%}
                    {%- assign s_time = slot | strip -%}
                    {%- if s_time != blank -%}
                      <label class="booking-slot-card{% if forloop.first %} is-selected{% endif %}">
                        <input type="radio" name="grooming_slot" value="{{ s_time }}" {% if forloop.first %}checked{% endif %} class="visually-hidden">
                        <span class="slot-time">{{ s_time }}</span>
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>

              <div class="shift-group" data-shift-group="afternoon">
                <span class="shift-group-title">{{ 'pet_cro.booking.step_2.afternoon_shift' | t }}</span>
                <div class="shift-slots-grid" data-slots-grid="afternoon">
                  {%- for slot in afternoon_slots_arr -%}
                    {%- assign s_time = slot | strip -%}
                    {%- if s_time != blank -%}
                      <label class="booking-slot-card">
                        <input type="radio" name="grooming_slot" value="{{ s_time }}" class="visually-hidden">
                        <span class="slot-time">{{ s_time }}</span>
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>

            <div class="booking-shift-special-notice" data-shift-saturday-notice hidden>
              <span class="notice-icon">☀️</span>
              <span
                class="notice-text"
              >
                {{ 'pet_cro.booking.step_2.saturday_note' | t }}
              </span>
            </div>

            <div class="booking-shift-fully-booked-notice" data-shift-fully-booked-notice hidden>
              <span class="notice-icon">⚠️</span>
              <span
                class="notice-text"
              >
                {{ 'pet_cro.booking.step_2.full_day' | t }}
              </span>
            </div>

            {%- comment -%} Waiting list of a full day: sent to the booking app (/apps/reservas/lista-espera) by grooming-booking.js. {%- endcomment -%}
            <div class="booking-waitlist" data-booking-waitlist hidden>
              <p class="booking-waitlist__title">🔔 {{ 'pet_cro.booking.step_2.waitlist_title' | t }}</p>
              <div data-waitlist-form>
                <div class="booking-waitlist__grid">
                  <label class="booking-waitlist__field">
                    <span>{{ 'pet_cro.booking.step_2.waitlist_time' | t }}</span>
                    <select data-waitlist="shift">
                      <option value="any">{{ 'pet_cro.booking.step_2.waitlist_any' | t }}</option>
                      <option value="morning">{{ 'pet_cro.booking.step_2.waitlist_morning' | t }}</option>
                      <option value="afternoon">{{ 'pet_cro.booking.step_2.waitlist_afternoon' | t }}</option>
                    </select>
                  </label>
                  <label class="booking-waitlist__field">
                    <span>{{ 'pet_cro.booking.step_2.waitlist_name' | t }}</span>
                    <input type="text" data-waitlist="name" autocomplete="name" maxlength="100">
                  </label>
                  <label class="booking-waitlist__field">
                    <span>Email</span>
                    <input type="email" data-waitlist="email" autocomplete="email" maxlength="254">
                  </label>
                  <label class="booking-waitlist__field">
                    <span>{{ 'pet_cro.booking.step_2.waitlist_phone' | t }}</span>
                    <input type="tel" data-waitlist="phone" autocomplete="tel" maxlength="25">
                  </label>
                </div>
                <input type="text" data-waitlist="website" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
                <button type="button" class="grooming-booking-btn-secondary booking-waitlist__button" data-waitlist-submit>
                  {{ 'pet_cro.booking.step_2.waitlist_submit' | t }}
                </button>
                <p class="booking-field-hint">{{ 'pet_cro.booking.step_2.waitlist_note' | t }}</p>
              </div>
              <p class="booking-waitlist__status" data-waitlist-status role="status" aria-live="polite" hidden></p>
            </div>

            <div class="booking-shift-info-box">
              <span class="shift-info-icon">💡</span>
              <p
                class="shift-info-text"
              >
                {{ 'pet_cro.booking.step_2.slot_note' | t }}
              </p>
            </div>
          </div>
        </div>

        <div class="booking-panel-nav">
          <button type="button" class="grooming-booking-btn-secondary" data-wizard-action="prev">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            <span>{{ 'pet_cro.booking.step_2.back' | t }}</span>
          </button>
          <button type="button" class="grooming-booking-btn-primary" data-wizard-action="next">
            <span>{{ 'pet_cro.booking.step_2.continue' | t }}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

{%- comment -%} Texts: locales pet_cro.booking.* (CODE-11). {%- endcomment -%}
    <!-- Booking Stepper Progress Indicator -->
    <nav class="grooming-booking-stepper" aria-label="{{ 'pet_cro.booking.stepper.nav_label' | t }}">

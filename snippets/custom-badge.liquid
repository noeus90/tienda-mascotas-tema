{%- doc -%}
  Customizable Pill Badge for Pet Store promotions and statuses.

  @param {string} [text] - Badge label text (defaults to localized "New").
  @param {string} [bg_color] - Hex or RGB background color (default: '#e2e8f0').
  @param {string} [text_color] - Hex or RGB text color (default: '#0f172a').
  @param {string} [extra_class] - Optional additional CSS classes.

  @example
  {% render 'custom-badge', text: 'Sold Out', bg_color: '#fee2e2', text_color: '#991b1b' %}
{%- enddoc -%}

{%- liquid
  assign default_new = 'pet_cro.badge.new' | t
  assign badge_text = text | default: default_new
  assign badge_bg = bg_color | default: '#e2e8f0'
  assign badge_fg = text_color | default: '#0f172a'
  assign badge_class = extra_class

  case badge_text
    when 'Nuevo', 'New'
      assign badge_text = 'pet_cro.badge.new' | t
    when 'Envío Gratis', 'Free Shipping'
      assign badge_text = 'pet_cro.badge.free_shipping' | t
    when 'Exclusivo', 'Exclusive'
      assign badge_text = 'pet_cro.badge.exclusive' | t
    when 'Agotado', 'Sold Out'
      assign badge_text = 'pet_cro.badge.sold_out' | t
  endcase
-%}

<span
  class="custom-badge {{ badge_class }}"
  style="--badge-bg: {{ badge_bg }}; --badge-fg: {{ badge_fg }};"
>
  {{ badge_text }}
</span>

{%- comment -%} Texts follow the page language (/en/ English, otherwise Spanish). {%- endcomment -%}
{%- assign booking_en = false -%}{%- if request.locale.iso_code == 'en' -%}{%- assign booking_en = true -%}{%- endif -%}
      <div class="booking-step-panel is-active" data-step-panel="1">
        <div class="step-panel-header">
          <h3 class="step-panel-title">
            {% if booking_en %}1. Select the main grooming service{% else %}1. Selecciona el servicio principal{% endif %}
          </h3>
          <p class="step-panel-desc">
            {% if booking_en %}Choose one; the optional extras are at the end of this step.{% else %}Elige uno; los extras opcionales están al final de este paso.{% endif %}
          </p>
        </div>

        <!-- Logged-in customers: their dogs from the booking app (/apps/reservas/mis-perros), filled by grooming-booking.js -->
        <div class="booking-my-dogs" data-booking-my-dogs hidden>
          <p class="booking-my-dogs-title">{% if booking_en %}🐾 Which of your dogs is this appointment for?{% else %}🐾 ¿Para cuál de tus perros es la cita?{% endif %}</p>
          <div class="booking-my-dogs-list" data-booking-my-dogs-list role="group"></div>
          <p class="booking-field-hint">{% if booking_en %}We fill in its size, breed and care needs with what we already know; you can change them.{% else %}Rellenamos su tamaño, raza y cuidados con lo que ya sabemos; puedes cambiarlos.{% endif %}</p>
        </div>

        <div class="booking-services-grid" role="radiogroup" aria-label="{% if booking_en %}Grooming services{% else %}Servicios de peluquería{% endif %}">
          {%- if has_custom_services -%}
            {%- for service in meta_services -%}
              {%- assign is_active = true -%}
              {%- if service.active.value == false or service.active == false -%}{%- assign is_active = false -%}{%- endif -%}
              {%- if is_active -%}
                {%- assign s_id = service.system.handle | default: service.id | default: forloop.index -%}
                {%- assign s_name = service.name.value | default: service.name -%}
                {%- liquid
                  # One icon per service (UX-24): the metaobject's "icon" field if it has one, otherwise by name.
                  assign s_name_check = service.name.value | default: service.name | downcase
                  assign s_icon_default = '🐾'
                  if s_name_check contains 'baño' or s_name_check contains 'bath'
                    assign s_icon_default = '🛁'
                  elsif s_name_check contains 'tijera' or s_name_check contains 'scissor' or s_name_check contains 'haircut'
                    assign s_icon_default = '✂️'
                  elsif s_name_check contains 'deslanado' or s_name_check contains 'deshedding'
                    assign s_icon_default = '🪮'
                  elsif s_name_check contains 'stripping'
                    assign s_icon_default = '🖐️'
                  endif
                  assign s_icon = service.icon.value | default: service.icon | default: s_icon_default
                -%}
                {%- assign s_desc = service.description.value | default: service.description -%}
                {%- if booking_en -%}{%- assign s_dur_default = '1 hour' -%}{%- else -%}{%- assign s_dur_default = '1 hora' -%}{%- endif -%}
                {%- assign s_dur = service.duration.value | default: service.duration | default: s_dur_default -%}
                {%- assign s_mini = service.price_mini.value | default: service.price_mini | default: 28 -%}
                {%- assign s_med = service.price_medium.value | default: service.price_medium | default: 34 -%}
                {%- assign s_lar = service.price_large.value | default: service.price_large | default: 42 -%}

                <label class="booking-service-card">
                  <input type="radio" name="grooming_service" value="{{ s_id }}" class="visually-hidden">
                  <span class="service-card-check" aria-hidden="true"></span>
                  <div class="service-card-icon">{{ s_icon }}</div>
                  <div class="service-card-content">
                    <h4 class="service-card-name">{{ s_name }}</h4>
                    {%- if s_desc != blank -%}
                      <p class="service-card-desc">{{ s_desc }}</p>
                    {%- endif -%}
                    <div class="service-card-meta">
                      {%- comment -%} Durations saved as minutes ("60") read as "1 hora" / "45 min". {%- endcomment -%}
                      {%- assign s_dur_text = s_dur | append: '' | strip -%}
                      {%- assign s_dur_num = s_dur_text | plus: 0 -%}
                      {%- assign s_dur_back = s_dur_num | append: '' -%}
                      {%- if s_dur_num > 0 and s_dur_back == s_dur_text -%}
                        {%- if s_dur_num == 60 -%}{%- if booking_en -%}{%- assign s_dur = '1 hour' -%}{%- else -%}{%- assign s_dur = '1 hora' -%}{%- endif -%}{%- else -%}{%- assign s_dur = s_dur_num | append: ' min' -%}{%- endif -%}
                      {%- endif -%}
                      <span class="service-duration">⏱️ {{ s_dur }}</span>
                      <span class="service-base-price" data-price-mini="{{ s_mini }}" data-price-medium="{{ s_med }}" data-price-large="{{ s_lar }}">
                        {% if booking_en %}From{% else %}Desde{% endif %} {{ s_mini }} €
                      </span>
                    </div>
                  </div>
                </label>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <!-- Servicio 1: Baño Dermoprotector -->
            <label class="booking-service-card">
              <input type="radio" name="grooming_service" value="bath_hygiene" class="visually-hidden">
              <span class="service-card-check" aria-hidden="true"></span>
              <div class="service-card-icon">🛁</div>
              <div class="service-card-content">
                <h4 class="service-card-name">
                  {% if booking_en %}Dermoprotective Bath & Ears{% else %}Baño Dermoprotector & Oídos{% endif %}
                </h4>
                <p class="service-card-desc">
                  {% if booking_en %}Natural oatmeal & aloe shampoo, deep hydration, ear cleaning, and nail trim.{% else %}Champú natural de avena y aloe, hidratación profunda, limpieza de oídos y corte de uñas.{% endif %}
                </p>
                <div class="service-card-meta">
                  <span class="service-duration">{% if booking_en %}⏱️ 1 hour{% else %}⏱️ 1 hora{% endif %}</span>
                  <span class="service-base-price" data-price-mini="28" data-price-medium="34" data-price-large="42">{% if booking_en %}From{% else %}Desde{% endif %} 28 €</span>
                </div>
              </div>
            </label>

            <!-- Servicio 2: Corte a Tijera -->
            <label class="booking-service-card">
              <input type="radio" name="grooming_service" value="scissor_cut" class="visually-hidden">
              <span class="service-card-check" aria-hidden="true"></span>
              <div class="service-card-icon">✂️</div>
              <div class="service-card-content">
                <h4 class="service-card-name">
                  {% if booking_en %}Breed Scissor Cut & Styling{% else %}Corte a Tijera de Raza & Peinado{% endif %}
                </h4>
                <p class="service-card-desc">
                  {% if booking_en %}Breed standard scissor styling, nourishing bath, blow-out, and detailing.{% else %}Corte estilizado a tijera respetando el estándar de la raza, baño nutritivo, peinado y retoque.{% endif %}
                </p>
                <div class="service-card-meta">
                  <span class="service-duration">{% if booking_en %}⏱️ 1 hour{% else %}⏱️ 1 hora{% endif %}</span>
                  <span class="service-base-price" data-price-mini="38" data-price-medium="46" data-price-large="58">{% if booking_en %}From{% else %}Desde{% endif %} 38 €</span>
                </div>
              </div>
            </label>

            <!-- Servicio 3: Deslanado Completo -->
            <label class="booking-service-card">
              <input type="radio" name="grooming_service" value="deshedding" class="visually-hidden">
              <span class="service-card-check" aria-hidden="true"></span>
              <div class="service-card-icon">🐕</div>
              <div class="service-card-content">
                <h4 class="service-card-name">
                  {% if booking_en %}Full Deshedding & Bath{% else %}Deslanado Completo & Baño{% endif %}
                </h4>
                <p class="service-card-desc">
                  {% if booking_en %}Removes up to 90% undercoat dead fur. Perfect for Golden, Husky, German Shepherd, or mixes.{% else %}Elimina hasta el 90% de pelo muerto de subpelo. Ideal para Golden, Husky, Pastor Alemán o mestizos.{% endif %}
                </p>
                <div class="service-card-meta">
                  <span class="service-duration">{% if booking_en %}⏱️ 1 hour{% else %}⏱️ 1 hora{% endif %}</span>
                  <span class="service-base-price" data-price-mini="35" data-price-medium="42" data-price-large="52">{% if booking_en %}From{% else %}Desde{% endif %} 35 €</span>
                </div>
              </div>
            </label>

            <!-- Servicio 4: Spa Ozono -->
            <label class="booking-service-card">
              <input type="radio" name="grooming_service" value="spa_ozone" class="visually-hidden">
              <span class="service-card-check" aria-hidden="true"></span>
              <div class="service-card-icon">🫧</div>
              <div class="service-card-content">
                <h4 class="service-card-name">
                  {% if booking_en %}Ozone Spa Therapy & Mask{% else %}Spa Ozonoterapia & Mascarilla{% endif %}
                </h4>
                <p class="service-card-desc">
                  {% if booking_en %}Hydromassage therapy with ozone microbubbles. Relieves dermatitis, itching, and heals skin.{% else %}Terapia de hidromasaje con microburbujas de ozono. Alivia dermatitis, picores y regenera la piel.{% endif %}
                </p>
                <div class="service-card-meta">
                  <span class="service-duration">{% if booking_en %}⏱️ 1 hour{% else %}⏱️ 1 hora{% endif %}</span>
                  <span class="service-base-price" data-price-mini="42" data-price-medium="50" data-price-large="62">{% if booking_en %}From{% else %}Desde{% endif %} 42 €</span>
                </div>
              </div>
            </label>
          {%- endif -%}
        </div>

        <!-- Selector de Tamaño / Peso & Buscador de Raza -->
        <div class="booking-size-section">
          <div class="booking-breed-header">
            <div>
              <h4 class="step-section-subtitle">
                {% if booking_en %}Approximate dog size & weight{% else %}Tamaño y peso aproximado de tu perro{% endif %}
              </h4>
              <p class="booking-breed-help">
                {% if booking_en %}Choose size by weight or search breed to auto-suggest it.{% else %}Elige el tamaño por peso o busca su raza para sugerirlo automáticamente.{% endif %}
              </p>
            </div>
          </div>

          <!-- Buscador Predictivo de Raza / Mestizo -->
          <div class="booking-breed-search-box">
            <label for="booking-quick-breed-{{ section.id }}" class="booking-breed-search-label">
              {% if booking_en %}What breed is your dog? (Optional){% else %}¿De qué raza es tu peludo? (Opcional){% endif %}
            </label>
            <div class="booking-breed-input-wrap">
              <input
                type="text"
                id="booking-quick-breed-{{ section.id }}"
                class="booking-form-input booking-breed-quick-input"
                data-booking-input="quickBreed"
                list="booking-breeds-list-{{ section.id }}"
                placeholder="{% if booking_en %}E.g. Mixed breed, Yorkshire, Beagle, Golden...{% else %}Ej: Mestizo, Yorkshire, Beagle, Golden...{% endif %}"
                autocomplete="off"
              >
              <button
                type="button"
                class="booking-breed-clear-btn"
                data-breed-action="clear"
                aria-label="{% if booking_en %}Clear breed{% else %}Borrar raza{% endif %}"
                hidden
              >
                &times;
              </button>
            </div>

            <!-- Datalist accesible nativo con Mestizos y Razas -->
            <datalist id="booking-breeds-list-{{ section.id }}" data-breeds-datalist>
              <option value="Mestizo / Sin raza"></option>
              <option value="Cruce / Mezcla"></option>
              <option value="Chihuahua"></option>
              <option value="Yorkshire Terrier"></option>
              <option value="Bichón Maltés"></option>
              <option value="Caniche Toy / Enano"></option>
              <option value="Pomerania (Lulú)"></option>
              <option value="Teckel Miniatura (Dachshund)"></option>
              <option value="Pinscher Miniatura"></option>
              <option value="Shih Tzu"></option>
              <option value="Bichón Frisé"></option>
              <option value="Papillón"></option>
              <option value="Pekinés"></option>
              <option value="Bichón Habanero"></option>
              <option value="Beagle"></option>
              <option value="Bulldog Francés"></option>
              <option value="Cocker Spaniel"></option>
              <option value="Border Collie"></option>
              <option value="Schnauzer Miniatura / Mediano"></option>
              <option value="Bodeguero Andaluz"></option>
              <option value="Carlino (Pug)"></option>
              <option value="Jack Russell Terrier"></option>
              <option value="West Highland White Terrier (Westie)"></option>
              <option value="Bulldog Inglés"></option>
              <option value="Bull Terrier"></option>
              <option value="Caniche Mediano"></option>
              <option value="Basset Hound"></option>
              <option value="Shiba Inu"></option>
              <option value="Corgi (Pembroke / Cardigan)"></option>
              <option value="Perro de Agua Español"></option>
              <option value="Podenco (Pequeño / Mediano)"></option>
              <option value="Whippet"></option>
              <option value="Boston Terrier"></option>
              <option value="Staffordshire Bull Terrier"></option>
              <option value="Labrador Retriever"></option>
              <option value="Golden Retriever"></option>
              <option value="Pastor Alemán"></option>
              <option value="Pastor Belga (Malinois)"></option>
              <option value="Pastor Australiano (Aussie)"></option>
              <option value="Boxer"></option>
              <option value="Husky Siberiano"></option>
              <option value="Dóberman"></option>
              <option value="Rottweiler"></option>
              <option value="Boyero de Berna"></option>
              <option value="Galgo Español / Lebrel"></option>
              <option value="Mastín Español / Pirineo"></option>
              <option value="Gran Danés (Dogo Alemán)"></option>
              <option value="San Bernardo"></option>
              <option value="Terranova"></option>
              <option value="Samoyedo"></option>
              <option value="Weimaraner (Braco de Weimar)"></option>
              <option value="Dálmata"></option>
              <option value="Akita Inu"></option>
              <option value="Cane Corso"></option>
              <option value="Setter Irlandés / Inglés"></option>
            </datalist>

            <!-- Feedback Contextual Inteligente -->
            <div class="booking-breed-feedback" data-breed-feedback hidden aria-live="polite">
              <span class="breed-feedback-text" data-breed-feedback-text></span>
            </div>
          </div>

          <div class="booking-size-grid" role="radiogroup" aria-label="{% if booking_en %}Dog size{% else %}Tamaño del perro{% endif %}">
            <label class="booking-size-card">
              <input type="radio" name="dog_size" value="mini" class="visually-hidden">
              <span class="size-badge">Mini / Toy</span>
              <strong class="size-name">{% if booking_en %}Under 5 kg{% else %}Menos de 5 kg{% endif %}</strong>
              <small class="size-hint">{% if booking_en %}Chihuahua, Bichon, Yorkshire, Toy Poodle{% else %}Chihuahua, Bichón, Yorkshire, Caniche Toy{% endif %}</small>
            </label>
            <label class="booking-size-card">
              <input type="radio" name="dog_size" value="medium" class="visually-hidden">
              <span class="size-badge">{% if booking_en %}Medium{% else %}Mediano{% endif %}</span>
              <strong class="size-name">{% if booking_en %}5 to 15 kg{% else %}5 a 15 kg{% endif %}</strong>
              <small class="size-hint">{% if booking_en %}Cocker, Beagle, French Bulldog, Schnauzer{% else %}Cocker, Beagle, Bulldog Francés, Schnauzer{% endif %}</small>
            </label>
            <label class="booking-size-card">
              <input type="radio" name="dog_size" value="large" class="visually-hidden">
              <span class="size-badge">{% if booking_en %}Large{% else %}Grande{% endif %}</span>
              <strong class="size-name">{% if booking_en %}Over 15 kg{% else %}Más de 15 kg{% endif %}</strong>
              <small class="size-hint">{% if booking_en %}Golden Retriever, Labrador, German Shepherd{% else %}Golden Retriever, Labrador, Pastor Alemán{% endif %}</small>
            </label>
          </div>
        </div>

        <!-- Selector de Cuidados Extra / Add-ons -->
        <div class="booking-addons-section">
          <div class="booking-addons-header">
            <div>
              <h4 class="step-section-subtitle">
                {% if booking_en %}✨ Pamper your dog with extra care (optional){% else %}✨ Mima a tu peludo con cuidados extra (opcional){% endif %}
              </h4>
              <p class="booking-addons-subtitle">
                {% if booking_en %}Add exclusive treatments in 1 click for a complete spa experience.{% else %}Añade tratamientos exclusivos en 1 clic para una experiencia spa completa.{% endif %}
              </p>
            </div>
            <span class="booking-addons-pill-badge">{% if booking_en %}In 1 click{% else %}En 1 clic{% endif %}</span>
          </div>

          <div class="booking-addons-grid" role="group" aria-label="{% if booking_en %}Extra care{% else %}Cuidados extra{% endif %}">
            {%- if has_custom_addons -%}
              {%- for addon in meta_addons -%}
                {%- assign is_active = true -%}
                {%- if addon.active.value == false or addon.active == false -%}{%- assign is_active = false -%}{%- endif -%}
                {%- if is_active -%}
                  {%- assign a_id = addon.system.handle | default: addon.id | default: forloop.index -%}
                  {%- assign a_name = addon.name.value | default: addon.name -%}
                  {%- assign a_price = addon.price.value | default: addon.price | default: 5 -%}
                  {%- assign a_mini = addon.price_mini.value | default: addon.price_mini | default: a_price -%}
                  {%- assign a_med = addon.price_medium.value | default: addon.price_medium | default: a_price -%}
                  {%- assign a_lar = addon.price_large.value | default: addon.price_large | default: a_price -%}
                  {%- assign a_icon = addon.icon.value | default: addon.icon | default: '✨' -%}
                  {%- assign a_desc = addon.description.value | default: addon.description | default: '' -%}
                  {%- assign a_dur = addon.duration_mins.value | default: addon.duration_mins | default: 0 -%}
                  <label class="booking-addon-card" data-addon-card="{{ a_id }}">
                    <input
                      type="checkbox"
                      name="grooming_addon"
                      value="{{ a_id }}"
                      class="visually-hidden booking-addon-input"
                      data-addon-id="{{ a_id }}"
                      data-price="{{ a_price }}"
                      data-price-mini="{{ a_mini }}"
                      data-price-medium="{{ a_med }}"
                      data-price-large="{{ a_lar }}"
                      data-duration-mins="{{ a_dur }}"
                    >
                    <span class="booking-addon-toggle" aria-hidden="true"></span>
                    <div class="booking-addon-icon">{{ a_icon }}</div>
                    <div class="booking-addon-content">
                      <div class="booking-addon-top">
                        <span class="booking-addon-name">{{ a_name }}</span>
                        <span class="booking-addon-price" data-addon-price-display>+{{ a_mini }},00 €</span>
                      </div>
                      {%- if a_desc != blank -%}
                        <p class="booking-addon-desc">{{ a_desc }}</p>
                      {%- endif -%}
                      {%- if a_dur > 0 -%}
                        <span class="booking-addon-duration">+{{ a_dur }} min</span>
                      {%- endif -%}
                    </div>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <!-- Extra 1: Mascarilla Ozonoterapia & Argán -->
              <label class="booking-addon-card" data-addon-card="addon_ozone_mask">
                <input
                  type="checkbox"
                  name="grooming_addon"
                  value="addon_ozone_mask"
                  class="visually-hidden booking-addon-input"
                  data-addon-id="addon_ozone_mask"
                  data-price="8"
                  data-price-mini="6"
                  data-price-medium="8"
                  data-price-large="10"
                  data-duration-mins="10"
                >
                <span class="booking-addon-toggle" aria-hidden="true"></span>
                <div class="booking-addon-icon">🫧</div>
                <div class="booking-addon-content">
                  <div class="booking-addon-top">
                    <span class="booking-addon-name">{% if booking_en %}Ozone & Argan Nourishing Mask{% else %}Mascarilla Ozonoterapia & Argán{% endif %}</span>
                    <span class="booking-addon-price" data-addon-price-display>+6,00 €</span>
                  </div>
                  <p class="booking-addon-desc">
                    {% if booking_en %}Deep nourishment, silky shine, and anti-itch relief for sensitive skin.{% else %}Nutrición profunda, brillo sedoso y alivio anti-picores para piel sensible.{% endif %}
                  </p>
                  <span class="booking-addon-duration">{% if booking_en %}+10 min{% else %}+10 min{% endif %}</span>
                </div>
              </label>

              <!-- Extra 2: Higiene Bucal Enzimática -->
              <label class="booking-addon-card" data-addon-card="addon_dental_clean">
                <input
                  type="checkbox"
                  name="grooming_addon"
                  value="addon_dental_clean"
                  class="visually-hidden booking-addon-input"
                  data-addon-id="addon_dental_clean"
                  data-price="6"
                  data-price-mini="6"
                  data-price-medium="6"
                  data-price-large="6"
                  data-duration-mins="5"
                >
                <span class="booking-addon-toggle" aria-hidden="true"></span>
                <div class="booking-addon-icon">🦷</div>
                <div class="booking-addon-content">
                  <div class="booking-addon-top">
                    <span class="booking-addon-name">{% if booking_en %}Enzymatic Oral Care{% else %}Higiene Bucal Enzimática{% endif %}</span>
                    <span class="booking-addon-price" data-addon-price-display>+6,00 €</span>
                  </div>
                  <p class="booking-addon-desc">
                    {% if booking_en %}Bio-enzymatic brush. Reduces tartar, prevents plaque, and leaves fresh breath.{% else %}Cepillado con gel bioenzimático. Reduce sarro, previene placa y deja aliento fresco.{% endif %}
                  </p>
                  <span class="booking-addon-duration">{% if booking_en %}+5 min{% else %}+5 min{% endif %}</span>
                </div>
              </label>

              <!-- Extra 3: Corte de Uñas & Bálsamo Almohadillas -->
              <label class="booking-addon-card" data-addon-card="addon_paws_balsam">
                <input
                  type="checkbox"
                  name="grooming_addon"
                  value="addon_paws_balsam"
                  class="visually-hidden booking-addon-input"
                  data-addon-id="addon_paws_balsam"
                  data-price="5"
                  data-price-mini="5"
                  data-price-medium="5"
                  data-price-large="5"
                  data-duration-mins="5"
                >
                <span class="booking-addon-toggle" aria-hidden="true"></span>
                <div class="booking-addon-icon">🐾</div>
                <div class="booking-addon-content">
                  <div class="booking-addon-top">
                    <span class="booking-addon-name">{% if booking_en %}Nail Trim & Paw Pad Balm{% else %}Corte de Uñas & Bálsamo Almohadillas{% endif %}</span>
                    <span class="booking-addon-price" data-addon-price-display>+5,00 €</span>
                  </div>
                  <p class="booking-addon-desc">
                    {% if booking_en %}Delicate pet pedicure and moisturizing protective wax against pavement cracks.{% else %}Pedicura canina delicada y cera hidratante protectora contra asfalto y grietas.{% endif %}
                  </p>
                  <span class="booking-addon-duration">{% if booking_en %}+5 min{% else %}+5 min{% endif %}</span>
                </div>
              </label>

              <!-- Extra 4: Champú Repelente Antiparasitario -->
              <label class="booking-addon-card" data-addon-card="addon_antiparasitic">
                <input
                  type="checkbox"
                  name="grooming_addon"
                  value="addon_antiparasitic"
                  class="visually-hidden booking-addon-input"
                  data-addon-id="addon_antiparasitic"
                  data-price="4"
                  data-price-mini="3"
                  data-price-medium="4"
                  data-price-large="6"
                  data-duration-mins="0"
                >
                <span class="booking-addon-toggle" aria-hidden="true"></span>
                <div class="booking-addon-icon">🛡️</div>
                <div class="booking-addon-content">
                  <div class="booking-addon-top">
                    <span class="booking-addon-name">{% if booking_en %}Antiparasitic Protective Shampoo{% else %}Champú Repelente Antiparasitario{% endif %}</span>
                    <span class="booking-addon-price" data-addon-price-display>+3,00 €</span>
                  </div>
                  <p class="booking-addon-desc">
                    {% if booking_en %}Bath with natural citronella and tea tree extracts to repel fleas and ticks.{% else %}Lavado con extractos naturales de citronela y árbol de té para repeler pulgas y garrapatas.{% endif %}
                  </p>
                </div>
              </label>
            {%- endif -%}
          </div>
        </div>

        <!-- Live Estimate Bar -->
        <div class="booking-estimate-summary">
          <div class="estimate-info">
            <span class="estimate-label">
              {% if booking_en %}Estimated fee for this service:{% else %}Tarifa estimada para este servicio:{% endif %}
            </span>
            <div class="estimate-numbers">
              <span class="estimate-price" data-booking-estimate-price>—</span>
              <span class="estimate-duration" data-booking-estimate-duration>{% if booking_en %}(⏱️ 1 hour){% else %}(⏱️ 1 hora){% endif %}</span>
            </div>
          </div>
          <button type="button" class="grooming-booking-btn-primary" data-wizard-action="next">
            <span>{% if booking_en %}Continue to Date & Time{% else %}Continuar a Fecha y Hora{% endif %}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

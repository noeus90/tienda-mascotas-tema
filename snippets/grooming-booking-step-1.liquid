                </p>
                <div class="service-card-meta">
                  <span class="service-duration" data-i18n-es="⏱️ 1 hora" data-i18n-en="⏱️ 1 hour">⏱️ 1 hora</span>
                  <span class="service-base-price" data-price-mini="42" data-price-medium="50" data-price-large="62">Desde 42 €</span>
                </div>
              </div>
            </label>
          {%- endif -%}

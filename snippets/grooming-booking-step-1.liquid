{%- comment -%} Texts: locales pet_cro.booking.* (CODE-11). {%- endcomment -%}
      <div class="booking-step-panel is-active" data-step-panel="1">
        <div class="step-panel-header">
          <h3 class="step-panel-title">
            {{ 'pet_cro.booking.step_1.title' | t }}
          </h3>
          <p class="step-panel-desc">
            {{ 'pet_cro.booking.step_1.intro' | t }}
          </p>
        </div>

        <!-- Logged-in customers: their dogs from the booking app (/apps/reservas/mis-perros), filled by grooming-booking.js -->
        <div class="booking-my-dogs" data-booking-my-dogs hidden>
          <p class="booking-my-dogs-title">{{ 'pet_cro.booking.step_1.my_dogs_title' | t }}</p>
          <div class="booking-my-dogs-list" data-booking-my-dogs-list role="group"></div>
          <p class="booking-field-hint">{{ 'pet_cro.booking.step_1.my_dogs_hint' | t }}</p>
        </div>

        {% render 'grooming-booking-services', has_custom_services: has_custom_services, meta_services: meta_services %}

        {% render 'grooming-booking-size', section: section %}

        {% render 'grooming-booking-addons', has_custom_addons: has_custom_addons, meta_addons: meta_addons %}

        <!-- Live Estimate Bar -->
        <div class="booking-estimate-summary">
          <div class="estimate-info">
            <span class="estimate-label">
              {{ 'pet_cro.booking.step_1.estimate_label' | t }}
            </span>
            <div class="estimate-numbers">
              <span class="estimate-price" data-booking-estimate-price>—</span>
              <span class="estimate-duration" data-booking-estimate-duration>{{ 'pet_cro.booking.step_1.estimate_duration' | t }}</span>
            </div>
          </div>
          <button type="button" class="grooming-booking-btn-primary" data-wizard-action="next">
            <span>{{ 'pet_cro.booking.step_1.continue' | t }}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

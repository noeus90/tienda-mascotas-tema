              <input type="radio" name="grooming_service" value="deshedding" class="visually-hidden">
              <span class="service-card-check" aria-hidden="true"></span>
              <div class="service-card-icon">🐕</div>
              <div class="service-card-content">
                <h4 class="service-card-name" data-i18n-es="Deslanado Completo & Baño" data-i18n-en="Full Deshedding & Bath">
                  Deslanado Completo & Baño
                </h4>
                <p class="service-card-desc" data-i18n-es="Elimina hasta el 90% de pelo muerto de subpelo. Ideal para Golden, Husky, Pastor Alemán o mestizos." data-i18n-en="Removes up to 90% undercoat dead fur. Perfect for Golden, Husky, German Shepherd, or mixes.">

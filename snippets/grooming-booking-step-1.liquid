        </div>

        <div class="booking-services-grid" role="radiogroup" aria-label="Servicios de peluquería">
          {%- if has_custom_services -%}
            {%- for service in meta_services -%}
              {%- assign is_active = true -%}
              {%- if service.active.value == false or service.active == false -%}{%- assign is_active = false -%}{%- endif -%}
              {%- if is_active -%}
                {%- assign s_id = service.system.handle | default: service.id | default: forloop.index -%}
                {%- assign s_name = service.name.value | default: service.name -%}
                {%- assign s_icon = service.icon.value | default: service.icon | default: '🐾' -%}
                {%- assign s_desc = service.description.value | default: service.description -%}
                {%- assign s_dur = service.duration.value | default: service.duration | default: '1 hora' -%}
                {%- assign s_mini = service.price_mini.value | default: service.price_mini | default: 28 -%}
                {%- assign s_med = service.price_medium.value | default: service.price_medium | default: 34 -%}
                {%- assign s_lar = service.price_large.value | default: service.price_large | default: 42 -%}

                <label class="booking-service-card{% if forloop.first %} is-selected{% endif %}">
                  <input type="radio" name="grooming_service" value="{{ s_id }}" {% if forloop.first %}checked{% endif %} class="visually-hidden">
                  <span class="service-card-check" aria-hidden="true"></span>
                  <div class="service-card-icon">{{ s_icon }}</div>
                  <div class="service-card-content">
                    <h4 class="service-card-name">{{ s_name }}</h4>
                    {%- if s_desc != blank -%}
                      <p class="service-card-desc">{{ s_desc }}</p>
                    {%- endif -%}
                    <div class="service-card-meta">
                      <span class="service-duration">{{ s_dur }}</span>
                      <span class="service-base-price" data-price-mini="{{ s_mini }}" data-price-medium="{{ s_med }}" data-price-large="{{ s_lar }}">
                        Desde {{ s_mini }} €
                      </span>
                    </div>
                  </div>
                </label>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}

                </p>
                <div class="service-card-meta">
                  <span class="service-duration" data-i18n-es="⏱️ 1 hora" data-i18n-en="⏱️ 1 hour">⏱️ 1 hora</span>
                  <span class="service-base-price" data-price-mini="35" data-price-medium="42" data-price-large="52">Desde 35 €</span>
                </div>
              </div>
            </label>

            <!-- Servicio 4: Spa Ozono -->
            <label class="booking-service-card">
              <input type="radio" name="grooming_service" value="spa_ozone" class="visually-hidden">

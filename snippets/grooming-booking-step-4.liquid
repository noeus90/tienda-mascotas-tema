{%- comment -%} Texts follow the page language (/en/ English, otherwise Spanish). {%- endcomment -%}
{%- assign booking_en = false -%}{%- if request.locale.iso_code == 'en' -%}{%- assign booking_en = true -%}{%- endif -%}
      <div class="booking-step-panel" data-step-panel="4" hidden>
        <div class="step-panel-header">
          <h3 class="step-panel-title">
            {% if booking_en %}4. Summary of your custom appointment{% else %}4. Resumen de tu cita personalizada{% endif %}
          </h3>
          <p class="step-panel-desc">
            {% if booking_en %}Review details before confirming. You will receive immediate confirmation.{% else %}Revisa los datos antes de confirmar. Te enviaremos confirmación inmediata.{% endif %}
          </p>
        </div>

        <div class="booking-confirmation-card">
          <div class="confirmation-summary-header">
            <div class="confirmation-pet-badge">
              <span class="pet-icon">🐾</span>
              <div>
                <strong class="pet-summary-name" data-summary="petName">Coco</strong>
                <span class="pet-summary-breed" data-summary="petBreed">Caniche Toy</span>
              </div>
            </div>
            <div class="confirmation-price-tag">
              <span class="price-label">{% if booking_en %}Estimated total{% else %}Total estimado{% endif %}</span>
              <strong class="price-amount" data-summary="price">28,00 €</strong>
            </div>
          </div>

          <div class="confirmation-details-grid">
            <div class="conf-item">
              <span class="conf-label">{% if booking_en %}Service booked{% else %}Servicio contratado{% endif %}</span>
              <strong class="conf-value" data-summary="serviceName">Baño Dermoprotector & Oídos</strong>
            </div>
            <div class="conf-item conf-item-addons" data-summary-addons-wrap hidden>
              <span class="conf-label">{% if booking_en %}Extra care added{% else %}Cuidados extra añadidos{% endif %}</span>
              <div class="conf-value conf-addons-list" data-summary="addonsList"></div>
            </div>
            <div class="conf-item">
              <span class="conf-label">{% if booking_en %}Date & shift{% else %}Fecha y turno{% endif %}</span>
              <strong class="conf-value" data-summary="schedule">Mañana · 10:00 - 11:00 h (1 hora)</strong>
            </div>
            <div class="conf-item" data-summary-groomer-row hidden>
              <span class="conf-label">{% if booking_en %}Groomer{% else %}Peluquera{% endif %}</span>
              <strong class="conf-value" data-summary="groomer"></strong>
            </div>
            {%- if salon_address != blank -%}
              <div class="conf-item">
                <span class="conf-label">{% if booking_en %}Salon location{% else %}Ubicación del salón{% endif %}</span>
                <strong class="conf-value" data-summary="salonAddress">{{ salon_address | escape }}</strong>
              </div>
            {%- endif -%}
            <div class="conf-item">
              <span class="conf-label">{% if booking_en %}Parent & phone{% else %}Tutor y teléfono{% endif %}</span>
              <strong class="conf-value" data-summary="customerInfo"></strong>
            </div>
            <div class="conf-item">
              <span class="conf-label">{% if booking_en %}Special care{% else %}Cuidados especiales{% endif %}</span>
              <span class="conf-value" data-summary="specialNeeds">{% if booking_en %}No special needs{% else %}Sin particularidades{% endif %}</span>
            </div>
          </div>

          <!-- Action Confirmations: the booking is saved by the booking app (/apps/reservas/citas) -->
          <div class="confirmation-cta-box">
            <button type="button" class="grooming-booking-btn-primary booking-submit-btn" data-booking-action="submit-booking">
              <span>{% if booking_en %}Confirm booking{% else %}Confirmar reserva{% endif %}</span>
            </button>
            <div class="booking-submit-status" role="status" aria-live="polite" data-booking-submit-status hidden></div>

            <!-- Deposit ("señal") offered by the booking app after saving; filled by grooming-booking.js -->
            <div class="booking-deposit" data-booking-deposit hidden>
              <p class="booking-deposit-text" data-booking-deposit-text></p>
              <a href="#" class="booking-deposit-btn" data-booking-deposit-link target="_blank" rel="noopener"></a>
              <p class="booking-field-hint" data-booking-deposit-note hidden></p>
            </div>

            <div class="booking-after-submit" data-booking-after-submit hidden>
            {%- if salon_whatsapp != blank -%}
            <a
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="grooming-booking-btn-whatsapp"
              data-booking-action="whatsapp-confirm"
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.392-12.416c-6.627 0-12 5.373-12 12 0 2.159.57 4.185 1.564 5.938l-1.603 5.862 6.027-1.581c1.7 1.009 3.682 1.581 5.812 1.581 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/>
              </svg>
              <span>
                {% if booking_en %}Confirm by WhatsApp{% else %}Confirmar la cita por WhatsApp{% endif %}
              </span>
            </a>
            {%- endif -%}

            <div class="booking-secondary-actions">
              {%- if salon_email != blank -%}
              <a
                href="#"
                class="grooming-booking-btn-secondary-action grooming-booking-btn-email"
                data-booking-action="email-confirm"
              >
                {% if booking_en %}Send via Email{% else %}Enviar por email{% endif %}
              </a>
              {%- endif -%}
              {%- if salon_whatsapp != blank -%}
              <a
                href="#"
                class="grooming-booking-btn-secondary-action grooming-booking-btn-sms"
                data-booking-action="sms-confirm"
              >
                {% if booking_en %}Send via SMS{% else %}Enviar por SMS{% endif %}
              </a>
              {%- endif -%}
              {%- if salon_address != blank -%}
              <a
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="grooming-booking-btn-secondary-action grooming-booking-btn-maps"
                data-booking-action="salon-maps"
              >
                {% if booking_en %}Get directions{% else %}Cómo llegar{% endif %}
              </a>
              {%- endif -%}
              <button
                type="button"
                class="grooming-booking-btn-secondary-action grooming-booking-btn-ics"
                data-booking-action="apple-calendar"
              >
                {% if booking_en %}Add to Apple / Outlook{% else %}Añadir a Apple / Outlook{% endif %}
              </button>
              <a
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="grooming-booking-btn-secondary-action grooming-booking-btn-gcal"
                data-booking-action="gcal-link"
              >
                {% if booking_en %}Add to Google Calendar{% else %}Añadir a Google Calendar{% endif %}
              </a>
              <button
                type="button"
                class="grooming-booking-btn-secondary-action grooming-booking-btn-copy"
                data-booking-action="copy-details"
              >
                {% if booking_en %}Copy details{% else %}Copiar datos{% endif %}
              </button>
            </div>
            </div>

            <div class="booking-success-banner" data-booking-success-banner hidden>
              <span class="success-icon">🎉</span>
              <div class="success-text">
                <strong>
                  {% if booking_en %}Request generated successfully!{% else %}¡Solicitud generada con éxito!{% endif %}
                </strong>
                <p>
                  {% if booking_en %}We opened WhatsApp with your message. The slot will be reserved as soon as we confirm with you.{% else %}Hemos abierto WhatsApp con tu mensaje redactado. La cita quedará reservada en cuanto confirmemos la hora contigo.{% endif %}
                </p>
              </div>
            </div>

            <div class="booking-trust-points">
              <span class="trust-point">{% if booking_en %}📧 Email confirmation{% else %}📧 Confirmación por email{% endif %}</span>
              <span class="trust-point">{% if booking_en %}⏰ Reminder the day before{% else %}⏰ Recordatorio el día antes{% endif %}</span>
              <span class="trust-point" data-booking-payment-note>{% if booking_en %}💳 Pay at salon after session{% else %}💳 Pago en tienda tras el servicio{% endif %}</span>
            </div>
          </div>
        </div>

        <div class="booking-panel-nav">
          <button type="button" class="grooming-booking-btn-secondary" data-wizard-action="prev">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            <span>{% if booking_en %}Edit details{% else %}Modificar datos{% endif %}</span>
          </button>
        </div>
      </div>

{%- doc -%}
  "Frequently bought together" block for the product page.
  Shows the current product plus its complementary products (set per product in the
  Search & Discovery app) with checkboxes, and adds the selected ones to the cart at once.

  The page renders the current product only. The complementary products come from
  the product recommendations endpoint (intent=complementary), which renders this same
  section with `recommendations`; the JS takes the [data-bt-recs] list from that response.
  Nothing is shown when the product has no available complementary products.

  @param {object} block - (Required) The "bought_together" block of main-product.
  @param {product} product - (Required) The product of the page.
  @param {object} section - (Required) The main-product section.
  @param {object} recommendations - (Required) The section's `recommendations` object.

  @example
  {% render 'pet-bought-together', block: block, product: product, section: section, recommendations: recommendations %}
{%- enddoc -%}

{%- liquid
  assign bt_limit = block.settings.product_list_limit | default: 2
  assign fetch_limit = bt_limit | plus: 2
-%}

{%- if recommendations.performed -%}
  {%- comment -%} Response of the recommendations endpoint: only the list of products is used. {%- endcomment -%}
  <ul data-bt-recs="{{ block.id }}">
    {%- assign shown = 0 -%}
    {%- for rec in recommendations.products -%}
      {%- if shown >= bt_limit -%}{%- break -%}{%- endif -%}
      {%- unless rec.available -%}{%- continue -%}{%- endunless -%}
      {%- assign shown = shown | plus: 1 -%}
      {%- assign rec_variant = rec.selected_or_first_available_variant -%}
      <li class="bought-together__item" data-bt-item data-variant-id="{{ rec_variant.id }}" data-price="{{ rec_variant.price }}">
        <input
          type="checkbox"
          class="bought-together__check"
          id="BoughtTogether-{{ block.id }}-{{ rec.id }}"
          aria-label="{{ 'pet_cro.bought_together.add_item_label' | t: title: rec.title | escape }}"
          data-bt-check
          checked
        >
        <a href="{{ rec.url }}" class="bought-together__media" tabindex="-1" aria-hidden="true">
          {%- if rec.featured_image -%}
            {{ rec.featured_image | image_url: width: 120 | image_tag: width: 56, height: 56, loading: 'lazy', alt: '' }}
          {%- endif -%}
        </a>
        <div class="bought-together__info">
          <a href="{{ rec.url }}" class="bought-together__title link">{{ rec.title | escape }}</a>
          {%- assign available_variants = rec.variants | where: 'available' -%}
          {%- if rec.has_only_default_variant == false and available_variants.size > 1 -%}
            <select
              class="bought-together__variant"
              aria-label="{{ 'pet_cro.bought_together.variant_label' | t: title: rec.title | escape }}"
              data-bt-variant
            >
              {%- for variant in available_variants -%}
                <option value="{{ variant.id }}" data-price="{{ variant.price }}"{% if variant.id == rec_variant.id %} selected{% endif %}>
                  {{- variant.title | escape -}}
                </option>
              {%- endfor -%}
            </select>
          {%- endif -%}
        </div>
        <span class="bought-together__price" data-bt-price>{{ rec_variant.price | money }}</span>
      </li>
    {%- endfor -%}
  </ul>
{%- else -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {{ 'component-pet-bought-together.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'pet-bought-together.js' | asset_url }}" defer="defer"></script>
  <bought-together
    class="bought-together pet-panel"
    data-url="{{ routes.product_recommendations_url }}?limit={{ fetch_limit }}&intent=complementary&product_id={{ product.id }}&section_id={{ section.id }}"
    data-block-id="{{ block.id }}"
    data-section-id="{{ section.id }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-cta="{{ 'pet_cro.bought_together.add_cta' | t: count: '__COUNT__', total: '__TOTAL__' | escape }}"
    data-select-one="{{ 'pet_cro.bought_together.select_one' | t | escape }}"
    data-added="{{ 'pet_cro.bought_together.added' | t | escape }}"
    data-error="{{ 'pet_cro.bought_together.add_error' | t | escape }}"
    hidden
    {{ block.shopify_attributes }}
  >
    <h2 class="bought-together__heading h4">{{ 'pet_cro.bought_together.heading' | t }}</h2>
    <ul class="bought-together__list list-unstyled" role="list" data-bt-list>
      <li
        class="bought-together__item bought-together__item--current"
        data-bt-item
        data-bt-current
        data-variant-id="{{ current_variant.id }}"
        data-price="{{ current_variant.price }}"
      >
        <input
          type="checkbox"
          class="bought-together__check"
          id="BoughtTogether-{{ block.id }}-current"
          aria-label="{{ 'pet_cro.bought_together.add_item_label' | t: title: product.title | escape }}"
          data-bt-check
          {% if current_variant.available %}
            checked
          {% else %}
            disabled
          {% endif %}
        >
        <span class="bought-together__media" aria-hidden="true">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 120 | image_tag: width: 56, height: 56, loading: 'lazy', alt: '' }}
          {%- endif -%}
        </span>
        <div class="bought-together__info">
          <span class="bought-together__this">{{ 'pet_cro.bought_together.this_item' | t }}</span>
          <span class="bought-together__title">{{ product.title | escape }}</span>
        </div>
        <span class="bought-together__price" data-bt-price>{{ current_variant.price | money }}</span>
      </li>
    </ul>
    <div class="bought-together__footer">
      <button type="button" class="button button--secondary bought-together__add" data-bt-add>
        {{- 'pet_cro.bought_together.select_one' | t -}}
      </button>
      <p class="bought-together__status" role="status" data-bt-status></p>
    </div>
  </bought-together>
{%- endif -%}

{%- doc -%}
  Compact ES / EN language switcher pill (header, drawer and footer).
  Renders plain links to the same page in each language published in Shopify.
  Hidden when the store has fewer than two of these languages published.

  @example
  {% render 'header-language-switcher' %}
{%- enddoc -%}

{%- liquid
  assign current_iso = localization.language.iso_code | default: request.locale.iso_code | downcase | slice: 0, 2
  assign current_root = request.locale.root_url
  assign clean_path = request.path
  if current_root != '/'
    assign clean_path = clean_path | replace_first: current_root, ''
  endif
  if clean_path == blank
    assign clean_path = '/'
  endif

  assign es_url = ''
  assign en_url = ''
  for lang in localization.available_languages
    assign code = lang.iso_code | downcase | slice: 0, 2
    if code == 'es'
      if lang.root_url == '/'
        assign es_url = clean_path
      else
        assign es_url = lang.root_url | append: clean_path | replace: '//', '/'
      endif
    elsif code == 'en'
      if lang.root_url == '/'
        assign en_url = clean_path
      else
        assign en_url = lang.root_url | append: clean_path | replace: '//', '/'
      endif
    endif
  endfor

  assign has_both_shopify_langs = false
  if es_url != '' and en_url != ''
    assign has_both_shopify_langs = true
  endif
-%}

{%- if has_both_shopify_langs -%}
  <nav class="header-lang-switcher-form" aria-label="{{ 'localization.language_label' | t }}">
    <div class="header-lang-pill">
      {%- if current_iso == 'es' -%}
        <span class="header-lang-btn is-active" lang="es" aria-current="true" title="Español">ES</span>
      {%- else -%}
        <a class="header-lang-btn" href="{{ es_url }}" hreflang="es" lang="es" title="Español">ES</a>
      {%- endif -%}
      <span class="header-lang-divider" aria-hidden="true">|</span>
      {%- if current_iso == 'en' -%}
        <span class="header-lang-btn is-active" lang="en" aria-current="true" title="English">EN</span>
      {%- else -%}
        <a class="header-lang-btn" href="{{ en_url }}" hreflang="en" lang="en" title="English">EN</a>
      {%- endif -%}
    </div>
  </nav>
{%- endif -%}

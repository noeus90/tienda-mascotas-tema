{% comment %}
  CRO Section: Dynamic Pet Collection Showcase (sections/collection-showcase.liquid)
{% endcomment %}

{{ 'section-collection-showcase.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .showcase-wrapper-{{ section.id }} {
    padding-top: {{ section.settings.padding_y }}px;
    padding-bottom: {{ section.settings.padding_y }}px;
  }
{%- endstyle -%}

<section class="showcase-wrapper showcase-wrapper-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="showcase-header">
    {%- liquid
      assign raw_sc_h = section.settings.heading | strip
      assign is_sc_h = false
      if raw_sc_h == 'Favoritos para tu Mascota' or raw_sc_h == 'Favorites for Your Pet' or raw_sc_h == 'Top Ventas Tienda Animal' or raw_sc_h == 'Top Pet Store Bestsellers'
        assign is_sc_h = true
      endif
      assign sc_locale = request.locale.iso_code | downcase | slice: 0, 2
    -%}
    <h2
      {% if is_sc_h %}
        {% if raw_sc_h == 'Top Ventas Tienda Animal' or raw_sc_h == 'Top Pet Store Bestsellers' %}
          data-i18n-es="Top Ventas Tienda Animal"
          data-i18n-en="Top Pet Store Bestsellers"
        {% else %}
          data-i18n-es="Favoritos para tu Mascota"
          data-i18n-en="Favorites for Your Pet"
        {% endif %}
      {% endif %}
    >
      {%- if is_sc_h -%}
        {%- if sc_locale == 'en' -%}
          {%- if raw_sc_h == 'Top Ventas Tienda Animal' or raw_sc_h == 'Top Pet Store Bestsellers' -%}
            Top Pet Store Bestsellers
          {%- else -%}
            Favorites for Your Pet
          {%- endif -%}
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      {%- else -%}
        {{ section.settings.heading }}
      {%- endif -%}
    </h2>
  </div>
  {%- assign selected_collection = section.settings.collection -%}
  {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
    <div class="showcase-grid">
      {%- for product_item in selected_collection.products limit: section.settings.products_limit -%}
        <div class="showcase-card {% unless product_item.available %}is-sold-out{% endunless %}">
          <div class="showcase-media">
            {%- if product_item.featured_image != blank -%}
              {%- liquid
                assign img_loading = 'lazy'
                assign img_priority = 'auto'
                if section.index == 1 and forloop.index <= 2
                  assign img_loading = 'eager'
                  assign img_priority = 'high'
                endif
                assign img_alt = product_item.featured_image.alt | default: product_item.title | escape
              -%}
              {{
                product_item.featured_image
                | image_url: width: 1066
                | image_tag:
                  loading: img_loading,
                  fetchpriority: img_priority,
                  widths: '165, 360, 533, 720, 940, 1066',
                  sizes: '(min-width: 1200px) 270px, (min-width: 990px) calc((100vw - 6rem) / 4), (min-width: 750px) calc((100vw - 4.5rem) / 2), calc(100vw - 3rem)',
                  alt: img_alt,
                  width: product_item.featured_image.width,
                  height: product_item.featured_image.height
              }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'showcase-placeholder' }}
            {% endif %}
            {%- unless product_item.available -%}
              <span
                class="showcase-badge-soldout"
                data-i18n-es="Agotado"
                data-i18n-en="Sold Out"
              >
                {{- 'pet_cro.badge.sold_out' | t -}}
              </span>
            {%- endunless -%}
          </div>
          <div class="showcase-info">
            <h3 class="showcase-title">
              <a href="{{ product_item.url }}">{{ product_item.title | escape }}</a>
            </h3>
            <div class="showcase-price">
              {{ product_item.price | money }}
            </div>
            {%- assign variant_list = product_item.variants | map: 'title' | join: ' · ' -%}
            {%- if product_item.has_only_default_variant == false -%}
              <div class="showcase-variants">
                <strong
                  data-i18n-es="Formatos: "
                  data-i18n-en="Sizes: "
                >
                  {{- 'pet_cro.badge.options' | t }}
                </strong>
                {{- variant_list -}}
              </div>
            {%- endif -%}
          </div>
        </div>
      {% endfor %}
    </div>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": {{ section.settings.heading | default: selected_collection.title | json }},
        "numberOfItems": {{ selected_collection.products.size | at_most: section.settings.products_limit | json }},
        "itemListElement": [
          {%- for product_item in selected_collection.products limit: section.settings.products_limit -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "url": {{ request.origin | append: product_item.url | json }},
              "name": {{ product_item.title | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- else %}
    <div class="showcase-empty-state">
      <p
        data-i18n-es="Selecciona una colección de productos para mascotas desde la barra lateral del editor"
        data-i18n-en="Select a pet product collection from the theme editor sidebar"
      >
        {{- 'pet_cro.showcase.empty_state' | t -}}
      </p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.collection_showcase.name",
  "tag": "section",
  "class": "section-collection-showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collection_showcase.settings.heading.label",
      "default": "Favoritos para tu Mascota"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.collection_showcase.settings.collection.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "t:sections.collection_showcase.settings.products_limit.label"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 40,
      "unit": "px",
      "label": "t:sections.collection_showcase.settings.padding_y.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_showcase.name",
      "settings": {
        "heading": "Top Ventas Tienda Animal",
        "products_limit": 4
      }
    }
  ]
}
{% endschema %}

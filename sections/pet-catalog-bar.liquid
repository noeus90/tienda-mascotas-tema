{% comment %}
  Pet catalog bar (sections/pet-catalog-bar.liquid), shown above the collection grid.

  Shopify does the filtering on the server, so it covers every page of the collection:
  - Pet buttons are links to the "perros" and "gatos" collections (or all products).
    The active category is kept when switching pet.
  - Category pills come from the "Product type" filter of Search & Discovery
    (collection.filters, param filter.p.product_type). Only types with products are shown,
    with their real count. A pill replaces the current type; clicking the active one removes it.
  - Stage / need chips (tags) are folded in a disclosure, opened when one is active.
  - "Clear filters" only shows with an active filter and keeps the chosen pet (the product count
    is in Dawn's filter bar, so it is not repeated here). UX-15.

  assets/pet-catalog-bar.js re-renders this section when Dawn's AJAX filters change the grid,
  and redirects old links (?mascota=perro&categoria=pienso…) to the new URLs.
{% endcomment %}

{{ 'section-pet-catalog-bar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pet-catalog-bar.js' | asset_url }}" defer="defer"></script>
<script type="application/json" data-pet-taxonomy>{%- render 'pet-taxonomy', format: 'json' -%}</script>

{%- liquid
  assign all_url = routes.all_products_collection_url
  # Types, tags and collections: snippet pet-taxonomy (CODE-08).
  capture pet_taxonomy
    render 'pet-taxonomy'
  endcapture
  assign dogs_handle = pet_taxonomy | split: ';collection_dogs=' | last | split: ';' | first
  assign cats_handle = pet_taxonomy | split: ';collection_cats=' | last | split: ';' | first
  assign type_kibble = pet_taxonomy | split: ';type_kibble=' | last | split: ';' | first
  assign type_wet = pet_taxonomy | split: ';type_wet=' | last | split: ';' | first
  assign type_barf = pet_taxonomy | split: ';type_barf=' | last | split: ';' | first
  assign type_snacks = pet_taxonomy | split: ';type_snacks=' | last | split: ';' | first
  assign type_toys = pet_taxonomy | split: ';type_toys=' | last | split: ';' | first
  assign type_grooming = pet_taxonomy | split: ';type_grooming=' | last | split: ';' | first
  assign type_supplements = pet_taxonomy | split: ';type_supplements=' | last | split: ';' | first
  assign type_accessories = pet_taxonomy | split: ';type_accessories=' | last | split: ';' | first
  assign dogs_url = routes.collections_url | append: '/' | append: dogs_handle
  assign cats_url = routes.collections_url | append: '/' | append: cats_handle

  case collection.handle
    when dogs_handle
      assign active_pet = 'dog'
    when cats_handle
      assign active_pet = 'cat'
    else
      assign active_pet = 'all'
  endcase

  assign type_filter = nil
  for f in collection.filters
    if f.param_name == 'filter.p.product_type'
      assign type_filter = f
      break
    endif
  endfor

  assign keep_query = ''
  if type_filter
    for v in type_filter.active_values
      assign enc_value = v.value | url_encode
      assign keep_query = keep_query | append: '&' | append: v.param_name | append: '=' | append: enc_value
    endfor
    if keep_query != blank
      assign keep_query = keep_query | remove_first: '&' | prepend: '?'
    endif
  endif

  assign any_filter_active = false
  for f in collection.filters
    if f.active_values.size > 0 or f.min_value.value != nil or f.max_value.value != nil
      assign any_filter_active = true
    endif
  endfor
-%}

{%- style -%}
  .pet-catalog-bar-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div
  class="pet-catalog-bar-section pet-catalog-bar-{{ section.id }} color-{{ section.settings.color_scheme }} gradient"
  data-pet-catalog-bar
  data-section-id="{{ section.id }}"
  id="pet-catalog-bar-{{ section.id }}"
>
  <div class="pet-catalog-bar-container page-width">
    {%- if section.settings.show_mascot_switcher -%}
      <nav class="pet-mascot-switcher" aria-label="{{ 'pet_cro.catalog_bar.aria_species' | t }}">
        <span class="pet-mascot-label">{{ 'pet_cro.catalog_bar.your_pet' | t }}</span>
        <a
          href="{{ all_url }}{{ keep_query }}"
          class="pet-mascot-btn{% if active_pet == 'all' %} is-active{% endif %}"
          {% if active_pet == 'all' %}
            aria-current="page"
          {% endif %}
        >
          <span class="pet-mascot-icon" aria-hidden="true">✨</span>
          <span>{{ 'pet_cro.catalog_bar.all_pets' | t }}</span>
        </a>
        <a
          href="{{ dogs_url }}{{ keep_query }}"
          class="pet-mascot-btn{% if active_pet == 'dog' %} is-active{% endif %}"
          {% if active_pet == 'dog' %}
            aria-current="page"
          {% endif %}
        >
          <span class="pet-mascot-icon" aria-hidden="true">🐶</span>
          <span>{{ 'pet_cro.catalog_bar.dogs' | t }}</span>
        </a>
        <a
          href="{{ cats_url }}{{ keep_query }}"
          class="pet-mascot-btn{% if active_pet == 'cat' %} is-active{% endif %}"
          {% if active_pet == 'cat' %}
            aria-current="page"
          {% endif %}
        >
          <span class="pet-mascot-icon" aria-hidden="true">🐱</span>
          <span>{{ 'pet_cro.catalog_bar.cats' | t }}</span>
        </a>
        <a
          href="{{ collection.url }}"
          class="pet-catalog-reset-btn"
          data-pet-reset
          {% unless any_filter_active %}
            hidden
          {% endunless %}
        >
          <span aria-hidden="true">✕</span>
          <span>{{ 'pet_cro.catalog_bar.clear_filters' | t }}</span>
        </a>
      </nav>
    {%- endif -%}

    {%- if type_filter -%}
      <div class="pet-categories-scroll-wrap">
        <nav class="pet-categories-pills" aria-label="{{ 'pet_cro.catalog_bar.aria_category' | t }}">
          {%- liquid
            assign no_type_active = true
            if type_filter.active_values.size > 0
              assign no_type_active = false
            endif
            if type_filter.url_to_remove contains '?'
              assign type_base_url = type_filter.url_to_remove | append: '&'
            else
              assign type_base_url = type_filter.url_to_remove | append: '?'
            endif
          -%}
          <a
            href="{{ type_filter.url_to_remove }}"
            class="pet-category-pill{% if no_type_active %} is-active{% endif %}"
            data-pet-filter-link
            {% if no_type_active %}
              aria-current="true"
            {% endif %}
          >
            <span class="pet-category-icon" aria-hidden="true">🐾</span>
            <span>{{ 'pet_cro.catalog_bar.view_all' | t }}</span>
          </a>

          {%- for value in type_filter.values -%}
            {%- if value.count == 0 and value.active == false -%}
              {%- continue -%}
            {%- endif -%}
            {%- liquid
              case value.value
                when type_kibble
                  assign pill_icon = '🥩'
                  assign pill_label = 'pet_cro.catalog_bar.kibble' | t
                when type_wet
                  assign pill_icon = '🥫'
                  assign pill_label = 'pet_cro.catalog_bar.wet_food' | t
                when type_barf
                  assign pill_icon = '🍖'
                  assign pill_label = 'pet_cro.catalog_bar.barf' | t
                when type_snacks
                  assign pill_icon = '🦴'
                  assign pill_label = 'pet_cro.catalog_bar.snacks' | t
                when type_toys
                  assign pill_icon = '🎾'
                  assign pill_label = 'pet_cro.catalog_bar.toys' | t
                when type_grooming
                  assign pill_icon = '🧴'
                  assign pill_label = 'pet_cro.catalog_bar.grooming' | t
                when type_supplements
                  assign pill_icon = '💊'
                  assign pill_label = 'pet_cro.catalog_bar.supplements' | t
                when type_accessories
                  assign pill_icon = '🦮'
                  assign pill_label = 'pet_cro.catalog_bar.walk' | t
                else
                  assign pill_icon = '🐾'
                  assign pill_label = value.label
              endcase

              if value.active
                assign pill_url = value.url_to_remove
              else
                assign enc_value = value.value | url_encode
                assign pill_url = type_base_url | append: value.param_name | append: '=' | append: enc_value
              endif
            -%}
            <a
              href="{{ pill_url }}"
              class="pet-category-pill{% if value.active %} is-active{% endif %}"
              data-pet-filter-link
              {% if value.active %}
                aria-current="true"
              {% endif %}
            >
              <span class="pet-category-icon" aria-hidden="true">{{ pill_icon }}</span>
              <span>{{ pill_label }}</span>
              <span class="pet-category-count">{{ value.count }}</span>
            </a>
          {%- endfor -%}
        </nav>
      </div>
    {%- endif -%}

    {%- comment -%}
      Need chips (tags). Shopify hides the tag filter on translated pages (/es/), but filter.p.tag
      still filters there, so the bar offers the need tags that this collection's products have.
      pet-catalog-bar.js marks the active one and points each link at the current URL + tag.
    {%- endcomment -%}
    {%- liquid
      # Default need tags: every tag of pet-taxonomy except the pet ones.
      assign default_needs = ''
      assign taxonomy_pairs = pet_taxonomy | split: ';'
      for pair in taxonomy_pairs
        if pair contains 'tag_' and pair contains '=' and pair != blank
          assign kv = pair | split: '='
          if kv[0] != 'tag_dog' and kv[0] != 'tag_cat'
            assign default_needs = default_needs | append: kv[1] | append: ','
          endif
        endif
      endfor
      assign need_tags = settings.need_filter_tags | default: default_needs | replace: ', ', ',' | split: ','
      assign tag_puppy = pet_taxonomy | split: ';tag_puppy=' | last | split: ';' | first
      assign tag_kitten = pet_taxonomy | split: ';tag_kitten=' | last | split: ';' | first
      assign tag_adult = pet_taxonomy | split: ';tag_adult=' | last | split: ';' | first
      assign tag_senior = pet_taxonomy | split: ';tag_senior=' | last | split: ';' | first
      assign tag_sensitive = pet_taxonomy | split: ';tag_sensitive=' | last | split: ';' | first
      assign tag_hypoallergenic = pet_taxonomy | split: ';tag_hypoallergenic=' | last | split: ';' | first
      assign tag_grain_free = pet_taxonomy | split: ';tag_grain_free=' | last | split: ';' | first
      assign tag_weight_control = pet_taxonomy | split: ';tag_weight_control=' | last | split: ';' | first
      assign tag_sterilised = pet_taxonomy | split: ';tag_sterilised=' | last | split: ';' | first
      assign tag_hairball = pet_taxonomy | split: ';tag_hairball=' | last | split: ';' | first
      assign collection_needs = ''
      for tag in need_tags
        if collection.all_tags contains tag
          assign collection_needs = collection_needs | append: tag | append: ','
        endif
      endfor
      assign collection_needs = collection_needs | split: ','
    -%}
    {%- if collection_needs.size > 0 -%}
      <details class="pet-needs" data-pet-needs-toggle>
        <summary class="pet-needs__summary">
          <span>{{ 'pet_cro.catalog_bar.needs_toggle' | t }}</span>
          <span class="pet-needs__active" data-pet-needs-active></span>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </summary>
      <nav class="pet-needs-pills" aria-label="{{ 'pet_cro.nav.subfilters_title' | t }}" data-pet-needs>
        {%- for tag in collection_needs -%}
          {%- liquid
            case tag
              when tag_puppy
                assign need_label = 'pet_cro.nav.puppy' | t
              when tag_kitten
                assign need_label = 'pet_cro.nav.kitten' | t
              when tag_adult
                assign need_label = 'pet_cro.nav.adult' | t
              when tag_senior
                assign need_label = 'pet_cro.nav.senior' | t
              when tag_sensitive
                assign need_label = 'pet_cro.nav.sensitive' | t
              when tag_hypoallergenic
                assign need_label = 'pet_cro.nav.hypoallergenic' | t
              when tag_grain_free
                assign need_label = 'pet_cro.nav.grain_free' | t
              when tag_weight_control
                assign need_label = 'pet_cro.nav.weight_control' | t
              when tag_sterilised
                assign need_label = 'pet_cro.nav.sterilised' | t
              when tag_hairball
                assign need_label = 'pet_cro.nav.hairball' | t
              else
                assign need_label = tag | capitalize
            endcase
            assign enc_tag = tag | url_encode
          -%}
          <a
            href="{{ collection.url }}?filter.p.tag={{ enc_tag }}"
            class="pet-category-pill pet-need-pill"
            data-pet-filter-link
            data-pet-need="{{ tag | escape }}"
          >
            {{- need_label -}}
          </a>
        {%- endfor -%}
      </nav>
      </details>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Barra de Filtros Mascotas",
  "tag": "section",
  "class": "section-pet-catalog-bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_mascot_switcher",
      "label": "Mostrar selector de mascota (Perros / Gatos)",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Barra de Filtros Mascotas"
    }
  ]
}
{% endschema %}


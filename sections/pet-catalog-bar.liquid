{% comment %}
  Pet Catalog Navigation & Quick Filters Bar (sections/pet-catalog-bar.liquid)
  Purpose: 2-level instant visual filtering (By Pet: Dogs/Cats, By Category: Kibble/Wet/Snacks/Toys/Grooming)
  Architecture: Vanilla JS, WAI-ARIA states, URL sync, instant live filter on #product-grid
{% endcomment %}

{{ 'section-pet-catalog-bar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pet-catalog-bar.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .pet-catalog-bar-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div
  class="pet-catalog-bar-section pet-catalog-bar-{{ section.id }} color-{{ section.settings.color_scheme }} gradient"
  data-pet-catalog-bar
  id="pet-catalog-bar-{{ section.id }}"
>
  <div class="pet-catalog-bar-container page-width">
    <script type="application/json" data-pet-catalog-i18n>
      {
        "empty_title": {{ 'pet_cro.catalog_bar.empty_title' | t | json }},
        "empty_text": {{ 'pet_cro.catalog_bar.empty_text' | t | json }},
        "empty_button": {{ 'pet_cro.catalog_bar.empty_button' | t | json }},
        "status_dogs": {{ 'pet_cro.catalog_bar.status_dogs' | t | json }},
        "status_cats": {{ 'pet_cro.catalog_bar.status_cats' | t | json }},
        "status_all": {{ 'pet_cro.catalog_bar.status_all' | t | json }},
        "status_one_html": {{ 'pet_cro.catalog_bar.status_one_html' | t | json }},
        "status_other_html": {{ 'pet_cro.catalog_bar.status_other_html' | t | json }}
      }
    </script>


    {%- if section.settings.show_mascot_switcher -%}
      <!-- Level 1: Mascot Switcher -->
      <div class="pet-mascot-switcher" role="tablist" aria-label="{{ 'pet_cro.catalog_bar.aria_species' | t }}">
        <span class="pet-mascot-label">{{ 'pet_cro.catalog_bar.your_pet' | t }}</span>

        <button
          type="button"
          class="pet-mascot-btn is-active"
          data-pet-mascot="all"
          role="tab"
          aria-selected="true"
        >
          <span class="pet-mascot-icon">✨</span>
          <span>{{ 'pet_cro.catalog_bar.all_pets' | t }}</span>
        </button>

        <button
          type="button"
          class="pet-mascot-btn"
          data-pet-mascot="perro"
          role="tab"
          aria-selected="false"
        >
          <span class="pet-mascot-icon">🐶</span>
          <span>{{ 'pet_cro.catalog_bar.dogs' | t }}</span>
        </button>

        <button
          type="button"
          class="pet-mascot-btn"
          data-pet-mascot="gato"
          role="tab"
          aria-selected="false"
        >
          <span class="pet-mascot-icon">🐱</span>
          <span>{{ 'pet_cro.catalog_bar.cats' | t }}</span>
        </button>
      </div>
    {%- endif -%}

    <!-- Level 2: Category Chips / Subcollection Pills -->
    <div class="pet-categories-scroll-wrap">
      <div class="pet-categories-pills" role="tablist" aria-label="{{ 'pet_cro.catalog_bar.aria_category' | t }}">
        <button
          type="button"
          class="pet-category-pill is-active"
          data-pet-category="all"
          role="tab"
          aria-selected="true"
        >
          <span class="pet-category-icon">🐾</span>
          <span>{{ 'pet_cro.catalog_bar.view_all' | t }}</span>
        </button>

        <button
          type="button"
          class="pet-category-pill"
          data-pet-category="pienso"
          role="tab"
          aria-selected="false"
        >
          <span class="pet-category-icon">🥩</span>
          <span>{{ 'pet_cro.catalog_bar.kibble' | t }}</span>
        </button>

        <button
          type="button"
          class="pet-category-pill"
          data-pet-category="humeda"
          role="tab"
          aria-selected="false"
        >
          <span class="pet-category-icon">🥫</span>
          <span>{{ 'pet_cro.catalog_bar.wet_food' | t }}</span>
        </button>

        <button
          type="button"
          class="pet-category-pill"
          data-pet-category="snacks"
          role="tab"
          aria-selected="false"
        >
          <span class="pet-category-icon">🦴</span>
          <span>{{ 'pet_cro.catalog_bar.snacks' | t }}</span>
        </button>

        <button
          type="button"
          class="pet-category-pill"
          data-pet-category="juguetes"
          role="tab"
          aria-selected="false"
        >
          <span class="pet-category-icon">🎾</span>
          <span>{{ 'pet_cro.catalog_bar.toys' | t }}</span>
        </button>

        <button
          type="button"
          class="pet-category-pill"
          data-pet-category="higiene"
          role="tab"
          aria-selected="false"
        >
          <span class="pet-category-icon">🧴</span>
          <span>{{ 'pet_cro.catalog_bar.grooming' | t }}</span>
        </button>

        <button
          type="button"
          class="pet-category-pill"
          data-pet-category="suplementos"
          role="tab"
          aria-selected="false"
        >
          <span class="pet-category-icon">💊</span>
          <span>{{ 'pet_cro.catalog_bar.supplements' | t }}</span>
        </button>

        <button
          type="button"
          class="pet-category-pill"
          data-pet-category="accesorios"
          role="tab"
          aria-selected="false"
        >
          <span class="pet-category-icon">🦮</span>
          <span>{{ 'pet_cro.catalog_bar.walk' | t }}</span>
        </button>
      </div>
    </div>

    <!-- Active Filter Status & Reset Action -->
    <div class="pet-catalog-status-bar" data-pet-status-bar hidden>
      <div class="pet-catalog-status-text" data-pet-status-text></div>
      <button type="button" class="pet-catalog-reset-btn" data-pet-reset>
        <span>✕</span>
        <span>{{ 'pet_cro.catalog_bar.clear_filters' | t }}</span>
      </button>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Barra de Filtros Mascotas",
  "tag": "section",
  "class": "section-pet-catalog-bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_mascot_switcher",
      "label": "Mostrar selector de mascota (Perros / Gatos)",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Barra de Filtros Mascotas"
    }
  ]
}
{% endschema %}


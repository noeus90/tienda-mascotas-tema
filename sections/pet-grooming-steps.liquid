{% comment %}
  Home: "Their 4-step coat & hygiene routine" (sections/pet-grooming-steps.liquid)
  Each step block links a real product: card with image, what it is for, how often, price and
  "Add" (adds it to the cart). Under the steps, "Add the whole routine" adds every available step
  product at once and opens the cart, plus a link to book the salon. Steps without a product are
  hidden on the storefront (they only show a hint in the theme editor).
  On mobile the steps are a horizontal swipe row.
  Spanish texts are the defaults; when a text equals its default, the English version comes from
  the locale files (pet_cro.grooming_steps.*).
{% endcomment %}

{{ 'section-pet-grooming-steps.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .grooming-steps-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .grooming-steps-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign gs_en = false
  if request.locale.iso_code == 'en'
    assign gs_en = true
  endif

  # CODE-13: an empty kicker, heading or subheading shows the translated default.
  assign kicker = section.settings.kicker
  if kicker == blank
    assign kicker = 'pet_cro.grooming_steps.kicker' | t
  endif
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'pet_cro.grooming_steps.heading' | t
  endif
  assign subheading = section.settings.subheading
  if subheading == blank
    assign subheading = 'pet_cro.grooming_steps.subheading' | t
  endif

  # Steps with a product (the others are hidden on the storefront).
  assign total = 0
  assign available_count = 0
  for block in section.blocks
    if block.settings.product != blank
      assign total = total | plus: block.settings.product.selected_or_first_available_variant.price
      if block.settings.product.available
        assign available_count = available_count | plus: 1
      endif
    endif
  endfor

  capture booking_url
    render 'booking-url', custom: section.settings.booking_link
  endcapture
-%}

<section class="grooming-steps grooming-steps-section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="grooming-steps__header pet-section-header--{{ section.settings.heading_alignment }}">
      {%- if kicker != blank -%}
        <p class="pet-kicker">{{ kicker }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="grooming-steps__heading {{ section.settings.heading_size }}">{{ heading }}</h2>
      {%- endif -%}
      {%- if subheading != blank -%}
        <p class="grooming-steps__subheading">{{ subheading }}</p>
      {%- endif -%}
    </div>

    <ol class="grooming-steps__list" role="list">
      {%- assign step_number = 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          if product == blank and request.design_mode == false
            continue
          endif
          assign step_number = step_number | plus: 1
          assign title = block.settings.category
          assign text = block.settings.short_description
          assign when = block.settings.application_time
          # English for the default Spanish texts of steps 1-4 (literal keys, as Theme Check requires).
          if gs_en
            assign es_title = ''
            case step_number
              when 1
                assign es_title = 'pet_cro.grooming_steps.default_es.title_1' | t
                assign es_text = 'pet_cro.grooming_steps.default_es.text_1' | t
                assign es_when = 'pet_cro.grooming_steps.default_es.when_1' | t
                assign en_title = 'pet_cro.grooming_steps.step_1_title' | t
                assign en_text = 'pet_cro.grooming_steps.step_1_text' | t
                assign en_when = 'pet_cro.grooming_steps.step_1_when' | t
              when 2
                assign es_title = 'pet_cro.grooming_steps.default_es.title_2' | t
                assign es_text = 'pet_cro.grooming_steps.default_es.text_2' | t
                assign es_when = 'pet_cro.grooming_steps.default_es.when_2' | t
                assign en_title = 'pet_cro.grooming_steps.step_2_title' | t
                assign en_text = 'pet_cro.grooming_steps.step_2_text' | t
                assign en_when = 'pet_cro.grooming_steps.step_2_when' | t
              when 3
                assign es_title = 'pet_cro.grooming_steps.default_es.title_3' | t
                assign es_text = 'pet_cro.grooming_steps.default_es.text_3' | t
                assign es_when = 'pet_cro.grooming_steps.default_es.when_3' | t
                assign en_title = 'pet_cro.grooming_steps.step_3_title' | t
                assign en_text = 'pet_cro.grooming_steps.step_3_text' | t
                assign en_when = 'pet_cro.grooming_steps.step_3_when' | t
              when 4
                assign es_title = 'pet_cro.grooming_steps.default_es.title_4' | t
                assign es_text = 'pet_cro.grooming_steps.default_es.text_4' | t
                assign es_when = 'pet_cro.grooming_steps.default_es.when_4' | t
                assign en_title = 'pet_cro.grooming_steps.step_4_title' | t
                assign en_text = 'pet_cro.grooming_steps.step_4_text' | t
                assign en_when = 'pet_cro.grooming_steps.step_4_when' | t
            endcase
            if es_title != blank
              if title == es_title
                assign title = en_title
              endif
              if text == es_text
                assign text = en_text
              endif
              if when == es_when
                assign when = en_when
              endif
            endif
          endif
          assign variant = product.selected_or_first_available_variant
          assign image = block.settings.step_image | default: product.featured_image
        -%}
        <li class="grooming-steps__step" {{ block.shopify_attributes }}>
          <div class="grooming-steps__top">
            <span class="grooming-steps__number" aria-hidden="true">{{ step_number }}</span>
            <div>
              <p class="grooming-steps__title">
                <span class="visually-hidden">{{ 'pet_cro.grooming_steps.step_num' | t: number: step_number }}:</span>
                {{ title }}
              </p>
              {%- if when != blank -%}
                <p class="grooming-steps__when">{{ when }}</p>
              {%- endif -%}
            </div>
          </div>

          {%- if product != blank -%}
            <a href="{{ product.url }}" class="grooming-steps__media" tabindex="-1" aria-hidden="true">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    widths: '240, 360, 480, 600',
                    sizes: '(min-width: 990px) 260px, (min-width: 750px) 40vw, 70vw',
                    alt: ''
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'grooming-steps__placeholder' }}
              {%- endif -%}
            </a>
            {%- if text != blank -%}
              <p class="grooming-steps__text">{{ text }}</p>
            {%- endif -%}
            <div class="grooming-steps__product">
              <a href="{{ product.url }}" class="grooming-steps__product-name">{{ product.title }}</a>
              <div class="grooming-steps__buy">
                <span class="grooming-steps__price">{{ variant.price | money }}</span>
                {%- if product.available -%}
                  <button
                    type="button"
                    class="button button--secondary grooming-steps__add"
                    data-grooming-add="{{ variant.id }}"
                    aria-label="{{ 'pet_cro.grooming_steps.add_label' | t: product: product.title | escape }}"
                  >
                    {{ 'pet_cro.grooming_steps.add' | t }}
                  </button>
                {%- else -%}
                  <span class="grooming-steps__sold-out">{{ 'products.product.sold_out' | t }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- else -%}
            <p class="grooming-steps__text grooming-steps__text--hint">{{ 'pet_cro.grooming_steps.pick_product' | t }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    <div class="grooming-steps__footer">
      {%- if section.settings.show_add_all and available_count > 1 -%}
        <div class="grooming-steps__all">
          <p class="grooming-steps__all-text">
            {%- assign total_money = total | money -%}
            {{ 'pet_cro.grooming_steps.all_text' | t: count: available_count, total: total_money }}
          </p>
          <button type="button" class="button button--primary grooming-steps__all-btn" data-grooming-add-all>
            {{ 'pet_cro.grooming_steps.add_all' | t }}
          </button>
        </div>
      {%- endif -%}
      {%- if section.settings.show_booking -%}
        <p class="grooming-steps__salon">
          ✂️ {{ 'pet_cro.grooming_steps.salon_text' | t }}
          <a href="{{ booking_url }}">{{ 'pet_cro.grooming_steps.salon_link' | t }}</a>
        </p>
      {%- endif -%}
      <p class="grooming-steps__status" role="status" aria-live="polite" data-grooming-status></p>
    </div>
  </div>

  <script>
    (() => {
      const root = document.currentScript.closest('.grooming-steps');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = '1';
      const status = root.querySelector('[data-grooming-status]');
      const strings = {
        added: {{ 'pet_cro.grooming_steps.added' | t | json }},
        error: {{ 'pet_cro.grooming_steps.error' | t | json }},
      };

      // Adds the variants (assets/pet-cart.js): opens the cart drawer, or goes to the cart page
      // when the theme has no drawer or notification.
      const add = async (ids, button) => {
        status.textContent = '';
        const result = await window.petCart.add(ids.map((id) => ({ id })), { button, source: 'grooming-steps' });
        if (!result.ok) {
          status.textContent = result.message || strings.error;
        } else if (result.hasCartUi) {
          status.textContent = strings.added;
        } else {
          window.location = window.routes.cart_url;
        }
      };

      root.querySelectorAll('[data-grooming-add]').forEach((button) => {
        button.addEventListener('click', () => add([button.dataset.groomingAdd], button));
      });
      const all = root.querySelector('[data-grooming-add-all]');
      if (all) {
        all.addEventListener('click', () => {
          const ids = [...root.querySelectorAll('[data-grooming-add]')].map((b) => b.dataset.groomingAdd);
          if (ids.length) add(ids, all);
        });
      }
    })();
  </script>

  {%- if section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "HowTo",
        "name": {{ heading | json }},
        {%- if subheading != blank -%}
          "description": {{ subheading | json }},
        {%- endif -%}
        "step": [
          {%- assign position = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.product == blank -%}{%- continue -%}{%- endif -%}
            {%- assign position = position | plus: 1 -%}
            {%- unless position == 1 -%},{%- endunless -%}
            {
              "@type": "HowToStep",
              "position": {{ position }},
              "name": {{ block.settings.category | default: block.settings.product.title | json }},
              "text": {{ block.settings.short_description | default: block.settings.product.title | json }},
              "url": {{ request.origin | append: block.settings.product.url | json }}
            }
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.pet_grooming_steps.name",
  "tag": "section",
  "class": "section-pet-grooming-steps",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.pet_grooming_steps.settings.kicker.label",
      "info": "Vacío: el texto por defecto, traducido a cada idioma."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.pet_grooming_steps.settings.heading.label",
      "info": "Vacío: el texto por defecto, traducido a cada idioma."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.pet_grooming_steps.settings.subheading.label",
      "info": "Vacío: el texto por defecto, traducido a cada idioma."
    },
    {"type": "select", "id": "heading_size", "options": [{"value": "h2", "label": "t:sections.all.heading_size.options__1.label"}, {"value": "h1", "label": "t:sections.all.heading_size.options__2.label"}, {"value": "h0", "label": "t:sections.all.heading_size.options__3.label"}], "default": "h2", "label": "t:sections.all.heading_size.label"},
    {"type": "select", "id": "heading_alignment", "label": "Alineación del título", "options": [{"value": "left", "label": "Izquierda"}, {"value": "center", "label": "Centrado"}], "default": "left", "info": "Como el resto de secciones de la tienda, a la izquierda por defecto."},
    {
      "type": "header",
      "content": "t:sections.pet_grooming_steps.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "show_add_all",
      "label": "t:sections.pet_grooming_steps.settings.show_add_all.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_booking",
      "label": "t:sections.pet_grooming_steps.settings.show_booking.label",
      "default": true
    },
    {
      "type": "url",
      "id": "booking_link",
      "label": "t:sections.pet_grooming_steps.settings.booking_link.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.pet_grooming_steps.settings.header__2.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.pet_grooming_steps.settings.padding_top.label",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.pet_grooming_steps.settings.padding_bottom.label",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.pet_grooming_steps.blocks.step.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.pet_grooming_steps.blocks.step.settings.product.label"
        },
        {
          "type": "text",
          "id": "category",
          "label": "t:sections.pet_grooming_steps.blocks.step.settings.category.label",
          "default": "Cepillado"
        },
        {
          "type": "text",
          "id": "application_time",
          "label": "t:sections.pet_grooming_steps.blocks.step.settings.application_time.label",
          "default": "2-3 veces por semana"
        },
        {
          "type": "textarea",
          "id": "short_description",
          "label": "t:sections.pet_grooming_steps.blocks.step.settings.short_description.label"
        },
        {
          "type": "image_picker",
          "id": "step_image",
          "label": "t:sections.pet_grooming_steps.blocks.step.settings.step_image.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.pet_grooming_steps.name",
      "blocks": [
        { "type": "step", "settings": { "category": "Cepillado", "application_time": "2-3 veces por semana" } },
        { "type": "step", "settings": { "category": "Baño", "application_time": "Cada 3-4 semanas" } },
        { "type": "step", "settings": { "category": "Dientes", "application_time": "A diario" } },
        { "type": "step", "settings": { "category": "Almohadillas", "application_time": "1-2 veces por semana" } }
      ]
    }
  ]
}
{% endschema %}

{% comment %}
  Home: the grooming salon (UX-11). Heading, what booking online is like, and the active services of
  the booking form (metaobjects grooming_service) with their "from" price (the lowest of the three
  sizes), so prices are always the real ones. Buttons: book and give grooming as a gift.
  Spanish defaults translated through the locale files (pet_cro.grooming_cta.*).
{% endcomment %}

{{ 'section-pet-grooming-cta.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .grooming-cta-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .grooming-cta-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  capture booking_url
    render 'booking-url'
  endcapture
  assign gift_card = settings.gift_card_product
  assign services = shop.metaobjects['grooming_service'].values
-%}

<div class="grooming-cta grooming-cta-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="grooming-cta__box">
      <div class="grooming-cta__text">
        <p class="grooming-cta__kicker">✂️ {{ 'pet_cro.grooming_cta.kicker' | t }}</p>
        <h2 class="grooming-cta__heading h2">{{ 'pet_cro.grooming_cta.heading' | t }}</h2>
        <ul class="grooming-cta__points" role="list">
          <li>{{ 'pet_cro.grooming_cta.point_1' | t }}</li>
          <li>{{ 'pet_cro.grooming_cta.point_2' | t }}</li>
          <li>{{ 'pet_cro.grooming_cta.point_3' | t }}</li>
        </ul>
        <div class="grooming-cta__buttons">
          <a class="button button--primary" href="{{ booking_url }}">{{ 'pet_cro.grooming_cta.book' | t }}</a>
          {%- if gift_card != blank -%}
            <a class="button button--secondary" href="{{ gift_card.url }}">{{ 'pet_cro.grooming_cta.gift' | t }}</a>
          {%- endif -%}
        </div>
      </div>

      {%- if services.size > 0 -%}
        <div class="grooming-cta__services">
          <p class="grooming-cta__services-title">{{ 'pet_cro.grooming_cta.services' | t }}</p>
          <ul class="grooming-cta__list" role="list">
            {%- for service in services -%}
              {%- if service.active.value == false -%}{%- continue -%}{%- endif -%}
              {%- liquid
                # Lowest price among the three dog sizes (the "from" price of the booking form).
                assign from = 0
                assign prices = ''
                assign prices = prices | append: service.price_mini.value | append: ',' | append: service.price_medium.value | append: ',' | append: service.price_large.value
                assign prices = prices | split: ','
                for p in prices
                  assign value = p | plus: 0
                  if value > 0
                    if from == 0 or value < from
                      assign from = value
                    endif
                  endif
                endfor
                assign from_money = from | times: 100 | money_without_trailing_zeros
              -%}
              <li class="grooming-cta__service">
                <span>{{ service.name.value }}</span>
                {%- if from > 0 -%}
                  <span class="grooming-cta__price">{{ 'pet_cro.grooming_cta.from' | t: price: from_money }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          <p class="grooming-cta__note">{{ 'pet_cro.grooming_cta.note' | t }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.pet_grooming_cta.name",
  "tag": "section",
  "class": "section-pet-grooming-cta",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.pet_grooming_cta.settings.paragraph.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.pet_grooming_cta.settings.padding_top.label",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.pet_grooming_cta.settings.padding_bottom.label",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:sections.pet_grooming_cta.name"
    }
  ]
}
{% endschema %}

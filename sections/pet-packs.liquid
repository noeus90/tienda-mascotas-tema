{% comment %}
  Themed packs (sections/pet-packs.liquid).
  Shows the products of the "Packs" collection (fixed bundles made with the Shopify Bundles app,
  10 % cheaper than their products bought separately). Each card shows the "you save" line from
  snippets/price.liquid. Texts come from the theme locales (pet_cro.packs), so they follow the language.
  Nothing is rendered when the collection has no products, except in the theme editor.
  With a single pack it is shown as a banner (image, what it includes, price with the saving and
  buttons) instead of a lonely card in an empty grid; with two or more, the usual grid (UX-13).
{% endcomment %}

{%- liquid
  assign packs_collection = section.settings.collection
  if packs_collection == blank
    assign packs_collection = collections['packs']
  endif
  assign has_packs = false
  if packs_collection != blank and packs_collection.products_count > 0
    assign has_packs = true
  endif
-%}

{%- if has_packs or request.design_mode -%}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="title-wrapper-with-link">
        <div>
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ 'pet_cro.packs.heading' | t }}</h2>
          <p class="rte">{{ 'pet_cro.packs.subheading' | t }}</p>
        </div>
        {%- if has_packs -%}
          <a href="{{ packs_collection.url }}" class="link underlined-link large-up-hide">
            {{- 'pet_cro.packs.view_all' | t -}}
          </a>
        {%- endif -%}
      </div>

      {%- if has_packs and packs_collection.products_count == 1 -%}
        {%- assign pack = packs_collection.products.first -%}
        {%- liquid
          # What the pack includes: the first paragraph and the list of its description.
          assign pack_summary = pack.description | split: '</ul>' | first
          if pack.description contains '</ul>'
            assign pack_summary = pack_summary | append: '</ul>'
          else
            assign pack_summary = pack.description | strip_html | truncatewords: 40
          endif
          assign pack_variant = pack.selected_or_first_available_variant
        -%}
        <div class="pack-banner">
          <a class="pack-banner__media" href="{{ pack.url }}" tabindex="-1" aria-hidden="true">
            {%- if pack.featured_image -%}
              {{ pack.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 440px, 100vw', alt: '' }}
            {%- endif -%}
          </a>
          <div class="pack-banner__content">
            <p class="pet-kicker pet-kicker--on-tint">📦 {{ 'pet_cro.packs.kicker' | t }}</p>
            <h3 class="pack-banner__title h2"><a href="{{ pack.url }}">{{ pack.title }}</a></h3>
            <div class="pack-banner__summary rte">{{ pack_summary }}</div>
            {% render 'price', product: pack, use_variant: true, show_badges: true %}
            <div class="pack-banner__buttons">
              {%- if pack_variant.available -%}
                {%- form 'product', pack, class: 'pack-banner__form' -%}
                  <input type="hidden" name="id" value="{{ pack_variant.id }}">
                  <button type="submit" class="button button--primary">{{ 'products.product.add_to_cart' | t }}</button>
                {%- endform -%}
              {%- endif -%}
              <a class="button button--secondary" href="{{ pack.url }}">{{ 'pet_cro.packs.view_pack' | t }}</a>
            </div>
          </div>
        </div>
      {%- elsif has_packs -%}
        <ul
          class="grid product-grid contains-card--product grid--{{ section.settings.columns_desktop }}-col-desktop grid--2-col-tablet-down"
          role="list"
        >
          {%- for product in packs_collection.products limit: section.settings.products_to_show -%}
            <li class="grid__item">
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: 'square',
                show_secondary_image: false,
                lazy_load: true,
                section_id: section.id
              %}
            </li>
          {%- endfor -%}
        </ul>
        {%- if packs_collection.products_count > section.settings.products_to_show -%}
          <div class="center small-hide medium-hide">
            <a href="{{ packs_collection.url }}" class="button">{{ 'pet_cro.packs.view_all' | t }}</a>
          </div>
        {%- endif -%}
      {%- else -%}
        <p class="rte">{{ 'pet_cro.packs.editor_empty' | t }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Packs temáticos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Muestra los packs de la colección elegida. Si no eliges ninguna, usa la colección con el identificador \"packs\". Los textos están en el archivo de idiomas del tema (pet_cro.packs)."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección de packs"
    },
    {"type": "select", "id": "heading_size", "options": [{"value": "h2", "label": "t:sections.all.heading_size.options__1.label"}, {"value": "h1", "label": "t:sections.all.heading_size.options__2.label"}, {"value": "h0", "label": "t:sections.all.heading_size.options__3.label"}], "default": "h2", "label": "t:sections.all.heading_size.label"},
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Packs que se muestran"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Columnas en escritorio"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Packs temáticos"
    }
  ]
}
{% endschema %}

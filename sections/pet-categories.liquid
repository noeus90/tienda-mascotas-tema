{% comment %}
  Home: "Shop by category" (sections/pet-categories.liquid). A Dog / Cat switch and one tile per
  product type of that pet (Pienso, Comida húmeda, Dieta BARF…), each with the image of a product
  of that type and how many there are. Built from the Perros / Gatos collections, so empty
  categories hide themselves and new products show up on their own. Links use the same
  Search & Discovery filters as the menu (filter.p.product_type).
  Without JavaScript both pets are shown one under the other.
{% endcomment %}

{{ 'section-pet-categories.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .pet-categories-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .pet-categories-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  # CODE-13: an empty heading shows the translated default.
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'pet_cro.categories.heading' | t
  endif
  # Product type key (snippet pet-taxonomy, CODE-08) | locale key | emoji when there is no image.
  assign types = 'type_kibble|kibble|🥣,type_wet|wet|🥫,type_barf|barf|🥩,type_snacks|snacks|🦴,type_supplements|supplements|💊,type_grooming|grooming|🧴,type_toys|toys|🎾,type_accessories|accessories|🦮' | split: ','
  capture pet_taxonomy
    render 'pet-taxonomy'
  endcapture
  assign dogs_handle = pet_taxonomy | split: ';collection_dogs=' | last | split: ';' | first
  assign cats_handle = pet_taxonomy | split: ';collection_cats=' | last | split: ';' | first
  assign pets = dogs_handle | append: ',' | append: cats_handle | split: ','
-%}

<section class="pet-categories pet-categories-{{ section.id }} color-{{ section.settings.color_scheme }} gradient" data-pet-categories>
  <div class="page-width">
    <div class="pet-categories__header">
      {%- if heading != blank -%}
        <h2 class="pet-categories__heading h2">{{ heading }}</h2>
      {%- endif -%}
      <div class="pet-categories__switch" role="group" aria-label="{{ 'pet_cro.categories.switch_label' | t }}" hidden data-pet-switch>
        <button type="button" class="pet-categories__pet is-active" aria-pressed="true" data-pet="{{ dogs_handle }}">
          <span aria-hidden="true">🐶</span> {{ 'pet_cro.categories.dog' | t }}
        </button>
        <button type="button" class="pet-categories__pet" aria-pressed="false" data-pet="{{ cats_handle }}">
          <span aria-hidden="true">🐱</span> {{ 'pet_cro.categories.cat' | t }}
        </button>
      </div>
    </div>

    {%- for pet in pets -%}
      {%- assign pet_collection = collections[pet] -%}
      {%- if pet_collection == blank or pet_collection.products_count == 0 -%}{%- continue -%}{%- endif -%}
      <div class="pet-categories__panel" data-pet-panel="{{ pet }}">
        <h3 class="pet-categories__pet-title">
          {%- if pet == dogs_handle -%}🐶 {{ 'pet_cro.categories.dog' | t }}{%- else -%}🐱 {{ 'pet_cro.categories.cat' | t }}{%- endif -%}
        </h3>
        {%- capture tiles -%}
          {%- for entry in types -%}
            {%- liquid
              assign parts = entry | split: '|'
              assign type_needle = ';' | append: parts[0] | append: '='
              assign type_name = pet_taxonomy | split: type_needle | last | split: ';' | first
              assign count = 0
              assign tile_image = nil
              for item in pet_collection.products
                if item.type == type_name
                  assign count = count | plus: 1
                  if tile_image == nil and item.featured_image
                    assign tile_image = item.featured_image
                  endif
                endif
              endfor
            -%}
            {%- if count == 0 -%}{%- continue -%}{%- endif -%}
            <li>
              <a class="pet-categories__tile" href="{{ pet_collection.url }}?filter.p.product_type={{ type_name | url_encode }}">
                <span class="pet-categories__media">
                  {%- if tile_image -%}
                    {{ tile_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '(min-width: 990px) 120px, 22vw', alt: '' }}
                  {%- else -%}
                    <span class="pet-categories__emoji" aria-hidden="true">{{ parts[2] }}</span>
                  {%- endif -%}
                </span>
                <span class="pet-categories__label">
                  {%- case parts[1] -%}
                    {%- when 'kibble' -%}{{ 'pet_cro.categories.kibble' | t }}
                    {%- when 'wet' -%}{{ 'pet_cro.categories.wet' | t }}
                    {%- when 'barf' -%}{{ 'pet_cro.categories.barf' | t }}
                    {%- when 'snacks' -%}{{ 'pet_cro.categories.snacks' | t }}
                    {%- when 'supplements' -%}{{ 'pet_cro.categories.supplements' | t }}
                    {%- when 'grooming' -%}{{ 'pet_cro.categories.grooming' | t }}
                    {%- when 'toys' -%}{{ 'pet_cro.categories.toys' | t }}
                    {%- when 'accessories' -%}{{ 'pet_cro.categories.accessories' | t }}
                  {%- endcase -%}
                </span>
                <span class="pet-categories__count">{{ 'pet_cro.categories.count' | t: count: count }}</span>
              </a>
            </li>
          {%- endfor -%}
          {%- if pet == dogs_handle and collections['packs'].products_count > 0 -%}
            <li>
              <a class="pet-categories__tile" href="{{ collections['packs'].url }}">
                <span class="pet-categories__media">
                  {%- assign pack_image = collections['packs'].products.first.featured_image -%}
                  {%- if pack_image -%}
                    {{ pack_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '(min-width: 990px) 120px, 22vw', alt: '' }}
                  {%- else -%}
                    <span class="pet-categories__emoji" aria-hidden="true">📦</span>
                  {%- endif -%}
                </span>
                <span class="pet-categories__label">{{ 'pet_cro.categories.packs' | t }}</span>
                <span class="pet-categories__count">{{ 'pet_cro.categories.count' | t: count: collections['packs'].products_count }}</span>
              </a>
            </li>
          {%- endif -%}
          <li>
            <a class="pet-categories__tile pet-categories__tile--all" href="{{ pet_collection.url }}">
              <span class="pet-categories__media">
                <span class="pet-categories__emoji" aria-hidden="true">{% if pet == dogs_handle %}🐶{% else %}🐱{% endif %}</span>
              </span>
              <span class="pet-categories__label">{{ 'pet_cro.categories.all' | t }}</span>
              <span class="pet-categories__count">{{ 'pet_cro.categories.count' | t: count: pet_collection.products_count }}</span>
            </a>
          </li>
        {%- endcapture -%}
        {%- liquid
          # Two even rows on desktop: 10 tiles -> 5 columns, 8 -> 4.
          assign tile_count = tiles | split: '<li>' | size | minus: 1
          assign columns = tile_count | plus: 1 | divided_by: 2
          if columns > 6
            assign columns = 6
          endif
        -%}
        <ul class="pet-categories__grid" role="list" style="--pet-columns: {{ columns }};">
          {{ tiles }}
        </ul>
      </div>
    {%- endfor -%}
  </div>

  <script>
    (() => {
      const root = document.currentScript.closest('[data-pet-categories]');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = '1';
      const switcher = root.querySelector('[data-pet-switch]');
      const buttons = root.querySelectorAll('[data-pet]');
      const panels = root.querySelectorAll('[data-pet-panel]');
      if (panels.length < 2) return;
      // Remembers the last pet chosen on this device (cats stay cats).
      let saved = null;
      try {
        saved = localStorage.getItem('petCategory');
      } catch (error) {}
      const show = (pet) => {
        buttons.forEach((b) => {
          const active = b.dataset.pet === pet;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.petPanel !== pet;
        });
      };
      switcher.hidden = false;
      root.classList.add('has-switch');
      show(saved === {{ cats_handle | json }} ? {{ cats_handle | json }} : {{ dogs_handle | json }});
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          show(b.dataset.pet);
          try {
            localStorage.setItem('petCategory', b.dataset.pet);
          } catch (error) {}
        })
      );
    })();
  </script>
</section>

{% schema %}
{
  "name": "t:sections.pet_categories.name",
  "tag": "section",
  "class": "section-pet-categories",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.pet_categories.settings.paragraph.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.pet_categories.settings.heading.label",
      "info": "Vacío: el texto por defecto, traducido a cada idioma."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.pet_categories.settings.padding_top.label",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.pet_categories.settings.padding_bottom.label",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:sections.pet_categories.name"
    }
  ]
}
{% endschema %}

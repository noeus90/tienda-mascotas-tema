{% comment %}
  CRO Section: Featured Pet Store & Grooming Promotional Banner (sections/promo-banner.liquid)
{% endcomment %}

{{ 'section-promo-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-pet-cro.css' | asset_url | stylesheet_tag }}

<div class="promo-banner-wrapper color-{{ section.settings.color_scheme }} gradient">
  <div class="promo-banner-box">
    {%- if section.settings.show_icon -%}
      <span class="promo-banner-icon" aria-hidden="true">🐾</span>
    {%- endif -%}

    {%- liquid
      assign txt_free_shipping = 'pet_cro.free_shipping.milestone_shipping' | t
      assign txt_exclusive = 'pet_cro.badge.exclusive' | t
    -%}
    <div class="promo-banner-badges-row">
      {%- render 'custom-badge' -%}
      {%- render 'custom-badge', text: txt_free_shipping -%}
      {%- render 'custom-badge', text: txt_exclusive, bg_color: '#f59e0b', text_color: '#fff' -%}
    </div>

    {%- if section.settings.heading != blank -%}
      <h2
        class="promo-banner-title"
        {% if section.settings.heading == '-20% en tu 1ª Sesión de Peluquería Canina' %}
          data-i18n-es="-20% en tu 1ª Sesión de Peluquería Canina"
          data-i18n-en="-20% on your 1st Dog Grooming Session"
        {% endif %}
      >
        {{- section.settings.heading | escape -}}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div
        class="promo-banner-subtitle"
        {% if section.settings.subheading contains 'Incluye baño dermoprotector con ozonoterapia' %}
          data-i18n-html-es="<p>Incluye baño dermoprotector con ozonoterapia, corte según raza, limpieza de oídos y corte de uñas.</p>"
          data-i18n-html-en="<p>Includes dermoprotective ozone bath, breed-specific haircut, ear cleaning, and nail trim.</p>"
        {% endif %}
      >
        {{- section.settings.subheading -}}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a
        href="{{ section.settings.button_link }}"
        class="promo-banner-btn"
        {% if section.settings.button_label == 'Reservar Cita Ahora' %}
          data-i18n-es="Reservar Cita Ahora"
          data-i18n-en="Book Appointment Now"
        {% endif %}
      >
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.promo_banner.name",
  "tag": "section",
  "class": "section-promo-banner",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "t:sections.promo_banner.settings.show_icon.label",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.promo_banner.settings.heading.label",
      "default": "-20% en tu 1ª Sesión de Peluquería Canina"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.promo_banner.settings.subheading.label",
      "default": "<p>Incluye baño dermoprotector con ozonoterapia, corte según raza, limpieza de oídos y corte de uñas.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.promo_banner.settings.button_label.label",
      "default": "Reservar Cita Ahora"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.promo_banner.settings.button_link.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.promo_banner.name"
    }
  ]
}
{% endschema %}

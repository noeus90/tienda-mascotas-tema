{% comment %}
  Native Dog Grooming Appointment Booking Wizard (sections/grooming-booking.liquid)
  Purpose: 4-step interactive booking wizard customized for dogs, sizes, and specific care needs.
  Architecture: Clean Vanilla JS, WAI-ARIA states, zero external iframes, direct WhatsApp & Email confirmation.
  In the default page template (templates/page.json) it only shows on the "bookings" page: the admin can only
  assign templates of the published theme, so this works before and after publishing.
{% endcomment %}

{%- liquid
  assign show_booking = true
  if template.name == 'page' and template.suffix == blank and page.handle != 'bookings'
    assign show_booking = false
  endif
-%}

{%- if show_booking -%}
{{ 'section-grooming-booking.css' | asset_url | stylesheet_tag }}
{{ 'grooming-booking-step-1.css' | asset_url | stylesheet_tag }}
{{ 'grooming-booking-step-2.css' | asset_url | stylesheet_tag }}
{{ 'grooming-booking-step-3.css' | asset_url | stylesheet_tag }}
{{ 'grooming-booking-step-4.css' | asset_url | stylesheet_tag }}
{%- comment -%} Order matters: the last file uses the other three (CODE-09). {%- endcomment -%}
<script src="{{ 'grooming-booking-api.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'grooming-breeds.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'grooming-booking-share.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'grooming-booking.js' | asset_url }}" defer="defer"></script>


{%- style -%}
  .grooming-booking-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- liquid
  assign meta_services = shop.metaobjects['grooming_service'].values
  if meta_services == blank or meta_services.size == 0
    assign meta_services = shop.metaobjects.grooming_service.values
  endif

  assign meta_addons = shop.metaobjects['grooming_addon'].values
  if meta_addons == blank or meta_addons.size == 0
    assign meta_addons = shop.metaobjects['extra_peluqueria'].values
  endif
  if meta_addons == blank or meta_addons.size == 0
    assign meta_addons = shop.metaobjects.grooming_addon.values
  endif

  assign meta_schedule = null
  for item in shop.metaobjects['grooming_schedule'].values
    assign meta_schedule = item
    break
  endfor
  if meta_schedule == blank
    for item in shop.metaobjects.grooming_schedule.values
      assign meta_schedule = item
      break
    endfor
  endif

  # Schedule defaults
  assign raw_days_open = '1,2,3,4,5,6'
  assign morning_slots_str = '10:00, 11:00, 12:00, 13:00'
  assign afternoon_slots_str = '17:00, 18:00'
  assign closed_dates_str = ''
  assign slot_duration_mins = 60

  if meta_schedule != blank
    if meta_schedule.days_open.value != blank
      assign raw_days_open = meta_schedule.days_open.value
    elsif meta_schedule.days_open != blank
      assign raw_days_open = meta_schedule.days_open
    endif

    if meta_schedule.morning_slots.value != blank
      assign morning_slots_str = meta_schedule.morning_slots.value
    elsif meta_schedule.morning_slots != blank
      assign morning_slots_str = meta_schedule.morning_slots
    endif

    if meta_schedule.afternoon_slots.value != blank
      assign afternoon_slots_str = meta_schedule.afternoon_slots.value
    elsif meta_schedule.afternoon_slots != blank
      assign afternoon_slots_str = meta_schedule.afternoon_slots
    endif

    # Optional Saturday custom schedule from Metaobjects
    assign saturday_morning_slots_str = morning_slots_str
    if meta_schedule.saturday_morning_slots.value != blank
      assign saturday_morning_slots_str = meta_schedule.saturday_morning_slots.value
    elsif meta_schedule.saturday_morning_slots != blank
      assign saturday_morning_slots_str = meta_schedule.saturday_morning_slots
    endif

    assign saturday_afternoon_slots_str = ''
    if meta_schedule.saturday_afternoon_slots.value != blank
      assign saturday_afternoon_slots_str = meta_schedule.saturday_afternoon_slots.value
    elsif meta_schedule.saturday_afternoon_slots != blank
      assign saturday_afternoon_slots_str = meta_schedule.saturday_afternoon_slots
    endif

    if meta_schedule.closed_dates.value != blank
      assign closed_dates_str = meta_schedule.closed_dates.value
    elsif meta_schedule.closed_dates != blank
      assign closed_dates_str = meta_schedule.closed_dates
    endif

    if meta_schedule.slot_duration_mins.value != blank
      assign slot_duration_mins = meta_schedule.slot_duration_mins.value | plus: 0
    elsif meta_schedule.slot_duration_mins != blank
      assign slot_duration_mins = meta_schedule.slot_duration_mins | plus: 0
    endif
  endif

  # Ensure days_open is a clean JSON array of strings/numbers
  assign days_open_string = raw_days_open | join: ','
  if days_open_string == blank
    assign days_open_string = raw_days_open | append: ''
  endif
  assign days_open_arr = days_open_string | replace: ' ', '' | split: ','
  assign days_open_json = days_open_arr | json

  assign morning_slots_arr = morning_slots_str | replace: ';', ',' | split: ','
  assign afternoon_slots_arr = afternoon_slots_str | replace: ';', ',' | split: ','
  assign saturday_morning_slots_arr = saturday_morning_slots_str | replace: ';', ',' | split: ','
  if saturday_afternoon_slots_str != blank
    assign saturday_afternoon_slots_arr = saturday_afternoon_slots_str | replace: ';', ',' | split: ','
  else
    assign saturday_afternoon_slots_arr = '' | split: ','
  endif

  if closed_dates_str != blank
    assign closed_dates_arr = closed_dates_str | replace: ' ', '' | split: ','
    assign closed_dates_json = closed_dates_arr | json
  else
    assign closed_dates_json = '[]'
  endif

  # CODE-02: prices come only from the booking app's metaobjects. A service is bookable when it is
  # active and has its three prices; an extra, when it is active and has a price. Without bookable
  # services the form is not shown (no example services or invented prices).
  assign bookable_services = 0
  for service in meta_services
    if service.active.value == false or service.active == false
      continue
    endif
    if service.price_mini.value > 0 and service.price_medium.value > 0 and service.price_large.value > 0
      assign bookable_services = bookable_services | plus: 1
    endif
  endfor
  assign has_custom_services = false
  if bookable_services > 0
    assign has_custom_services = true
  endif

  assign has_custom_addons = false
  if meta_addons.size > 0
    assign has_custom_addons = true
  endif
-%}

{%- comment -%}
  CODE-01: real salon data only. WhatsApp and email: this section's settings, otherwise the theme
  settings "Datos del salón"; address: this section's setting, otherwise the store address
  (Settings → Store details). The shop's own email is never used. When a value is missing, the
  buttons that need it are not shown.
{%- endcomment -%}
{%- liquid
  assign salon_whatsapp = section.settings.whatsapp_number | default: settings.salon_whatsapp | strip
  assign salon_email = section.settings.salon_email | default: settings.salon_email | strip
  assign salon_address = section.settings.salon_address | strip
  if salon_address == blank and shop.address.address1 != blank
    assign salon_address = shop.address.address1
    if shop.address.zip != blank or shop.address.city != blank
      assign salon_address = salon_address | append: ', ' | append: shop.address.zip | append: ' ' | append: shop.address.city | strip
    endif
  endif
-%}

<section
  class="grooming-booking-section grooming-booking-{{ section.id }} color-{{ section.settings.color_scheme }} gradient"
  id="grooming-booking-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-whatsapp-number="{{ salon_whatsapp | escape }}"
  data-salon-address="{{ salon_address | escape }}"
  data-salon-email="{{ salon_email | escape }}"
  data-money-format="{{ shop.money_format | strip_html | escape }}"
>
  {%- render 'grooming-booking-texts' -%}
  <script type="application/json" data-grooming-config>
    {
      "slotDurationMins": {{ slot_duration_mins | default: 60 }},
      "daysOpen": {{ days_open_json }},
      "closedDates": {{ closed_dates_json }},
      "morningSlots": {{ morning_slots_arr | json }},
      "afternoonSlots": {{ afternoon_slots_arr | json }},
      "saturdayMorningSlots": {{ saturday_morning_slots_arr | json }},
      "saturdayAfternoonSlots": {{ saturday_afternoon_slots_arr | json }},
      "services": [
        {%- if has_custom_services -%}
          {%- for service in meta_services -%}
            {%- assign is_active = true -%}
            {%- if service.active.value == false or service.active == false -%}{%- assign is_active = false -%}{%- endif -%}
            {%- unless service.price_mini.value > 0 and service.price_medium.value > 0 and service.price_large.value > 0 -%}{%- assign is_active = false -%}{%- endunless -%}
            {%- if is_active -%}
              {%- assign s_id = service.system.handle | default: service.id | default: forloop.index -%}
              {%- assign s_name = service.name.value | default: service.name -%}
              {%- assign s_dur = service.duration.value | default: service.duration | default: 60 -%}
              {%- assign s_mini = service.price_mini.value -%}
              {%- assign s_med = service.price_medium.value -%}
              {%- assign s_lar = service.price_large.value -%}
              {
                "id": {{ s_id | json }},
                "name": {{ s_name | json }},
                "duration": {{ s_dur | json }},
                "mini": {{ s_mini | plus: 0 }},
                "medium": {{ s_med | plus: 0 }},
                "large": {{ s_lar | plus: 0 }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      ],
      "addons": [
        {%- if has_custom_addons -%}
          {%- for addon in meta_addons -%}
            {%- assign is_active = true -%}
            {%- if addon.active.value == false or addon.active == false -%}{%- assign is_active = false -%}{%- endif -%}
            {%- if addon.price == blank and addon.price_mini == blank -%}{%- assign is_active = false -%}{%- endif -%}
            {%- if is_active -%}
              {%- assign a_id = addon.system.handle | default: addon.id | default: forloop.index -%}
              {%- assign a_name = addon.name.value | default: addon.name -%}
              {%- assign a_price = addon.price.value | default: addon.price_mini.value | default: 0 -%}
              {%- assign a_mini = addon.price_mini.value | default: addon.price_mini | default: a_price -%}
              {%- assign a_med = addon.price_medium.value | default: addon.price_medium | default: a_price -%}
              {%- assign a_lar = addon.price_large.value | default: addon.price_large | default: a_price -%}
              {%- assign a_icon = addon.icon.value | default: addon.icon | default: '✨' -%}
              {%- assign a_desc = addon.description.value | default: addon.description | default: '' -%}
              {%- assign a_dur = addon.duration_mins.value | default: addon.duration_mins | default: 0 -%}
              {
                "id": {{ a_id | json }},
                "name": {{ a_name | json }},
                "price": {{ a_price | plus: 0 }},
                "price_mini": {{ a_mini | plus: 0 }},
                "price_medium": {{ a_med | plus: 0 }},
                "price_large": {{ a_lar | plus: 0 }},
                "icon": {{ a_icon | json }},
                "description": {{ a_desc | json }},
                "durationMins": {{ a_dur | plus: 0 }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      ]
    }
  </script>
  <div class="grooming-booking-container page-width">

    <!-- Header -->
    <header class="grooming-booking-header">
      <span
        class="grooming-booking-badge"
      >
        🐾 {{ 'pet_cro.booking_header.badge' | t }}
      </span>
      {%- comment -%}
        Heading and subheading are editor settings: the store translates them in Settings → Languages
        (theme content). The untouched default heading and subheading come from the locale files.
      {%- endcomment -%}
      {%- liquid
        assign booking_heading = section.settings.heading | default: 'Reserva cita en la peluquería'
        assign booking_sub = section.settings.subheading
        if booking_heading == 'Reserva cita en la peluquería' or booking_heading == 'Reserva Cita de Peluquería Canina & Spa'
          assign booking_heading = 'pet_cro.booking_header.heading' | t
        endif
        if booking_sub == 'Elige el servicio y el tamaño de tu perro, el día y la hora. Verás el precio estimado antes de confirmar.'
          assign booking_sub = 'pet_cro.booking_header.subheading' | t
        endif
        assign booking_address = shop.address.address1
        if shop.address.city != blank
          assign booking_address = booking_address | append: ', ' | append: shop.address.city
        endif
      -%}
      {%- comment -%} The only title of the bookings page (main-page hides its own there). {%- endcomment -%}
      <h1 class="grooming-booking-title">
        {{ booking_heading }}
      </h1>
      {%- if booking_sub != blank -%}
        <p class="grooming-booking-subtitle">
          {{ booking_sub }}
        </p>
      {%- endif -%}
      <ul class="grooming-booking-facts" role="list">
        {%- if shop.address.address1 != blank -%}
          <li><span aria-hidden="true">📍</span> {{ booking_address }}</li>
        {%- endif -%}
        {%- if settings.salon_hours != blank -%}
          <li><span aria-hidden="true">🕒</span> {{ settings.salon_hours | newline_to_br }}</li>
        {%- endif -%}
        <li><span aria-hidden="true">↩️</span> {{ 'pet_cro.booking_header.cancel' | t }}</li>
      </ul>
      {%- comment -%} Link to the first gift card product of the catalogue, if there is one. {%- endcomment -%}
      {%- for p in collections.all.products -%}
        {%- if p.gift_card? -%}
          {{ 'section-gift-card-promo.css' | asset_url | stylesheet_tag }}
          <a class="booking-gift-link" href="{{ p.url }}">🎁 {{ 'pet_cro.gift_card.booking_link' | t }} →</a>
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    </header>

{%- unless has_custom_services -%}
    <div class="grooming-booking-card grooming-booking-unavailable" role="status">
      <p>{{ 'pet_cro.booking_header.unavailable' | t }}</p>
      <a class="grooming-booking-btn-primary" href="{{ pages['contact'].url | default: '/pages/contact' }}">{{ 'pet_cro.booking_header.unavailable_contact' | t }}</a>
    </div>
{%- else -%}
{% render 'grooming-booking-stepper' %}

    <!-- Wizard Form Card -->
    <div class="grooming-booking-card">
      {% render 'grooming-booking-step-1',
        section: section,
        has_custom_services: has_custom_services,
        meta_services: meta_services,
        has_custom_addons: has_custom_addons,
        meta_addons: meta_addons
      %}
      {% render 'grooming-booking-step-2', section: section %}
      {% render 'grooming-booking-step-3', section: section %}
      {% render 'grooming-booking-step-4', section: section, salon_whatsapp: salon_whatsapp, salon_email: salon_email, salon_address: salon_address %}
    </div>
{%- endunless -%}
  </div>

</section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.grooming_booking.name",
  "tag": "section",
  "class": "section-grooming-booking",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.grooming_booking.settings.heading.label",
      "default": "Reserva cita en la peluquería"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.grooming_booking.settings.subheading.label",
      "default": "Asistente guiado: personaliza la sesión para tu peludo y confirma tu cita en 1 minuto."
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "t:sections.grooming_booking.settings.whatsapp_number.label",
      "info": "t:sections.grooming_booking.settings.whatsapp_number.info"
    },
    {
      "type": "text",
      "id": "salon_address",
      "label": "t:sections.grooming_booking.settings.salon_address.label",
      "info": "t:sections.grooming_booking.settings.salon_address.info"
    },
    {
      "type": "text",
      "id": "salon_email",
      "label": "Email de contacto del salón",
      "info": "Si se deja en blanco se utilizará el correo principal de la tienda."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.grooming_booking.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.grooming_booking.settings.padding_top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.grooming_booking.settings.padding_bottom.label",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:sections.grooming_booking.name"
    }
  ]
}
{% endschema %}

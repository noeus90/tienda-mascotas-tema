{% comment %}
  Home: "What we promise" (sections/pet-trust-badges.liquid). Only promises the store keeps today
  (free shipping, returns, online booking, loyalty card); no reviews or seals without proof.
  In the texts, [importe] becomes the free shipping threshold and [dias] the standard delivery days
  (theme settings), so they stay in sync. Spanish texts are the defaults; when a text equals its
  default, the English version comes from the locale files (pet_cro.promises.*).
{% endcomment %}

{{ 'section-pet-trust-badges.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .trust-badges-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .trust-badges-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign tb_en = false
  if request.locale.iso_code == 'en'
    assign tb_en = true
  endif

  assign free_amount = settings.free_shipping_threshold | default: 50 | times: 100 | money_without_trailing_zeros
  assign min_days = settings.delivery_days_min | default: 3
  assign max_days = settings.delivery_days_max | default: 5
  assign days = min_days | append: '-' | append: max_days

  assign heading = section.settings.heading
  if tb_en and heading == 'Lo que te prometemos'
    assign heading = 'pet_cro.promises.heading' | t
  endif
  assign subheading = section.settings.subheading
  if tb_en and subheading == 'Sin letra pequeña: esto es lo que puedes esperar al comprar o reservar con nosotros.'
    assign subheading = 'pet_cro.promises.subheading' | t
  endif
-%}

<section class="trust-badges-section trust-badges-section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="trust-badges-container">
    <div class="trust-badges-review-header">
      {%- if heading != blank -%}
        <h2>{{ heading }}</h2>
      {%- endif -%}
      {%- if subheading != blank -%}
        <p>{{ subheading }}</p>
      {%- endif -%}
    </div>

    <ul class="trust-badges-grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign title = block.settings.heading
          assign text = block.settings.description
          if tb_en
            case forloop.index
              when 1
                assign es_title = 'pet_cro.promises.default_es.title_1' | t
                assign es_text = 'pet_cro.promises.default_es.text_1' | t
                assign en_title = 'pet_cro.promises.title_1' | t
                assign en_text = 'pet_cro.promises.text_1' | t
              when 2
                assign es_title = 'pet_cro.promises.default_es.title_2' | t
                assign es_text = 'pet_cro.promises.default_es.text_2' | t
                assign en_title = 'pet_cro.promises.title_2' | t
                assign en_text = 'pet_cro.promises.text_2' | t
              when 3
                assign es_title = 'pet_cro.promises.default_es.title_3' | t
                assign es_text = 'pet_cro.promises.default_es.text_3' | t
                assign en_title = 'pet_cro.promises.title_3' | t
                assign en_text = 'pet_cro.promises.text_3' | t
              when 4
                assign es_title = 'pet_cro.promises.default_es.title_4' | t
                assign es_text = 'pet_cro.promises.default_es.text_4' | t
                assign en_title = 'pet_cro.promises.title_4' | t
                assign en_text = 'pet_cro.promises.text_4' | t
              else
                assign es_title = ''
                assign es_text = ''
            endcase
            if es_title != blank and title == es_title
              assign title = en_title
            endif
            if es_text != blank and text == es_text
              assign text = en_text
            endif
          endif
          assign title = title | replace: '[importe]', free_amount | replace: '[dias]', days
          assign text = text | replace: '[importe]', free_amount | replace: '[dias]', days
        -%}
        <li class="trust-badge-card" {{ block.shopify_attributes }}>
          <div class="trust-badge-icon-circle" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {%- case block.settings.icon -%}
                {%- when 'truck' -%}
                  <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                {%- when 'return' -%}
                  <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                {%- when 'calendar' -%}
                  <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/>
                {%- when 'star' -%}
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                {%- when 'lock' -%}
                  <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                {%- when 'snowflake' -%}
                  <line x1="12" y1="2" x2="12" y2="22"/><line x1="4.93" y1="6" x2="19.07" y2="18"/><line x1="4.93" y1="18" x2="19.07" y2="6"/>
                {%- else -%}
                  <circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/>
              {%- endcase -%}
            </svg>
          </div>
          <h3>{{ title }}</h3>
          {%- if text != blank -%}
            <p>{{ text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.pet_trust_badges.name",
  "tag": "section",
  "class": "section-pet-trust-badges",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.pet_trust_badges.settings.paragraph.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.pet_trust_badges.settings.heading.label",
      "default": "Lo que te prometemos"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.pet_trust_badges.settings.subheading.label",
      "default": "Sin letra pequeña: esto es lo que puedes esperar al comprar o reservar con nosotros."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.pet_trust_badges.settings.header__3.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.pet_trust_badges.settings.padding_top.label",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.pet_trust_badges.settings.padding_bottom.label",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "t:sections.pet_trust_badges.blocks.badge.name",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.pet_trust_badges.blocks.badge.settings.icon.label",
          "options": [
            { "value": "truck", "label": "t:sections.pet_trust_badges.blocks.badge.settings.icon.options__truck.label" },
            { "value": "return", "label": "t:sections.pet_trust_badges.blocks.badge.settings.icon.options__return.label" },
            { "value": "calendar", "label": "t:sections.pet_trust_badges.blocks.badge.settings.icon.options__calendar.label" },
            { "value": "star", "label": "t:sections.pet_trust_badges.blocks.badge.settings.icon.options__star.label" },
            { "value": "lock", "label": "t:sections.pet_trust_badges.blocks.badge.settings.icon.options__lock.label" },
            { "value": "snowflake", "label": "t:sections.pet_trust_badges.blocks.badge.settings.icon.options__snowflake.label" },
            { "value": "paw", "label": "t:sections.pet_trust_badges.blocks.badge.settings.icon.options__paw.label" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.pet_trust_badges.blocks.badge.settings.heading.label",
          "default": "Envío gratis desde [importe]"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:sections.pet_trust_badges.blocks.badge.settings.description.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.pet_trust_badges.name",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "heading": "Envío gratis desde [importe]" } },
        { "type": "badge", "settings": { "icon": "return", "heading": "14 días para devolverlo" } },
        { "type": "badge", "settings": { "icon": "calendar", "heading": "Cita de peluquería online" } },
        { "type": "badge", "settings": { "icon": "star", "heading": "Cada 10 visitas, un baño de regalo" } }
      ]
    }
  ]
}
{% endschema %}

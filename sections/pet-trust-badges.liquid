{% comment %}
  CRO Section: Veterinary & Pet Care Trust Badges + Verified Reviews (sections/pet-trust-badges.liquid)
  CRO Goal: Build trust with verified pet parent social proof and configurable veterinary/quality guarantees.
  Full documentation: docs/pet-store-architecture.md
{% endcomment %}

{{ 'section-pet-trust-badges.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .trust-badges-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- liquid
  assign raw_tb_heading = section.settings.heading | strip
  assign is_default_tb_heading = false
  if raw_tb_heading == 'Alimentación Natural y Peluquería Canina Respaldada por Expertos' or raw_tb_heading == 'Expert-Backed Natural Pet Food & Dog Grooming'
    assign is_default_tb_heading = true
  endif

  assign raw_tb_sub = section.settings.subheading | strip
  assign is_default_tb_sub = false
  if raw_tb_sub == 'Todo lo que tu compañero necesita para estar sano por dentro y radiante por fuera.' or raw_tb_sub == 'Everything your companion needs to stay healthy inside and radiant outside.'
    assign is_default_tb_sub = true
  endif

  assign raw_tb_review = section.settings.review_text | strip
  assign is_default_tb_review = false
  if raw_tb_review == '+2.400 familias perrunas felices' or raw_tb_review == '+2,400 happy pet families'
    assign is_default_tb_review = true
  endif

  assign raw_tb_verified = section.settings.verified_label | strip
  assign is_default_tb_verified = false
  if raw_tb_verified == 'Peluquería & Tienda Verificada' or raw_tb_verified == 'Verified Grooming Salon & Store'
    assign is_default_tb_verified = true
  endif

  assign tb_locale = request.locale.iso_code | downcase | slice: 0, 2
-%}

<section class="trust-badges-section trust-badges-section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="trust-badges-container">
    
    <!-- Header with Dynamic Verified Reviews Pill -->
    <div class="trust-badges-review-header">
      {%- if section.settings.show_review_badge -%}
        <div class="trust-badges-review-pill">
          <span class="trust-badges-stars" aria-hidden="true">★★★★★</span>
          <span
            class="trust-badges-review-text"
            {% if is_default_tb_review %}
              data-i18n-es="{{ section.settings.review_score }} · +2.400 familias perrunas felices"
              data-i18n-en="{{ section.settings.review_score }} · +2,400 happy pet families"
            {% endif %}
          >
            {%- if is_default_tb_review and tb_locale == 'en' -%}
              {{ section.settings.review_score }} · +2,400 happy pet families
            {%- else -%}
              {{ section.settings.review_score }} · {{ section.settings.review_text }}
            {%- endif -%}
          </span>
          {%- if section.settings.verified_label != blank -%}
            <span class="trust-badges-verified-tag">
              <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span
                {% if is_default_tb_verified %}
                  data-i18n-es="Peluquería & Tienda Verificada"
                  data-i18n-en="Verified Grooming Salon & Store"
                {% endif %}
              >
                {%- if is_default_tb_verified and tb_locale == 'en' -%}
                  Verified Grooming Salon & Store
                {%- else -%}
                  {{ section.settings.verified_label }}
                {%- endif -%}
              </span>
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2
          {% if is_default_tb_heading %}
            data-i18n-es="Alimentación Natural y Peluquería Canina Respaldada por Expertos"
            data-i18n-en="Expert-Backed Natural Pet Food & Dog Grooming"
          {% endif %}
        >
          {%- if is_default_tb_heading and tb_locale == 'en' -%}
            Expert-Backed Natural Pet Food & Dog Grooming
          {%- else -%}
            {{ section.settings.heading }}
          {%- endif -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p
          {% if is_default_tb_sub %}
            data-i18n-es="Todo lo que tu compañero necesita para estar sano por dentro y radiante por fuera."
            data-i18n-en="Everything your companion needs to stay healthy inside and radiant outside."
          {% endif %}
        >
          {%- if is_default_tb_sub and tb_locale == 'en' -%}
            Everything your companion needs to stay healthy inside and radiant outside.
          {%- else -%}
            {{ section.settings.subheading }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    <!-- Configurable Trust Seals Grid -->
    <div class="trust-badges-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign cert_es = block.settings.certificate_tag
          assign cert_en = cert_es
          if cert_es == 'Aval Clínico'
            assign cert_en = 'Clinical Guarantee'
          elsif cert_es == 'pH 7.0 Canino'
            assign cert_en = 'Canine pH 7.0'
          endif

          assign h_es = block.settings.heading
          assign h_en = h_es
          if h_es == 'Nutrición 100% Natural'
            assign h_en = '100% Natural Nutrition'
          elsif h_es == 'Peluquería Amable'
            assign h_en = 'Stress-Free Grooming'
          elsif h_es == 'Revisado por Veterinarios'
            assign h_en = 'Veterinary Approved'
          elsif h_es == 'Sin Sulfatos ni Siliconas'
            assign h_en = 'Sulfate & Silicone Free'
          endif

          assign desc_es = block.settings.description
          assign desc_en = desc_es
          if desc_es == 'Ingredientes frescos de alta palatabilidad sin cereales, subproductos ni conservantes artificiales.'
            assign desc_en = 'Fresh, highly palatable ingredients with zero grains, by-products, or artificial preservatives.'
          elsif desc_es == 'Sesiones de baño, corte y deslanado adaptadas al ritmo de tu perro, sin jaulas de secado.'
            assign desc_en = "Baths, haircuts, and deshedding sessions tailored to your dog's pace, never using drying cages."
          elsif desc_es == 'Fórmulas hipoalergénicas diseñadas para cuidar articulaciones, digestión y pieles sensibles.'
            assign desc_en = 'Hypoallergenic formulas designed to care for sensitive skin, digestion, and joint health.'
          elsif desc_es == 'Champús y bálsamos de peluquería profesional que respetan la barrera cutánea de tu mascota.'
            assign desc_en = "Professional grooming shampoos and balms that protect your pet's natural skin barrier."
          endif
        -%}
        <div class="trust-badge-card" {{ block.shopify_attributes }}>
          <div class="trust-badge-icon-circle" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'natural' -%}
                <!-- 100% Natural Ingredients (Leaf) -->
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                  <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                </svg>
              {%- when 'cruelty_free' -%}
                <!-- Pet Friendly / Paw Print -->
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="4" r="2"/>
                  <circle cx="18" cy="8" r="2"/>
                  <circle cx="20" cy="16" r="2"/>
                  <path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/>
                </svg>
              {%- when 'vet_approved' -%}
                <!-- Veterinary Approved (Shield + Check) -->
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              {%- when 'grain_free' -%}
                <!-- Canine Neutral pH / Grain & Sulfate Free -->
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                </svg>
              {%- else -%}
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="7"/>
                  <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
                </svg>
            {%- endcase -%}
          </div>

          {%- if block.settings.certificate_tag != blank -%}
            <span
              class="trust-badge-cert-tag"
              data-i18n-es="{{ cert_es | escape }}"
              data-i18n-en="{{ cert_en | escape }}"
            >
              {%- if tb_locale == 'en' -%}{{ cert_en }}{%- else -%}{{ cert_es }}{%- endif -%}
            </span>
          {%- endif -%}

          <h3
            data-i18n-es="{{ h_es | escape }}"
            data-i18n-en="{{ h_en | escape }}"
          >
            {%- if tb_locale == 'en' -%}{{ h_en }}{%- else -%}{{ h_es }}{%- endif -%}
          </h3>
          <p
            data-i18n-es="{{ desc_es | escape }}"
            data-i18n-en="{{ desc_en | escape }}"
          >
            {%- if tb_locale == 'en' -%}{{ desc_en }}{%- else -%}{{ desc_es }}{%- endif -%}
          </p>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "t:sections.pet_trust_badges.name",
  "tag": "section",
  "class": "section-pet-trust-badges",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.pet_trust_badges.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "show_review_badge",
      "label": "t:sections.pet_trust_badges.settings.show_review_badge.label",
      "default": true
    },
    {
      "type": "text",
      "id": "review_score",
      "label": "t:sections.pet_trust_badges.settings.review_score.label",
      "default": "4.9 / 5"
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "t:sections.pet_trust_badges.settings.review_text.label",
      "default": "+2.400 familias perrunas felices"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "t:sections.pet_trust_badges.settings.verified_label.label",
      "default": "Peluquería & Tienda Verificada"
    },
    {
      "type": "header",
      "content": "t:sections.pet_trust_badges.settings.header__2.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.pet_trust_badges.settings.heading.label",
      "default": "Nutrición Honesta y Peluquería Canina sin Estrés"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.pet_trust_badges.settings.subheading.label",
      "default": "Seleccionamos alimentación natural sin cereales y productos de dermocosmética canina avalados por veterinarios y estilistas profesionales."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.pet_trust_badges.settings.header__3.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.pet_trust_badges.settings.padding_top.label",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.pet_trust_badges.settings.padding_bottom.label",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "t:sections.pet_trust_badges.blocks.badge.name",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.pet_trust_badges.blocks.badge.settings.icon.label",
          "options": [
            {
              "value": "natural",
              "label": "t:sections.pet_trust_badges.blocks.badge.settings.icon.options__1.label"
            },
            {
              "value": "cruelty_free",
              "label": "t:sections.pet_trust_badges.blocks.badge.settings.icon.options__2.label"
            },
            {
              "value": "vet_approved",
              "label": "t:sections.pet_trust_badges.blocks.badge.settings.icon.options__3.label"
            },
            {
              "value": "grain_free",
              "label": "t:sections.pet_trust_badges.blocks.badge.settings.icon.options__4.label"
            },
            {
              "value": "premium",
              "label": "t:sections.pet_trust_badges.blocks.badge.settings.icon.options__5.label"
            }
          ],
          "default": "natural"
        },
        {
          "type": "text",
          "id": "certificate_tag",
          "label": "t:sections.pet_trust_badges.blocks.badge.settings.certificate_tag.label",
          "default": "Grado Humano"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.pet_trust_badges.blocks.badge.settings.heading.label",
          "default": "Ingredientes 100% Naturales"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:sections.pet_trust_badges.blocks.badge.settings.description.label",
          "default": "Recetas cocinadas a baja temperatura con carne y pescado fresco sin subproductos ni conservantes artificiales."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.pet_trust_badges.name",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "natural",
            "certificate_tag": "Grain-Free",
            "heading": "Nutrición 100% Natural",
            "description": "Ingredientes frescos de alta palatabilidad sin cereales, azúcares ni conservantes artificiales."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "cruelty_free",
            "certificate_tag": "Zero Stress",
            "heading": "Peluquería Amable",
            "description": "Sesiones de baño, corte y deslanado adaptadas al ritmo de tu perro, sin jaulas de secado."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "vet_approved",
            "certificate_tag": "Aval Clínico",
            "heading": "Revisado por Veterinarios",
            "description": "Fórmulas hipoalergénicas diseñadas para cuidar articulaciones, digestión y pieles atópicas."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "grain_free",
            "certificate_tag": "pH 7.0 Canino",
            "heading": "Sin Sulfatos ni Siliconas",
            "description": "Champús y bálsamos de peluquería profesional que respetan la barrera lipídica de tu mascota."
          }
        }
      ]
    }
  ]
}
{% endschema %}

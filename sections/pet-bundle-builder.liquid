{% comment %}
  CRO Section: Pet Bundle Builder ("Crea el Pack de tu Peludo") (sections/pet-bundle-builder.liquid)
  CRO Goal: Increase Average Order Value (AOV) by letting pet parents build a custom pet care/nutrition pack with progressive discounts (2 pcs = 10% OFF, 3+ pcs = 15% OFF).
  Integration: Uses Shopify Ajax Cart API (/cart/add.js) + Section Rendering API.
  Full documentation: docs/pet-store-architecture.md
{% endcomment %}

{{ 'section-pet-bundle-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-pet-bundle-builder.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .bundle-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- liquid
  assign collection_obj = section.settings.collection
  assign goal_units = section.settings.goal_units | default: 3
  assign discount_tier_1 = section.settings.discount_tier_1 | default: 10
  assign discount_tier_2 = section.settings.discount_tier_2 | default: 15
-%}

<section
  class="bundle-section-{{ section.id }} bundle-builder-root color-{{ section.settings.color_scheme }} gradient"
  id="bundle-builder-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-goal="{{ goal_units }}"
  data-tier1="{{ discount_tier_1 }}"
  data-tier2="{{ discount_tier_2 }}"
>
  <script type="application/json" data-bundle-i18n>
    {
      "msgInitial": {{ 'pet_cro.bundle.msg_initial' | t: goal: goal_units, discount: discount_tier_2 | json }},
      "msgMissing1": {{ 'pet_cro.bundle.msg_missing_1' | t: discount: discount_tier_1 | json }},
      "msgTier1": {{ 'pet_cro.bundle.msg_tier_1' | t: dto1: discount_tier_1, missing: '__MISSING__', dto2: discount_tier_2 | json }},
      "msgCompleted": {{ 'pet_cro.bundle.msg_completed' | t: discount: discount_tier_2 | json }},
      "emptyStep": {{ 'pet_cro.bundle.empty_step' | t: number: '__NUM__' | json }},
      "discountLabel": {{ 'pet_cro.bundle.discount_label' | t: percent: '__PCT__' | json }},
      "selectAtLeast": {{ 'pet_cro.bundle.select_at_least' | t | json }},
      "addPackCta": {{ 'pet_cro.bundle.add_pack_cta' | t: count: '__COUNT__', total: '__TOTAL__' | json }},
      "es": {
        "msgInitial": "Selecciona {{ goal_units }} productos para tu mascota y desbloquea un {{ discount_tier_2 }}% de descuento",
        "msgMissing1": "Añade 1 producto más para desbloquear un {{ discount_tier_1 }}% de descuento",
        "msgTier1": "🐾 Tienes un {{ discount_tier_1 }}% DTO. ¡Añade __MISSING__ más para conseguir un {{ discount_tier_2 }}% DTO!",
        "msgCompleted": "🎉 ¡Guau! Has desbloqueado el {{ discount_tier_2 }}% de descuento máximo en el pack de tu peludo",
        "emptyStep": "Producto __NUM__: Selecciona del catálogo",
        "discountLabel": "Descuento pack (__PCT__%):",
        "selectAtLeast": "Elige al menos 1 producto",
        "addPackCta": "Añadir Pack (__COUNT__) · __TOTAL__"
      },
      "en": {
        "msgInitial": "Select {{ goal_units }} products for your pet to unlock your {{ discount_tier_2 }}% discount",
        "msgMissing1": "Add 1 more product to unlock a {{ discount_tier_1 }}% discount",
        "msgTier1": "🐾 You have {{ discount_tier_1 }}% OFF. Add __MISSING__ more to get {{ discount_tier_2 }}% OFF!",
        "msgCompleted": "🎉 Woof! You unlocked the maximum {{ discount_tier_2 }}% discount on your pet's pack",
        "emptyStep": "Item __NUM__: Select from catalog",
        "discountLabel": "Pack discount (__PCT__%):",
        "selectAtLeast": "Select at least 1 product",
        "addPackCta": "Add Pack (__COUNT__) · __TOTAL__"
      }
    }
  </script>
  <div class="bundle-container">
    
    <!-- Header -->
    {%- liquid
      assign raw_bb_kicker = section.settings.kicker | strip
      assign is_default_bb_kicker = false
      if raw_bb_kicker == 'Ahorra Combinando sus Favoritos' or raw_bb_kicker == 'Save by Mixing Their Favorites'
        assign is_default_bb_kicker = true
      endif

      assign raw_bb_h = section.settings.heading | strip
      assign is_default_bb_h = false
      if raw_bb_h contains 'Crea el Pack de tu Peludo' or raw_bb_h contains "Build Your Pet's Pack"
        assign is_default_bb_h = true
      endif

      assign raw_bb_sub = section.settings.subheading | strip
      assign is_default_bb_sub = false
      if raw_bb_sub contains 'Elige 2 productos para obtener un 10% DTO' or raw_bb_sub contains 'Pick 2 items for 10% OFF'
        assign is_default_bb_sub = true
      endif

      assign bb_locale = request.locale.iso_code | downcase | slice: 0, 2
    -%}
    <div class="bundle-header">
      {%- if section.settings.kicker != blank -%}
        <span
          class="bundle-kicker"
        >
          {%- if is_default_bb_kicker and bb_locale == 'en' -%}
            Save by Mixing Their Favorites
          {%- else -%}
            {{ section.settings.kicker }}
          {%- endif -%}
        </span>
      {%- endif -%}
      <h2>
        {%- if is_default_bb_h and bb_locale == 'en' -%}
          Build Your Pet's Pack & Save up to 15%
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p>
          {%- if is_default_bb_sub and bb_locale == 'en' -%}
            Pick 2 items for 10% OFF or mix 3+ (food, treats, shampoo, or care) to unlock an instant 15% discount.
          {%- else -%}
            {{ section.settings.subheading }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

<!-- Gamified Progress Bar -->
    {% render 'pet-bundle-progress',
      section: section,
      goal_units: goal_units,
      discount_tier_1: discount_tier_1,
      discount_tier_2: discount_tier_2
    %}

    <!-- Main Layout -->
    <div class="bundle-layout">
      <!-- Eligible Pet Products Catalog -->
      {% render 'pet-bundle-catalog',
        section: section,
        collection_obj: collection_obj
      %}

      <!-- Sticky Summary Panel -->
      {% render 'pet-bundle-summary', section: section %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "t:sections.pet_bundle_builder.name",
  "tag": "section",
  "class": "section-pet-bundle-builder",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.pet_bundle_builder.settings.kicker.label",
      "default": "Ahorra Combinando sus Favoritos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.pet_bundle_builder.settings.heading.label",
      "default": "Crea el Pack a Medida de tu Peludo"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.pet_bundle_builder.settings.subheading.label",
      "default": "Elige 2 productos y consigue un 10% de descuento inmediato, o selecciona 3 o más para desbloquear un 15% DTO en alimentación, snacks e higiene."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.pet_bundle_builder.settings.collection.label"
    },
    {
      "type": "range",
      "id": "goal_units",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:sections.pet_bundle_builder.settings.goal_units.label",
      "default": 3
    },
    {
      "type": "range",
      "id": "discount_tier_1",
      "min": 5,
      "max": 25,
      "step": 5,
      "unit": "%",
      "label": "t:sections.pet_bundle_builder.settings.discount_tier_1.label",
      "default": 10
    },
    {
      "type": "range",
      "id": "discount_tier_2",
      "min": 10,
      "max": 35,
      "step": 5,
      "unit": "%",
      "label": "t:sections.pet_bundle_builder.settings.discount_tier_2.label",
      "default": 15
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.pet_bundle_builder.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.pet_bundle_builder.settings.padding_top.label",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.pet_bundle_builder.settings.padding_bottom.label",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:sections.pet_bundle_builder.name"
    }
  ]
}
{% endschema %}
